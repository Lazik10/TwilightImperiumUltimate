@page "/community/slices-archive/slice-draft/{SliceDraftId:int}"
@using TwilightImperiumUltimate.Web.Components.MapGenerator
@using TwilightImperiumUltimate.Web.Components.PreviewSlices
@using TwilightImperiumUltimate.Web.Components.Shared.Bars
@using TwilightImperiumUltimate.Web.Components.Shared.Controls
@using TwilightImperiumUltimate.Web.Components.SliceGenerators

<PageTitle>@SliceDraft.Name</PageTitle>

<Page>

    <ResponsiveContainer Type="ContainerType.Flex"
                         Padding="none"
                         JustifyContent="Enums.JustifyContent.SpaceBetween"
                         AlignItems="Enums.AlignItems.Center"
                         CssClass="slice-draft-toolbar mb-md">

        <ResponsiveButton ButtonText="@Strings.ButtonBack" OnClick="RedirectBack" />

        <QuickMenuItem IconType="IconType.DownloadMapImage"
                       IconTypeClicked="IconType.DownloadMapImageClicked"
                       AriaLabel="@Strings.MapArchive_SaveMap"
                       OnClick="async () => await HandleDownloadIconClick()" />

    </ResponsiveContainer>

    @if (!_slices.Any())
        return;

    <div id="sliceDraftArea" class="slice-draft-area">

        <ResponsiveHeading Level="1" Text="@SliceDraft.Name" CssClass="mb-md" />

        <div class="slice-draft-ratings mb-lg">

            <div class="slice-draft-rating">
                <ResponsiveLabel Text="@Strings.SlicesArchive_SliceDraftRating" CssClass="slice-draft-rating-label" />
                <StarRating Rating="@SliceDraft.Rating" IsReadOnly="true" />
            </div>

            <div class="slice-draft-rating">
                <ResponsiveLabel Text="@Strings.SlicesArchive_SliceDraftUserRating" CssClass="slice-draft-rating-label" />
                <StarRating Rating="@_userRating" OnRatingChange="UpdateUserMapRating" />
            </div>

        </div>

        <div class="slice-card-grid">
            @foreach (var slice in _slices)
            {
                <ResponsiveCard @key="slice.Id" CssClass="slice-detail-card">
                    <SlicePreview SliceModel="slice" ArchiveLayout="true" />
                </ResponsiveCard>
            }
        </div>

        <SliceEvaluationGrid Slices="_slices" />

        <ResponsiveCard CssClass="mt-xl">
            <dl class="slice-draft-meta">

                <dt><ResponsiveLabel Text="@Strings.SlicesArchive_SliceDraftAuthor" /></dt>
                <dd><ResponsiveLabel Text="@SliceDraft.UserName" /></dd>

                <dt><ResponsiveLabel Text="@Strings.SlicesArchive_SliceDraftEventName" /></dt>
                <dd><ResponsiveLabel Text="@SliceDraft.EventName" /></dd>

                <dt><ResponsiveLabel Text="@Strings.SlicesArchive_SlicesCount" /></dt>
                <dd><ResponsiveLabel Text="@SliceDraft.SliceCount.ToString()" /></dd>

                <dt><ResponsiveLabel Text="@Strings.SlicesArchive_SliceDraftDescription" /></dt>
                <dd>
                    <div class="slice-draft-description handel white shadow">
                        @MarkupStringDescription
                    </div>
                </dd>

                <dt><ResponsiveLabel Text="@Strings.SlicesArchive_SlicesString" /></dt>
                <dd>
                    <div class="slice-draft-text slice-draft-normal-text">
                        @SlicesString
                    </div>
                    <div class="slice-draft-copy-row">
                        <CopyButton TextToCopy="@SliceDraft.SliceDraftString" AriaLabel="@Strings.SlicesArchive_SlicesString" />
                    </div>
                </dd>

                <dt><ResponsiveLabel Text="@Strings.SlicesArchive_SliceGeneratorLink" /></dt>
                <dd>
                    <ResponsiveLabel Text="@SliceDraft.SliceDraftGeneratorLink" CssClass="text-break-all slice-draft-normal-text" />
                    <div class="slice-draft-copy-row">
                        <CopyButton TextToCopy="@SliceDraft.SliceDraftGeneratorLink" AriaLabel="@Strings.SlicesArchive_SliceGeneratorLink" />
                    </div>
                </dd>

                <dt><ResponsiveLabel Text="@Strings.SlicesArchive_SliceDraftArchiveLink" /></dt>
                <dd>
                    <ResponsiveLabel Text="@SliceDraft.SliceDraftArchiveLink" CssClass="text-break-all slice-draft-normal-text" />
                    <div class="slice-draft-copy-row">
                        <CopyButton TextToCopy="@SliceDraft.SliceDraftArchiveLink" AriaLabel="@Strings.SlicesArchive_SliceDraftArchiveLink" />
                    </div>
                </dd>

            </dl>
        </ResponsiveCard>


    </div>
</Page>
