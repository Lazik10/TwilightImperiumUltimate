@page "/community/maps-archive/map/{MapId:int}"

@using TwilightImperiumUltimate.Web.Components.MapGenerator
@using TwilightImperiumUltimate.Web.Components.MapsArchive
@using TwilightImperiumUltimate.Web.Components.Shared.Bars
@using TwilightImperiumUltimate.Web.Helpers.Enums

<PageTitle>@PageTitleText</PageTitle>

<Page>

    <ResponsiveContainer Type="ContainerType.Flex"
                         Padding="none"
                         JustifyContent="Enums.JustifyContent.SpaceBetween"
                         AlignItems="Enums.AlignItems.Center"
                         CssClass="map-detail-toolbar mb-md">

        <ResponsiveButton ButtonText="@Strings.ButtonBack" OnClick="RedirectBack" />

        <QuickMenuItem IconType="IconType.DownloadMapImage"
                       IconTypeClicked="IconType.DownloadMapImageClicked"
                       AriaLabel="@Strings.MapArchive_SaveMap"
                       OnClick="async () => await HandleDownloadIconClick()" />

    </ResponsiveContainer>

    @if (!IsMapLoaded)
    {
        <ResponsiveText Text="@Strings.Loading" CenterText="true" CssClass="mt-2xl mb-2xl" />
    }
    else
    {
        <div id="mapArea" class="map-detail-area">

            <ResponsiveHeading Level="1" Text="@Map.Name" CssClass="mb-md" />

            <div class="map-detail-ratings mb-lg">

                <div class="map-detail-rating">
                    <ResponsiveLabel Text="@Strings.MapArchive_MapRating" CssClass="map-detail-rating-label" />
                    <StarRating Rating="@Map.Rating" IsReadOnly="true" />
                </div>

                <div class="map-detail-rating">
                    <ResponsiveLabel Text="@Strings.MapArchive_UserRating" CssClass="map-detail-rating-label" />
                    <StarRating Rating="@UserRating" AriaLabel="@Strings.MapArchive_UserRating" OnRatingChange="UpdateUserMapRating" />
                </div>

            </div>

            @*
                The map preview itself is intentionally left untouched: it keeps the same 70%-wide
                centered column it has always been rendered in.
            *@
            <ResponsiveContainer Type="ContainerType.Fluid"
                                 Padding="none"
                                 CenteredItems="true"
                                 Direction="Enums.FlexDirection.Column"
                                 Width="70"
                                 CssClass="map-detail-map">
                @DynamicComponent
            </ResponsiveContainer>

            <MapSliceEvaluation Map="_map" MapTemplate="Map.MapTemplate" />

            <dl class="map-detail-meta mt-xl">

                <dt><ResponsiveLabel Text="@Strings.MapArchive_MapAuthor" /></dt>
                <dd><ResponsiveLabel Text="@Map.UserName" /></dd>

                <dt><ResponsiveLabel Text="@Strings.MapArchive_MapEvent" /></dt>
                <dd><ResponsiveLabel Text="@Map.EventName" /></dd>

                <dt><ResponsiveLabel Text="@Strings.MapArchive_MapTemplate" /></dt>
                <dd><ResponsiveLabel Text="@Map.MapTemplate.GetDisplayName()" /></dd>

                <dt class="map-detail-meta-full"><ResponsiveLabel Text="@Strings.MapArchive_MapDescription" /></dt>
                <dd class="map-detail-meta-full">
                    <div class="map-detail-description handel white shadow">
                        @MarkupStringDescription
                    </div>
                </dd>

                <dt><ResponsiveLabel Text="@Strings.MapArchive_TtsString" /></dt>
                <dd><ResponsiveLabel Text="@Map.TtsString" CssClass="text-break-all" /></dd>

                <dt><ResponsiveLabel Text="@Strings.MapArchive_MapGeneratorLink" /></dt>
                <dd><ResponsiveLabel Text="@Map.MapGeneratorLink" CssClass="text-break-all" /></dd>

                <dt><ResponsiveLabel Text="@Strings.MapArchive_MapArchiveLink" /></dt>
                <dd><ResponsiveLabel Text="@Map.MapArchiveLink" CssClass="text-break-all" /></dd>

            </dl>

        </div>
    }

</Page>
