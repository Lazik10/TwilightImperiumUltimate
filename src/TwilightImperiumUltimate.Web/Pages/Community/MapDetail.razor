@page "/community/maps-archive/map/{MapId:int}"

@using TwilightImperiumUltimate.Web.Components.MapGenerator
@using TwilightImperiumUltimate.Web.Components.MapsArchive
@using TwilightImperiumUltimate.Web.Components.Shared.Bars
@using TwilightImperiumUltimate.Web.Helpers.Enums

<Page>

    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart" >
        <ResponsiveButton Text="@Strings.ButtonBack" OnClick="RedirectBack" FontSize="24" Width="20" TextAlign="@(string.Empty)" />
    </ResponsiveContainer>
    
    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexEnd">
        <QuickMenuItem IconType="IconType.DownloadMapImage" IconTypeClicked="IconType.DownloadMapImageClicked" OnClick="async () => await HandleDownloadIconClick()" />
    </ResponsiveContainer>

    @if (!_map.Keys.Any())
        return;

    <div id="mapArea" style="width: 100%;">

        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="70">

                <Title Text="@Map.Name"  MarginTop="0" MarginBottom="20" />

                <ResponsiveContainer Type="ContainerType.Flex" Padding="none">
                    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart" Width="50">
                        <Label Text="@Strings.MapArchive_MapRating" Style="margin-right: 10px;" Width="20"/>
                        <StarRating Rating="@Map.Rating" IsReadOnly="true" />
                    </ResponsiveContainer>
                    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexEnd" Width="50">
                        <Label Text="@Strings.MapArchive_UserRating" Style="margin-right: 10px;" Width="30"/>
                        <StarRating Rating="@UserRating" OnRatingChange="UpdateUserMapRating" />
                    </ResponsiveContainer>
                </ResponsiveContainer>

                @DynamicComponent
            </ResponsiveContainer>

            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="100" CssClass="mt-3xl">

                <MapSliceEvaluation Map="_map" MapTemplate="Map.MapTemplate" />

            </ResponsiveContainer>

            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="70" CssClass="mt-2xl">

                <GridLayout Columns="4" Gap="40" CssClass="mb-md">

                    <Label Text="@Strings.MapArchive_MapAuthor" />
                    <Label Text="@Map.UserName" Style="grid-column: span 3;" />

                    <Label Text="@Strings.MapArchive_MapEvent" />
                    <Label Text="@Map.EventName" Style="grid-column: span 3;" />

                    <Label Text="@Strings.MapArchive_MapTemplate" />
                    <Label Text="@Map.MapTemplate.GetDisplayName()" Style="grid-column: span 3;" />

                    <Label Text="@Strings.MapArchive_MapDescription" Style="grid-column: span 4;" />

                    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Style="grid-column: span 4;" CssClass="mt-md mb-md">

                        <div class="handel white shadow">
                            @MarkupStringDescription
                        </div>

                    </ResponsiveContainer>

                    <Label Text="@Strings.MapArchive_TtsString" />

                    <Label Text="@Map.TtsString" CssClass="text-break-all" Style="grid-column: span 3;" />

                    <Label Text="@Strings.MapArchive_MapGeneratorLink" />

                    <Label Text="@Map.MapGeneratorLink" CssClass="text-break-all" Style="grid-column: span 3;" />

                    <Label Text="@Strings.MapArchive_MapArchiveLink" />

                    <Label Text="@Map.MapArchiveLink" CssClass="text-break-all" Style="grid-column: span 3;" />

                </GridLayout>

            </ResponsiveContainer>

        </ResponsiveContainer>

    </div>

</Page>
