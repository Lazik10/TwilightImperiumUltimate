@page "/"
@page "/news"
@using TwilightImperiumUltimate.Web.Components.News;

<PageTitle>@Strings.Page_News</PageTitle>

<Page LeftPadding="7" RightPadding="13">
    <ResponsiveHeading Level="1" Text="@Strings.Page_News" CssClass="news-page-title" FontSize="2xl" CenterText="true" />

    @if (_isLoading)
    {
        <div class="news-state-message" role="status" aria-live="polite">@Strings.News_Loading</div>
    }
    else if (_hasError)
    {
        <div class="news-state-message" role="alert">@Strings.News_Error</div>
    }
    else if (_newsArticles?.Count > 0)
    {
        <ul class="news-list">
            @foreach (var article in _newsArticles)
            {
                <li class="news-list-item" @key="article.Id">
                    <NewsArticleSegment NewsArticle="@article" />
                </li>
            }
        </ul>
    }
    else
    {
        <div class="news-state-message" role="status" aria-live="polite">@Strings.News_Empty</div>
    }
</Page>
