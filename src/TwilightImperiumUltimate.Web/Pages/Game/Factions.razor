@page "/game/factions"
@page "/game/factions/{FactionOrSource}"
@using TwilightImperiumUltimate.Web.Components.Factions
@using TwilightImperiumUltimate.Web.Components.Shared.Controls

<PageTitle>@PageHeading</PageTitle>

<HeadContent>
    <meta name="description" content="@MetaDescription" />
</HeadContent>

<Page>

    <ResponsiveHeading Level="1" Text="@Strings.Page_Factions"/>

    <section class="factions-source-selector mb-lg">
        <ResponsiveText Text="@Strings.Page_Factions_SourceLabel" CenterText="true" CssClass="mb-xs" />
        <ResponsiveDropDown Id="faction-source-select"
                            TValue="FactionSource"
                            Data="@GetFactionSourceOptions()"
                            TextProperty="Value"
                            ValueProperty="Key"
                            Value="@_selectedSource"
                            ValueChanged="OnSourceChanged"
                            FillWidth="false" />
    </section>

    <FactionIconMenu @key="_selectedSource"
                     OnFactionClickGetFaction="UpdateSelectedFaction"
                     Faction="@SelectedFactionParameterValue"
                     Source="@_selectedSource" />

    <FactionTemplateGrid @ref="_factionTemplateGridRef" />

</Page>
