@page "/game/planets"

<PageTitle>@Strings.Page_Planets_PageTitle</PageTitle>

<Page>
    <ResponsiveHeading Level="1" Text="@Strings.Page_Planets" CssClass="mb-2xl" FontSize="2xl" />

    <ResponsiveContainer Type="ContainerType.Flex" JustifyContent="Enums.JustifyContent.SpaceBetween" AlignItems="Enums.AlignItems.FlexStart" CssClass="planets-filters-container">
        <GameVersionFilterDropdown GameVersions="GetAvailableGameVersions()"
                                   SelectedGameVersion="@_selectedGameVersion"
                                   SelectedGameVersionChanged="OnGameVersionFilterChanged"
                                   Label="@Strings.PlanetsFilter_ByExpansion"
                                   CssClass="planets-filter-dropdown" />

        <ResponsiveDropDown Id="planets-filter-by-trait"
                            TValue="string"
                            Label="@Strings.PlanetsFilter_ByTrait"
                            Data="@GetPlanetFilterOptions()"
                            TextProperty="Label"
                            ValueProperty="Value"
                            Value="@_selectedPlanetFilter"
                            ValueChanged="OnPlanetFilterChanged"
                            CssClass="planets-filter-dropdown"
                            FillWidth="false" />
    </ResponsiveContainer>

    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none">
        @foreach (var gameVersion in GetVisiblePlanets())
        {
            @if (!_selectedGameVersion.HasValue)
            {
                <ResponsiveHeading Level="4" Text="@gameVersion.Key.GetDisplayName()" CenterText="true" CssClass="handel white shadow" />
            }

            <div class="planets-grid-shell" @key="gameVersion.Key">
                <ResponsiveGridContainer Columns="5" TabletColumns="3" MobileColumns="2" Width="100" Gap="1rem" CssClass="mb-2xl">
                    @foreach (var planet in gameVersion)
                    {
                        <ClickableTile @key="planet.PlanetName" OnClick="@(() => ShowBigImage(planet, CultureInfo.CurrentCulture.Name))">
                            <PlanetCard Name="@planet.PlanetName.ToString()" />
                        </ClickableTile>
                    }
                </ResponsiveGridContainer>
            </div>
        }

        @if (HasMorePlanetsToLoad)
        {
            <InfiniteScrollSentinel OnIntersect="LoadMorePlanets" />
        }
    </ResponsiveContainer>

    <BigImageOverlay IsOpen="_showBigImage" ImageSrc="@_currentBigImageSrc" ImageAlt="@_currentBigImageAlt" OnClose="HideBigImage" AriaLabel="@Strings.Page_Planets">
        <div class="mt-md">
            <LanguageFlagMenu CurrentCulture="@_currentBigImageCulture" CultureSelected="SetBigImageAddress" />
        </div>
    </BigImageOverlay>
</Page>
