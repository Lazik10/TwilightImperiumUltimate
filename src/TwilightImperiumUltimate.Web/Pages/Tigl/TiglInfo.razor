@page "/community/tigl"

<PageTitle>@Strings.Page_TiglInfo</PageTitle>

<Page>

    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column">

        <ResponsiveHeading Text="@Strings.TiglInfo_MainTitle" Level="1" CenterText="true" CssClass="mb-xl" />

        <ResponsiveText Text="@Strings.TiglInfo_Subtitle" CenterText="true" FontSize="xl" TextColor="TextColor.Yellow" CssClass="mb-xl" />

        <ResponsiveHeading Text="@Strings.TiglInfo_OverviewHeading" Level="2" CenterText="true" />

        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
            <div class="info-content">
                @_overviewContent
            </div>
        </ResponsiveContainer>

        <ResponsiveHeading Text="@Strings.TiglInfo_TiglHeading" Level="2" CenterText="true" />

        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
            <div class="info-content">
                @_tiglContent
            </div>
        </ResponsiveContainer>

        <ResponsiveHeading Text="@Strings.TiglInfo_CodeOfConductHeading" Level="2" CenterText="true" />

        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
            <div class="info-content">
                @_codeOfConductContent
            </div>
        </ResponsiveContainer>

        <ResponsiveHeading Text="@Strings.TiglInfo_GettingStartedHeading" Level="2" FontSize="2xl" CenterText="true" />

        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
            <div class="info-content">

                <ResponsiveHeading Text="@Strings.TiglInfo_GettingStartedSignUpHeading" Level="3" FontSize="2xl" CenterText="true" />

                @_gettingStartedContent
            </div>
        </ResponsiveContainer>

        <ResponsiveHeading Text="@Strings.TiglInfo_AllowedHeading" Level="2" CenterText="true" />

        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
            <div class="info-content">
                @_allowedContent
            </div>
        </ResponsiveContainer>

        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
            <ResponsiveButton ButtonText="@Strings.TiglInfo_RegisterButton" OnClick="NavigateToRegister" Width="25" MobileWidth="60" CssClass="mb-md" />
            <ResponsiveButton ButtonText="@Strings.TiglInfo_ReportGameButton" OnClick="NavigateToReportGame" Width="25" MobileWidth="60" CssClass="mb-md" />
            <ResponsiveButton ButtonText="@Strings.TiglInfo_JoinDiscordButton" OnClick="NavigateToDiscord" Width="25" MobileWidth="60" CssClass="mb-md" />
            <ResponsiveButton ButtonText="@Strings.TiglInfo_ManifestButton" OnClick="NavigateToManifest" Width="25" MobileWidth="60" CssClass="mb-md" />
        </ResponsiveContainer>

    </ResponsiveContainer>

</Page>
