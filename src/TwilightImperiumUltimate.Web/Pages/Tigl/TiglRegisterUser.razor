@page "/community/tigl/register"

<PageTitle>@Strings.Page_TiglRegister</PageTitle>

<Page>

    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

        <ResponsiveHeading Text="@Strings.TiglRegisterUser_MainTitle" Level="1" CenterText="true" CssClass="mb-lg" />

        <ResponsiveText Text="@Strings.TiglRegisterUser_Subtitle" CenterText="true" FontSize="sm" CssClass="mb-3xl" />

        @if (IsRegistrationSuccessful())
        {
            <ResponsiveText Text="@Strings.TiglRegisterUser_SuccessTitle" CenterText="true" FontSize="2xl" TextColor="TextColor.Green" CssClass="mb-2xl" />

            <ResponsiveText Text="@Strings.TiglRegisterUser_SuccessRedirectMessage" CenterText="true" CssClass="mb-md" />
        }
        else if (IsRegistrationFailure())
        {
            <ResponsiveText Text="@Strings.TiglRegisterUser_FailureTitle" CenterText="true" FontSize="2xl" TextColor="TextColor.Red" CssClass="mb-2xl" />

            <ResponsiveText Text="@ErrorMessage" CenterText="true" TextColor="TextColor.Red" FontSize="xl" CssClass="mb-md" />

            <ResponsiveText Text="@Strings.TiglRegisterUser_FailureRedirectMessage" CenterText="true" CssClass="mb-md" />
        }
        else
        {
            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
                <div class="info-content">
                    @_codeOfConductContent
                </div>
            </ResponsiveContainer>

            <ResponsiveButton ButtonText="@Strings.TiglRegisterUser_RegisterButton" OnClick="RegisterWithDiscord" Width="30" MobileWidth="60" CssClass="mt-3xl mb-md" />
        }

    </ResponsiveContainer>

</Page>