@page "/community/tigl/report-game"
@using TwilightImperiumUltimate.Contracts.Enums
@using TwilightImperiumUltimate.Web.Components.Shared.Controls
@using TwilightImperiumUltimate.Web.Components.Shared.Layouts
@using Radzen

<PageTitle>@Strings.Page_TiglReportGame_PageTitle</PageTitle>

<Page>
    
    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

        @if (_loading)
        {
            <ResponsiveText Text="@Strings.ReportGame_Loading" CenterText="true" FontSize="xl" CssClass="mt-2xl mb-2xl" />
        }
        else
        {

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <ResponsiveText Text="@successMessage" TextColor="TextColor.Green" CenterText="true" CssClass="mb-sm" />
            }

            <ResponsiveHeading Text="@Strings.Page_TiglReportGame" Level="1" />

            <section class="report-game-card report-game-shell mt-md mb-xl">
                <ResponsiveText Text="@Strings.ReportGame_GameId" CenterText="true" FontSize="lg" CssClass="mb-md" />
                <ResponsiveTextBox Id="game-id" @bind-Value="gameReportRequest.GameId" Width="40" CssClass="mb-md" />
                <ResponsiveText Text="@Strings.ReportGame_GameIdAsyncHint" FontSize="sm" CenterText="true" />
                <ResponsiveText Text="@Strings.ReportGame_GameIdOtherHint" FontSize="sm" CenterText="true" />
            </section>

            <section class="report-game-card report-game-shell mb-xl">
                <ResponsiveGridContainer Columns="2" TabletColumns="2" MobileColumns="1" Gap="var(--space-lg)" Width="100">
                    <div class="report-game-field">
                        <ResponsiveText Text="@Strings.ReportGame_LeagueLabel" CenterText="true" CssClass="mb-xs" />
                        <ResponsiveDropDown Id="league-select"
                                    TValue="TiglLeague"
                                    Data="@GetLeagueOptions()"
                                    TextProperty="Value"
                                    ValueProperty="Key"
                                    Value="@gameReportRequest.League"
                                    ValueChanged="ChangeLeague" />
                    </div>

                    <div class="report-game-field">
                        <ResponsiveText Text="@Strings.ReportGame_SourceLabel" CenterText="true" CssClass="mb-xs" />
                        <ResponsiveDropDown Id="source-select"
                                    TValue="ResultSource"
                                    Data="@GetSourceOptions()"
                                    TextProperty="Value"
                                    ValueProperty="Key"
                                    Value="@gameReportRequest.Source"
                                    ValueChanged="ChangeSource" />
                    </div>

                    <div class="report-game-field">
                        <ResponsiveText Text="@Strings.ReportGame_VpLabel" CenterText="true" CssClass="mb-xs" />
                        <ResponsiveDropDown Id="vp-select" TValue="int" Data="@GetVpOptions()" @bind-Value="_selectedVpCount" />
                    </div>

                    <div class="report-game-field">
                        <ResponsiveText Text="@Strings.ReportGame_RoundLabel" CenterText="true" CssClass="mb-xs" />
                        <ResponsiveDropDown Id="round-select" TValue="int" Data="@GetRoundOptions()" @bind-Value="_round" />
                    </div>
                </ResponsiveGridContainer>

                <ResponsiveGridContainer Columns="2" MobileColumns="1" Gap="var(--space-lg)" Width="100" CssClass="mt-xl">
                    <div class="report-game-field">
                        <ResponsiveText Text="@Strings.ReportGame_StartDate" CenterText="true" CssClass="mb-xs" />
                        <ResponsiveDatePicker Id="report-game-start-date" @bind-Value="startGame" ShowTime="true" ShowSeconds="false" />
                    </div>
                    <div class="report-game-field">
                        <ResponsiveText Text="@Strings.ReportGame_EndDate" CenterText="true" CssClass="mb-xs" />
                        <ResponsiveDatePicker Id="report-game-end-date" @bind-Value="endGame" ShowTime="true" ShowSeconds="false" />
                    </div>
                </ResponsiveGridContainer>
            </section>

            <ResponsiveHeading Text="@Strings.ReportGame_PlayersHeading" Level="2" CenterText="true" CssClass="mt-2xl mb-lg" />

            @for (var i = 0; i < playerResults.Count; i++)
            {
                var index = i;
                <section class="report-game-card report-game-shell mb-lg" @key="index">

                    @if (_rowModes.Count > index && _rowModes[index] == RowViewMode.Search)
                    {
                        <ResponsiveText Text="@string.Format(Strings.ReportGame_FindPlayer, index + 1)" CenterText="true" FontSize="xl" TextColor="TextColor.Green" CssClass="mb-md" />

                        @if (_currentPlayerIndex != index)
                        {
                            <ResponsiveButton Text="@Strings.ReportGame_OpenSearch" TextColor="TextColor.Green" OnClick="(() => OpenPlayerSearch(index))" />
                        }
                        else
                        {
                            <ResponsiveGridContainer Columns="2" MobileColumns="1" Gap="var(--space-lg)" Width="100">
                                <div class="report-game-field">
                                    <ResponsiveText Text="@Strings.ReportGame_ByTiglName" CenterText="true" TextColor="TextColor.Yellow" CssClass="mb-xs" />
                                    <ResponsiveDropDown Id="@($"player-{index}-tigl-name")"
                                                TValue="long"
                                                Data="@_users"
                                                TextProperty="TiglUserName"
                                                ValueProperty="DiscordUserId"
                                                Value="@playerResults[index].DiscordId"
                                                AllowFiltering="true"
                                                AllowVirtualization="true"
                                                Placeholder="@Strings.ReportGame_TypeTiglName"
                                                ValueChanged="@((long v) => OnUserSelected(index, v))" />
                                </div>
                                <div class="report-game-field">
                                    <ResponsiveText Text="@Strings.ReportGame_ByDiscordName" CenterText="true" TextColor="TextColor.Yellow" CssClass="mb-xs" />
                                    <ResponsiveDropDown Id="@($"player-{index}-discord-name")"
                                                    TValue="long"
                                                    Data="@_users"
                                                    TextProperty="DiscordUserName"
                                                    ValueProperty="DiscordUserId"
                                                    Value="@playerResults[index].DiscordId"
                                                    AllowFiltering="true"
                                                    AllowVirtualization="true"
                                                    Placeholder="@Strings.ReportGame_TypeDiscordTag"
                                                    ValueChanged="@((long v) => OnUserSelected(index, v))" />
                                </div>
                            </ResponsiveGridContainer>
                        }
                    }
                    else
                    {
                        <ResponsiveText Text="@string.Format(Strings.ReportGame_PlayerHeader, index + 1)" CenterText="true" FontSize="xl" TextColor="TextColor.Green" CssClass="mb-md" />

                        <ResponsiveGridContainer Columns="2" MobileColumns="1" Gap="var(--space-lg)" Width="100" CssClass="mb-lg">
                            <div class="report-game-field">
                                <ResponsiveText Text="@Strings.ReportGame_TiglUsername" CenterText="true" TextColor="TextColor.Yellow" CssClass="mb-xs" />
                                <ResponsiveText Text="@GetTiglUserName(playerResults[index].DiscordId)" CenterText="true" FontSize="xl" />
                            </div>
                            <div class="report-game-field">
                                <ResponsiveText Text="@Strings.ReportGame_DiscordTag" CenterText="true" TextColor="TextColor.Yellow" CssClass="mb-xs" />
                                <ResponsiveText Text="@GetDiscordTag(playerResults[index].DiscordId)" CenterText="true" FontSize="xl" />
                            </div>
                        </ResponsiveGridContainer>

                        <ResponsiveGridContainer Columns="3" TabletColumns="3" MobileColumns="1" Gap="var(--space-lg)" Width="100" CssClass="mb-lg">
                            <div class="report-game-field">
                                <ResponsiveText Text="@Strings.ReportGame_Faction" CssClass="mb-xs" />
                                <ResponsiveDropDown Id="@($"player-{index}-faction")"
                                                TValue="string"
                                                Data="@_availableFactionNames"
                                                @bind-Value="playerResults[index].Faction"
                                                AllowFiltering="true"
                                                Placeholder="@Strings.ReportGame_SelectFaction" />
                            </div>
                            <div class="report-game-field">
                                <ResponsiveText Text="@Strings.ReportGame_Winner" CenterText="true" CssClass="mb-xs" />
                                <RadzenCheckBox @bind-Value="playerResults[index].IsWinner" />
                            </div>
                            <div class="report-game-field">
                                <ResponsiveText Text="@Strings.ReportGame_Score" CenterText="true" CssClass="mb-xs" />
                                <RadzenNumeric TValue="int" @bind-Value="playerResults[index].Score" Style="width: 100%;" Min="0" Max="@_selectedVpCount" />
                            </div>
                        </ResponsiveGridContainer>

                        <ResponsiveButton Text="@Strings.ReportGame_ClearPlayer" TextColor="TextColor.Red" OnClick="() => ClearPlayer(index)" Width="60" />
                    }
                </section>
            }

            <div class="report-game-shell mt-md mb-2xl">
                <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.SpaceBetween">
                    @if (_selectedLeague == TiglLeague.Fractured && playerResults.Count < MaxNumberOfPlayers)
                    {
                        <ResponsiveButton Text="@Strings.ReportGame_AddPlayerSlot" TextColor="TextColor.Green" OnClick="AddPlayer" />
                    }
                    @if (playerResults.Count > MinNumberOfPlayers)
                    {
                        <ResponsiveButton Text="@Strings.ReportGame_RemovePlayerSlot" TextColor="TextColor.Red" OnClick="RemovePlayer" />
                    }
                </ResponsiveContainer>
            </div>

            @if (gameReportRequest.League == TiglLeague.Fractured)
            {
                <section class="report-game-card report-game-shell mb-xl">
                    <ResponsiveText Text="@Strings.ReportGame_GalacticEventsHeading" FontSize="xl" CenterText="true" TextColor="TextColor.Yellow" CssClass="mb-lg" />

                    <ResponsiveGridContainer Columns="2" TabletColumns="2" MobileColumns="1" Gap="var(--space-sm)" Width="100">
                        @foreach (var e in _allGalacticEvents)
                        {
                            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart" AlignItems="Enums.AlignItems.Center" CssClass="report-game-event">
                                <RadzenCheckBox ValueChanged="@((bool value) => ToggleEvent(e, value))" />
                                <ResponsiveText Text="@e" CssClass="ml-sm" />
                            </ResponsiveContainer>
                        }
                    </ResponsiveGridContainer>
                </section>
            }

            <div class="mt-2xl">
                @if (validationErrors.Count > 0)
                {
                    foreach(var err in validationErrors)
                    {
                        <ResponsiveText Text="@string.Format(Strings.ReportGame_ValidationBullet, err)" TextColor="TextColor.Red" CenterText="true" CssClass="mb-sm" />
                    }
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <ResponsiveText Text="@errorMessage" TextColor="TextColor.Red" CenterText="true" CssClass="mb-md" />
                    @if (!string.IsNullOrEmpty(errorDetails))
                    {
                        <ResponsiveText Text="@errorDetails" TextColor="TextColor.Orange" CenterText="true" CssClass="mb-md" />
                    }
                }

                <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mb-2xl">
                    <ResponsiveButton ButtonText="@Strings.ReportGame_SubmitButton" IsDisabled="@isSubmitting" OnClick="async () => await SubmitGameReport()" />
                </ResponsiveContainer>
            </div>
        }

    </ResponsiveContainer>

</Page>
