@page "/community/tigl/game-detail"
@using TwilightImperiumUltimate.Contracts.DTOs.Tigl

<Page>
    <section class="tigl-game-report-detail" aria-label="Game report">
        <StretchHeightContainer>

        @if (MatchReport is not null)
        {
            <div class="tigl-game-report-title mb-xl">
                <ResponsiveHeading Level="1" Text="@MatchReport.GameId" CenterText="true" CssClass="mb-0" />
                <ResponsiveButton ButtonText="Show Game" OnClick="NavigateToAsyncGame" />
            </div>

            <section class="tigl-game-report-overview mb-xl" aria-label="Overview">
                <ResponsiveHeading Level="2" Text="Overview" FontSize="lg" CenterText="true" CssClass="mb-0" />
                <table class="tigl-game-report-overview-table">
                    <tbody>
                        <tr class="tigl-game-report-overview-headers">
                            <th scope="colgroup" colspan="3">Winner</th>
                            <th scope="colgroup" colspan="3">Faction</th>
                        </tr>
                        <tr>
                            <td colspan="3">
                                <button type="button" class="tigl-game-report-overview-player tigl-game-report-player-name tigl-game-report-winner-name" aria-label="@($"View {GetUserName(Winners[0])}'s profile")" @onclick="() => NavigateToPlayerProfile(Winners[0])">
                                    <img src="@PathProvider.GetIconPath(IconType.Winner)" alt="" aria-hidden="true" />
                                    <span>@GetUserName(Winners[0])</span>
                                    <img src="@PathProvider.GetIconPath(IconType.Winner)" alt="" aria-hidden="true" />
                                </button>
                            </td>
                            <td colspan="3">
                                <div class="tigl-game-report-faction tigl-game-report-overview-faction">
                                    <TiglFactionImg Faction="@Winners[0].Faction" Height="40" />
                                    <span>@Winners[0].Faction.GetDisplayName()</span>
                                    <TiglFactionImg Faction="@Winners[0].Faction" Height="40" />
                                </div>
                            </td>
                        </tr>
                        <tr class="tigl-game-report-overview-headers">
                            <th scope="colgroup" colspan="3">Game Rank</th>
                            <th scope="colgroup" colspan="3">League</th>
                        </tr>
                        <tr>
                            <td colspan="3" style="color: @(GetGameRank().GetRankColor().ConvertToString());">@GetGameRank().GetDisplayName()</td>
                            <td colspan="3">@MatchReport.League.GetDisplayName()</td>
                        </tr>
                        <tr class="tigl-game-report-overview-headers">
                            <th scope="colgroup" colspan="2">Start Date</th>
                            <th scope="colgroup" colspan="2">End Date</th>
                            <th scope="colgroup" colspan="2">Duration</th>
                        </tr>
                        <tr>
                            <td colspan="2">@MatchReport.StartTimestamp.FormatToDateString()</td>
                            <td colspan="2">@MatchReport.EndTimestamp.FormatToDateString()</td>
                            <td colspan="2">@((MatchReport.EndTimestamp - MatchReport.StartTimestamp).FormatToDaysDuration())</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <ResponsiveRadzenDataGrid TItem="PlayerResultDto"
                                      Data="@OrderedPlayerResults"
                                      AllowPaging="false"
                                      AllowSorting="false"
                                      AllowColumnResize="false"
                                      AllowAlternatingRows="true"
                                      RowClick="NavigateToPlayerProfile"
                                      CssClass="mb-xl tigl-game-report-grid tigl-game-report-handel-grid">
                <HeaderTemplate>
                    <ResponsiveHeading Level="2" Text="Players" FontSize="lg" CenterText="true" CssClass="mb-0" />
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="PlayerResultDto" Property="@nameof(PlayerResultDto.TiglUserName)" Title="Player" TextAlign="TextAlign.Left">
                        <Template Context="player">
                            <span class="tigl-game-report-player-name @(player.IsWinner ? "tigl-game-report-winner-name" : string.Empty)">
                                @if (player.IsWinner)
                                {
                                    <img src="@PathProvider.GetIconPath(IconType.Winner)" alt="Winner" />
                                }
                                <span>@GetUserName(player)</span>
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PlayerResultDto" Property="@nameof(PlayerResultDto.Faction)" Title="Faction">
                        <Template Context="player">
                            <div class="tigl-game-report-faction">
                                <TiglFactionImg Faction="@player.Faction" Height="30" />
                                <span>@player.Faction.GetDisplayName()</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="PlayerResultDto" Property="@nameof(PlayerResultDto.Score)" Title="Score" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="PlayerResultDto" Title="New Rank" TextAlign="TextAlign.Center">
                        <Template Context="player">
                            @{ var playerStats = GetPlayersAsyncData(player.TiglUserId); }
                            @if (playerStats.NewRank != playerStats.OldRank)
                            {
                                <span style="color: @(playerStats.NewRank.GetRankColor().ConvertToString());">@playerStats.NewRank.GetDisplayName()</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </ResponsiveRadzenDataGrid>

            <ResponsiveRadzenDataGrid TItem="PlayerResultDto"
                                      Data="@OrderedPlayerResults"
                                      AllowPaging="false"
                                      AllowSorting="false"
                                      AllowColumnResize="false"
                                      AllowAlternatingRows="true"
                                      RowClick="NavigateToPlayerProfile"
                                      CssClass="mb-xl tigl-game-report-grid tigl-game-report-handel-grid">
                <HeaderTemplate>
                    <div class="tigl-game-report-ratings-header">
                        <ResponsiveHeading Level="2" Text="Ratings" FontSize="lg" CenterText="true" CssClass="mb-0" />
                        <button type="button"
                                class="tigl-game-report-ratings-filter-toggle"
                                aria-label="@RankingSystemFilterButtonLabel"
                                title="@RankingSystemFilterButtonLabel"
                                aria-expanded="@_isRankingSystemFilterVisible.ToString().ToLowerInvariant()"
                                aria-controls="@(_isRankingSystemFilterVisible ? "tigl-game-report-ranking-system-filter" : null)"
                                @onclick="ToggleRankingSystemFilter">
                            <img src="@RankingSystemFilterIconPath" alt="" aria-hidden="true" />
                        </button>

                        @if (_isRankingSystemFilterVisible)
                        {
                            <div id="tigl-game-report-ranking-system-filter" class="tigl-game-report-ranking-system-filter">
                                <ResponsiveDropDown Id="tigl-game-report-ranking-system"
                                                    TValue="RankingSystem"
                                                    Label="Rating"
                                                    LabelPosition="LabelPosition.Column"
                                                    Data="@RankingSystemOptions"
                                                    TextProperty="Value"
                                                    ValueProperty="Key"
                                                    Value="@_selectedRankingSystem"
                                                    ValueChanged="ChangeRankingSystem"
                                                    Width="50" />
                            </div>
                        }
                    </div>
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn TItem="PlayerResultDto" Property="@nameof(PlayerResultDto.TiglUserName)" Title="@Strings.TiglLeaderboard_Player" TextAlign="TextAlign.Left">
                        <Template Context="player">
                            <span class="tigl-game-report-player-name @(player.IsWinner ? "tigl-game-report-winner-name" : string.Empty)">
                                @if (player.IsWinner)
                                {
                                    <img src="@PathProvider.GetIconPath(IconType.Winner)" alt="Winner" />
                                }
                                <span>@GetUserName(player)</span>
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    @if (_selectedRankingSystem == RankingSystem.TrueSkill)
                    {
                        <RadzenDataGridColumn TItem="PlayerResultDto" Title="@Strings.TiglLeaderboard_TrueSkillConservativeRating">
                            <Columns>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="New">
                                    <Template Context="player">@GetPlayersTrueSkillData(player.TiglUserId).ConservativeRatingNew.ToString("F2")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="Change">
                                    <Template Context="player">
                                        @{ var stats = GetPlayersTrueSkillData(player.TiglUserId); }
                                        <span style="color: @(GetChangeColor(stats.ConservativeRatingChange).ConvertToString());">@stats.ConservativeRatingChange.ToSignedFormat(2)</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PlayerResultDto" Title="@Strings.TiglLeaderboard_TrueSkillMu">
                            <Columns>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="New">
                                    <Template Context="player">@GetPlayersTrueSkillData(player.TiglUserId).MuNew.ToString("F2")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="Change">
                                    <Template Context="player">
                                        @{ var stats = GetPlayersTrueSkillData(player.TiglUserId); }
                                        <span style="color: @(GetChangeColor(stats.MuChange).ConvertToString());">@stats.MuChange.ToSignedFormat(2)</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PlayerResultDto" Title="@Strings.TiglLeaderboard_TrueSkillSigma">
                            <Columns>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="New">
                                    <Template Context="player">@GetPlayersTrueSkillData(player.TiglUserId).SigmaNew.ToString("F3")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="Change">
                                    <Template Context="player">
                                        @{ var stats = GetPlayersTrueSkillData(player.TiglUserId); }
                                        <span style="color: @(GetChangeColor(stats.SigmaChange).ConvertToString());">@stats.SigmaChange.ToSignedFormat(3)</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGridColumn>
                    }
                    else if (_selectedRankingSystem == RankingSystem.Glicko2)
                    {
                        <RadzenDataGridColumn TItem="PlayerResultDto" Title="@Strings.TiglLeaderboard_GlickoRating">
                            <Columns>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="New">
                                    <Template Context="player">@GetPlayersGlickoData(player.TiglUserId).RatingNew.ToString("F2")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="Change">
                                    <Template Context="player">
                                        @{ var stats = GetPlayersGlickoData(player.TiglUserId); }
                                        <span style="color: @(GetChangeColor(stats.RatingChange).ConvertToString());">@stats.RatingChange.ToSignedFormat(2)</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PlayerResultDto" Title="@Strings.TiglLeaderboard_GlickoRd">
                            <Columns>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="New">
                                    <Template Context="player">@GetPlayersGlickoData(player.TiglUserId).RdNew.ToString("F2")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="Change">
                                    <Template Context="player">
                                        @{ var stats = GetPlayersGlickoData(player.TiglUserId); }
                                        <span style="color: @(GetChangeColor(stats.RdChange).ConvertToString());">@stats.RdChange.ToSignedFormat(2)</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PlayerResultDto" Title="@Strings.TiglLeaderboard_GlickoVolatility">
                            <Columns>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="New">
                                    <Template Context="player">@GetPlayersGlickoData(player.TiglUserId).VolatilityNew.ToString("F6")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="Change">
                                    <Template Context="player">
                                        @{ var stats = GetPlayersGlickoData(player.TiglUserId); }
                                        <span style="color: @(GetChangeColor(stats.VolatilityChange).ConvertToString());">@stats.VolatilityChange.ToSignedFormat(6)</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGridColumn>
                    }
                    else
                    {
                        <RadzenDataGridColumn TItem="PlayerResultDto" Title="@Strings.TiglLeaderboard_AsyncRating">
                            <Columns>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="Rating">
                                    <Template Context="player">@GetPlayersAsyncData(player.TiglUserId).RatingNew.ToString("F2")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="Change">
                                    <Template Context="player">
                                        @{ var stats = GetPlayersAsyncData(player.TiglUserId); }
                                        <span style="color: @(GetChangeColor(stats.RatingChange).ConvertToString());">@stats.RatingChange.ToSignedFormat(2)</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PlayerResultDto" Title="@Strings.TiglLeaderboard_AussieScore">
                            <Columns>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="Rating">
                                    <Template Context="player">@GetPlayersAsyncData(player.TiglUserId).AussieScoreNew.ToString("F2")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="PlayerResultDto" Title="Change">
                                    <Template Context="player">
                                        @{ var stats = GetPlayersAsyncData(player.TiglUserId); }
                                        <span style="color: @(GetChangeColor(stats.AussieScoreChange).ConvertToString());">@stats.AussieScoreChange.ToSignedFormat(2)</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </ResponsiveRadzenDataGrid>

            @if (MatchReport.League == TiglLeague.Fractured)
            {
                <ResponsiveRadzenDataGrid TItem="string"
                                          Data="@MatchReport.GalacticEvents"
                                          AllowPaging="false"
                                          AllowSorting="false"
                                          AllowColumnResize="false"
                                          AllowAlternatingRows="true"
                                          CssClass="mb-md tigl-game-report-grid">
                    <HeaderTemplate>
                        <ResponsiveHeading Level="2" Text="Galactic Events" FontSize="lg" CenterText="true" CssClass="mb-0" />
                    </HeaderTemplate>
                    <Columns>
                        <RadzenDataGridColumn TItem="string" Title="Event">
                            <Template Context="galacticEvent">@galacticEvent</Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </ResponsiveRadzenDataGrid>
            }
        }

        </StretchHeightContainer>
    </section>

</Page>
