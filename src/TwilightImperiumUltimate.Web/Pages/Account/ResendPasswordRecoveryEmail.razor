@page "/account/resend-password-recovery-email"
@using TwilightImperiumUltimate.Web.Resources

<PageTitle>@Strings.Page_PasswordRecovery_PageTitle</PageTitle>

<Page>
    
    <ResponsiveHeading Level="1" Text="@Strings.Login_PasswordRecovery" />

    @if (_recoveryEmailSend)
    {
        <ResponsiveText Text="@(_passwordRecoveryEmailSendSuccess ? Strings.Login_PasswordRecoveryEmailSend : Strings.Login_PasswordRecoveryEmailSendFailed)"
                        CenterText="true"
                        TextColor="@(_passwordRecoveryEmailSendSuccess ? TextColor.Green : TextColor.Red)"
                        FontSize="lg"
                        CssClass="mt-md mb-md" />
    }

    <ResponsiveForm Model="PasswordRecoveryModel"
                    OnValidSubmit="ResendPasswordRecoveryEmailCode"
                    IsSubmitting="_disableButton"
                    SubmitText="@Strings.Login_ResendPasswordRecoveryEmail"
                    SubmittingText="@Strings.Login_ResendPasswordRecoveryEmail"
                    ValidationDisplay="Enums.ValidationDisplay.Summary"
                    Columns="1"
                    CssClass="mb-xl">

        <ResponsiveFormField TValue="string" Id="resend-password-recovery-email" Label="@Strings.Login_Email" Required="true">
            <ResponsiveTextBox Id="resend-password-recovery-email"
                                Name="email"
                                AutoComplete="email"
                                Placeholder="@Strings.Login_Email"
                                @bind-Value="PasswordRecoveryModel.Email" />
        </ResponsiveFormField>

    </ResponsiveForm>

</Page>
