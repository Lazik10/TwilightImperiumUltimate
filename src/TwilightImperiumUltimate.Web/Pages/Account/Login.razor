@page "/account/login"
@using TwilightImperiumUltimate.Web.Resources

<PageTitle>@Strings.Page_AccountLogin</PageTitle>

<Page>
        <ResponsiveHeading Level="1" Text="@Strings.Login_Title" CenterText="true" CssClass="mb-xl" />

        @if (_showLoginFailed)
        {
            <ResponsiveText Text="@_reasonWhyLoginFailed" CenterText="true" TextColor="TextColor.Red" CssClass="mt-md mb-md" />
        }

        <ResponsiveForm Model="LoginModel"
                        OnValidSubmit="LoginUser"
                        IsSubmitting="_loggingIn"
                        SubmitText="@Strings.Login_Login"
                        SubmittingText="@Strings.Login_Login"
                        ValidationDisplay="Enums.ValidationDisplay.Summary"
                        Columns="1"
                        CssClass="mb-xl">

            <ResponsiveFormField Id="login-username" Label="@Strings.Login_Username" For="@(() => LoginModel.Email)" Required="true">
                <ResponsiveTextBox Id="login-username"
                                   Name="username"
                                   AutoComplete="username"
                                   AriaDescribedBy="login-username-validation"
                                   Placeholder="@Strings.Login_Username"
                                   @bind-Value="LoginModel.Email" />
            </ResponsiveFormField>

            <ResponsiveFormField Id="login-password" Label="@Strings.Login_Password" For="@(() => LoginModel.Password)" Required="true">
                <ResponsivePassword Id="login-password"
                                    Name="password"
                                    AutoComplete="current-password"
                                    AriaDescribedBy="login-password-validation"
                                    Placeholder="@Strings.Login_Password"
                                    @bind-Value="LoginModel.Password" />
            </ResponsiveFormField>

        </ResponsiveForm>

        <ResponsiveButtonGroup CssClass="mt-lg mb-lg" GroupStyle="ButtonGroupStyle.RowFill">
            <ResponsiveButton ButtonText="@Strings.Login_ConfirmationEmail" OnClick="@(() => NavigationManager.NavigateTo(Pages.ResendConfirmationEmail))" />
            <ResponsiveButton ButtonText="@Strings.Login_ForgotPassword" OnClick="@(() => NavigationManager.NavigateTo(Pages.ResendPasswordRecoveryEmail))" />
        </ResponsiveButtonGroup>

</Page>

