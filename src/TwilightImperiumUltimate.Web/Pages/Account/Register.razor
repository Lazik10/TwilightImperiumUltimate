@page "/account/register"
@using TwilightImperiumUltimate.Web.Resources

<PageTitle>@Strings.Page_AccountRegister_PageTitle</PageTitle>

<Page>
    
    <ResponsiveHeading Level="1" Text="@Strings.Register_Title" />

    @if (_registrationSuceeded)
    {
        <ResponsiveText Text="@Strings.Register_RegistrationSucceeded" CenterText="true" TextColor="TextColor.Green" FontSize="lg" CssClass="mt-md mb-md" />
        <ResponsiveText Text="@Strings.Register_Redirect" CenterText="true" CssClass="mb-md" />
    }
    else
    {
        @if (_showRegistrationFailed)
        {
            <ResponsiveText Text="@_errorMessage" CenterText="true" TextColor="TextColor.Red" CssClass="mt-md mb-md" />
        }

        <ResponsiveForm Model="RegistrationUserModel"
                        OnValidSubmit="RegisterUser"
                        OnInvalidSubmit="RegisterUserFailed"
                        IsSubmitting="_registeringUser"
                        SubmitText="@Strings.Register_Register"
                        SubmittingText="@Strings.Register_Register"
                        ValidationDisplay="Enums.ValidationDisplay.Summary"
                        Columns="1"
                        CssClass="mb-xl">

            @if (_emailExists)
            {
                <ResponsiveText Text="@Strings.Registration_EmailExists" CenterText="true" TextColor="TextColor.Red" CssClass="mb-md" />
            }

            <ResponsiveFormField Id="register-email" Label="@Strings.Register_Email" For="@(() => RegistrationUserModel.Email)" Required="true">
                <ResponsiveTextBox Id="register-email"
                                    Name="email"
                                    AutoComplete="email"
                                    AriaDescribedBy="register-email-validation"
                                    Placeholder="@Strings.Register_Email"
                                    @bind-Value="RegistrationUserModel.Email" />
            </ResponsiveFormField>

            @if (_usernameExists)
            {
                <ResponsiveText Text="@Strings.Registration_UsernameExists" CenterText="true" TextColor="TextColor.Red" CssClass="mb-md" />
            }

            <ResponsiveFormField TValue="string" Id="register-username" Label="@Strings.Register_UserName" Required="true">
                <ResponsiveTextBox Id="register-username"
                                    Name="username"
                                    AutoComplete="username"
                                    Placeholder="@Strings.Register_UserName"
                                    @bind-Value="_userName" />
            </ResponsiveFormField>

            <ResponsiveFormField Id="register-password" Label="@Strings.Register_Password" For="@(() => RegistrationUserModel.Password)" Required="true">
                <ResponsivePassword Id="register-password"
                                    Name="password"
                                    AutoComplete="new-password"
                                    AriaDescribedBy="register-password-validation"
                                    Placeholder="@Strings.Register_Password"
                                    @bind-Value="RegistrationUserModel.Password" />
            </ResponsiveFormField>

            <ResponsiveFormField Id="register-confirm-password" Label="@Strings.Register_ConfirmPassword" For="@(() => RegistrationUserModel.ConfirmPassword)" Required="true">
                <ResponsivePassword Id="register-confirm-password"
                                    Name="confirm-password"
                                    AutoComplete="new-password"
                                    AriaDescribedBy="register-confirm-password-validation"
                                    Placeholder="@Strings.Register_ConfirmPassword"
                                    @bind-Value="RegistrationUserModel.ConfirmPassword" />
            </ResponsiveFormField>

        </ResponsiveForm>
    }

</Page>
