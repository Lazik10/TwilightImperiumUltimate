@page "/account/admin"
@using Microsoft.AspNetCore.Authorization
@using TwilightImperiumUltimate.Web.Components.Admin
@using TwilightImperiumUltimate.Web.Resources
@attribute [Authorize(Roles = "Admin")]

<PageTitle>@Strings.Page_Admin_PageTitle</PageTitle>

<Page>

    <ResponsiveHeading Level="1" Text="@Strings.Page_Admin" />

    <ResponsiveTabMenu AriaLabel="@Strings.Admin_TabsLabel" CssClass="mb-xl">
        <ResponsiveTab Id="admin-tab-roles"
                       ControlsId="admin-panel-roles"
                       IsActive="@(_activeTab == AdminTab.Roles)"
                       OnClick="@(() => SelectTab(AdminTab.Roles))">
            @Strings.Admin_RolesTab
        </ResponsiveTab>

        <div class="admin-tab-divider handel white shadow" aria-hidden="true">/</div>

        <ResponsiveTab Id="admin-tab-news"
                       ControlsId="admin-panel-news"
                       IsActive="@(_activeTab == AdminTab.News)"
                       OnClick="@(() => SelectTab(AdminTab.News))">
            @Strings.Admin_NewsTab
        </ResponsiveTab>

        <div class="admin-tab-divider handel white shadow" aria-hidden="true">/</div>

        <ResponsiveTab Id="admin-tab-websites"
                       ControlsId="admin-panel-websites"
                       IsActive="@(_activeTab == AdminTab.Websites)"
                       OnClick="@(() => SelectTab(AdminTab.Websites))">
            @Strings.Admin_WebsitesTab
        </ResponsiveTab>
    </ResponsiveTabMenu>
    
    <div id="admin-panel-roles" role="tabpanel" aria-labelledby="admin-tab-roles" hidden="@(_activeTab != AdminTab.Roles)">
        <RoleAssignment />
    </div>

    <div id="admin-panel-news" role="tabpanel" aria-labelledby="admin-tab-news" hidden="@(_activeTab != AdminTab.News)">
        <NewsArticleAdmin />
    </div>

    <div id="admin-panel-websites" role="tabpanel" aria-labelledby="admin-tab-websites" hidden="@(_activeTab != AdminTab.Websites)">
        <WebsiteAdmin />
    </div>

</Page>
