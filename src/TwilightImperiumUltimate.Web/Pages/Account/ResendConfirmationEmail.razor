@page "/account/resend-confirmation-email"
@using TwilightImperiumUltimate.Web.Resources

<PageTitle>@Strings.Page_ResendConfirmationEmail</PageTitle>

<Page>
        <ResponsiveHeading Level="1" Text="@Strings.Login_ConfirmationEmail" CenterText="true" CssClass="mb-xl" />

        @if (_confirmationEmailSend)
        {
            <ResponsiveText Text="@(_confirmationEmailSendSuccess ? Strings.Login_ConfirmationEmailSent : Strings.Login_ConfirmationEmailSentFail)"
                            CenterText="true"
                            TextColor="@(_confirmationEmailSendSuccess ? TextColor.Green : TextColor.Red)"
                            FontSize="lg"
                            CssClass="mt-md mb-md" />
        }

        <ResponsiveForm Model="ConfirmationEmailModel"
                        OnValidSubmit="ResendConfirmationEmailCode"
                        IsSubmitting="_disableButton"
                        SubmitText="@Strings.Login_ResendConfirmationEmail"
                        SubmittingText="@Strings.Login_ResendConfirmationEmail"
                        ValidationDisplay="Enums.ValidationDisplay.Summary"
                        Columns="1"
                        CssClass="mb-xl">

            <ResponsiveFormField TValue="string" Id="resend-confirmation-email" Label="@Strings.Login_Email" Required="true">
                <ResponsiveTextBox Id="resend-confirmation-email"
                                   Name="email"
                                   AutoComplete="email"
                                   Placeholder="@Strings.Login_Email"
                                   @bind-Value="ConfirmationEmailModel.Email" />
            </ResponsiveFormField>

        </ResponsiveForm>

</Page>


