@page "/account/confirmEmail"
@using TwilightImperiumUltimate.Web.Resources

<PageTitle>@Strings.ConfirmEmail_Title</PageTitle>

<Page>
    
    <ResponsiveHeading Level="1" Text="@Strings.ConfirmEmail_Title" CenterText="true" CssClass="mb-xl" />

    @if (!string.IsNullOrEmpty(Id))
    {
        <ResponsiveText Text="@UserIdConfirmingMessage()" CenterText="true" CssClass="mb-xl" />
    }

    @if (_confirmFinished)
    {
        <ResponsiveText Text="@(_confirmSuccess ? Strings.ConfirmEmail_UserEmailValidationSuccess : Strings.ConfirmEmail_UserEmailValidationFailed)"
                        CenterText="true"
                        FontSize="lg"
                        TextColor="@(_confirmSuccess ? TextColor.Green : TextColor.Red)"
                        CssClass="mt-md mb-md" />
    }

</Page>
