@page "/account/info"
@using TwilightImperiumUltimate.Web.Resources

<PageTitle>@Strings.Page_AccountInfo_PageTitle</PageTitle>

<Page>

    <ResponsiveHeading Level="1" Text="@Strings.User_AccountInfo" />

    <ResponsiveText CenterText="true" CssClass="mb-xl">
        <strong>@Strings.User_UserName:</strong> @User!.UserName
    </ResponsiveText>

    @if (_updateSend)
    {
        <ResponsiveText Text="@(_infoSaved ? Strings.UserInfo_UpdateSuccess : Strings.UserInfo_UpdateFailed)"
                        CenterText="true"
                        TextColor="@(_infoSaved ? TextColor.Green : TextColor.Red)"
                        FontSize="lg"
                        CssClass="mt-md mb-md" />
    }

    <ResponsiveForm Model="User"
                    OnValidSubmit="SaveInfo"
                    SubmitText="@Strings.AccountInfo_Save"
                    SubmittingText="@Strings.AccountInfo_Save"
                    ValidationDisplay="Enums.ValidationDisplay.Summary"
                    Columns="1"
                    CssClass="mb-xl">

        <ResponsiveFormField Id="info-first-name" Label="@Strings.User_FirstName" For="@(() => User!.FirstName)">
            <ResponsiveTextBox Id="info-first-name"
                                Name="first-name"
                                AutoComplete="given-name"
                                AriaDescribedBy="info-first-name-validation"
                                Placeholder="@Strings.User_FirstName"
                                @bind-Value="User!.FirstName" />
        </ResponsiveFormField>

        <ResponsiveFormField Id="info-last-name" Label="@Strings.User_LastName" For="@(() => User!.LastName)">
            <ResponsiveTextBox Id="info-last-name"
                                Name="last-name"
                                AutoComplete="family-name"
                                AriaDescribedBy="info-last-name-validation"
                                Placeholder="@Strings.User_LastName"
                                @bind-Value="User!.LastName" />
        </ResponsiveFormField>

        <ResponsiveFormField Id="info-email" Label="@Strings.User_Email" For="@(() => User!.Email)">
            <ResponsiveTextBox Id="info-email"
                                Name="email"
                                AutoComplete="email"
                                AriaDescribedBy="info-email-validation"
                                Placeholder="@Strings.User_Email"
                                @bind-Value="User!.Email" />
        </ResponsiveFormField>

        <ResponsiveNumericPicker Label="@Strings.User_Age" LabelPosition="Enums.LabelPosition.Column" Value="Age" OnIncrease="IncreaaeAge" OnDecrease="DecreaseAge" />

        <ResponsiveFormField Id="info-phone-number" Label="@Strings.User_PhoneNumber" For="@(() => User!.PhoneNumber)">
            <ResponsiveTextBox Id="info-phone-number"
                                Name="phone-number"
                                AutoComplete="tel"
                                AriaDescribedBy="info-phone-number-validation"
                                Placeholder="@Strings.User_PhoneNumber"
                                @bind-Value="User!.PhoneNumber" />
        </ResponsiveFormField>

        <ResponsiveFormField Id="info-user-info" Label="@Strings.User_UserInfo" For="@(() => User!.UserInfo)">
            <ResponsiveTextArea Id="info-user-info"
                                Name="user-info"
                                AriaDescribedBy="info-user-info-validation"
                                Placeholder="@Strings.User_UserInfo"
                                @bind-Value="User!.UserInfo" />
        </ResponsiveFormField>

        <ResponsiveFactionPicker Label="@Strings.User_FavoriteFaction" LabelPosition="Enums.LabelPosition.Column" Value="@FavoriteFaction" OnIncrease="ShowNextFaction" OnDecrease="ShowPreviousFaction" />

        <ResponsiveFormField Id="info-discord-id" Label="@Strings.User_DiscordId" For="@(() => User!.DiscordId)">
            <ResponsiveTextBox Id="info-discord-id"
                                Name="discord-id"
                                AriaDescribedBy="info-discord-id-validation"
                                Placeholder="@Strings.User_DiscordId"
                                @bind-Value="User!.DiscordId" />
        </ResponsiveFormField>

        <ResponsiveFormField Id="info-steam-id" Label="@Strings.User_SteamId" For="@(() => User!.SteamId)">
            <ResponsiveTextBox Id="info-steam-id"
                                Name="steam-id"
                                AriaDescribedBy="info-steam-id-validation"
                                Placeholder="@Strings.User_SteamId"
                                @bind-Value="User!.SteamId" />
        </ResponsiveFormField>

    </ResponsiveForm>

</Page>