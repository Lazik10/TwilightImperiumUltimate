@using TwilightImperiumUltimate.Web.Components.Shared.Bars
@using TwilightImperiumUltimate.Web.Models.SlicesArchive

<ResponsiveDataGrid TItem="SliceDraftModel"
                     Items="FilteredSliceDrafts"
                     ZebraStripes="true"
                     CssClass="mb-md"
                     SelectedItemChanged="RedirectToSelectedSliceDraft">

    <ResponsiveTableColumn Field="x => x.Name" Header="@Strings.SlicesArchive_SliceDraftName" Filter="ResponsiveFilterType.Text" HeaderAlign="center" />

    <ResponsiveTableColumn Field="x => x.Rating" Header="@Strings.SlicesArchive_SliceDraftRating" Sortable="true" HeaderAlign="center" Align="center">
        <CellTemplate Context="sliceDraft">
            <StarRating IsReadOnly="true" Rating="@sliceDraft.Rating" />
        </CellTemplate>
    </ResponsiveTableColumn>

    <ResponsiveTableColumn Field="x => x.EventName" Header="@Strings.SlicesArchive_SliceDraftEventName" Filter="ResponsiveFilterType.Text" HeaderAlign="center" />

    <ResponsiveTableColumn Field="x => x.UserName" Header="@Strings.SlicesArchive_SliceDraftAuthor" Filter="ResponsiveFilterType.Text" HeaderAlign="center" />

    <ResponsiveTableColumn Field="x => x.SliceCount" Header="@Strings.SlicesArchive_SliceDraftSliseCount" Filter="ResponsiveFilterType.Value" HeaderAlign="center" Align="center" />

</ResponsiveDataGrid>