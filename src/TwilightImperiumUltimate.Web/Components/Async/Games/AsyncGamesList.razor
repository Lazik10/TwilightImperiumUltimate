@using TwilightImperiumUltimate.Contracts.DTOs.Async
@using TwilightImperiumUltimate.Web.Components.Grid

<div class="async-games-list">
    <div class="async-games-layout">
            <ResponsiveRadzenDataGrid TItem="AsyncGameDto"
                                          Data="@_games"
                                          IsLoading="@(!_isLoaded)"
                                          AllowPaging="true"
                                          PageSize="50"
                                          AllowSorting="true"
                                          AllowFiltering="true"
                                          AllowAlternatingRows="true"
                                          RowClick="HandleGameRowClick"
                                          CssClass="async-games-table">
                    <Columns>
                        <RadzenDataGridColumn TItem="AsyncGameDto" Property="AsyncGameID" Title="@Strings.AsyncPlayer_GamesStatsGame">
                            <Template Context="game"><span style="@GetAsyncGameIdTextColor(game)">@game.AsyncGameID</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AsyncGameDto" Property="AsyncFunGameName" Title="@Strings.AsyncPlayer_GamesStatsFunGame" />
                        <RadzenDataGridColumn TItem="AsyncGameDto" Property="Scoreboard" Title="@Strings.AsyncPlayer_GamesStatsVp" />
                        <RadzenDataGridColumn TItem="AsyncGameDto" Property="PlayerCount" Title="@Strings.AsyncPlayer_GamesStatsPlayerCount" />
                        <RadzenDataGridColumn TItem="AsyncGameDto" Property="DurationHours" Title="Duration (hours)">
                            <Template Context="game">@GetDurationTime(game)</Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </ResponsiveRadzenDataGrid>
    </div>
</div>
