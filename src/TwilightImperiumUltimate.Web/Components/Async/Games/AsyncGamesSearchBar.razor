@using TwilightImperiumUltimate.Web.Components.Shared.Bars

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Width="Width">

        <Label Text="@SearhTitle" CenterText="true" />

        <ResponsiveAutocomplete Id="async-games-search" Data="@GameNames" ValueChanged="SelectGame" Value="@_selectedValue" />

        <ResponsiveButton ButtonText="Clear" OnClick="ClearSelectedGame" Width="30" />

    </ResponsiveContainer>

</ResponsiveContainer>
