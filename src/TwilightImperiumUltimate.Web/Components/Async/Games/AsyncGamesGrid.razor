@using TwilightImperiumUltimate.Web.Components.Shared.Bars

<StretchHeightContainer CssClass="background mt-2xl">

    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-sm mb-sm">
        <AsyncGamesSearchBar GameNames="@_gameNames" OnGameSelect="OnGameSelect" SearhTitle="@Strings.AsyncStats_SearchByGameIdTitle" Width="50" />
        <AsyncGamesSearchBar GameNames="@_gameFunNames" OnGameSelect="OnGameFunNameSelect" SearhTitle="@Strings.AsyncStats_SearchByGameFunNameTitle" Width="50" />
    </ResponsiveContainer>

    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Width="70">

            <ResponsiveEnumPicker TEnum="AsyncGameType" CurrentValue="@_asyncGameType" Label="@Strings.AsyncGameStats_GameType" Width="100" CurrentValueChanged="GameTypeChanged" />
            <ResponsiveEnumPicker TEnum="AsyncGameStatusFilter" CurrentValue="@_gameStatus" Label="Status" Width="100" ButtonWidth="50" CurrentValueChanged="GameStatusChanged" />

        </ResponsiveContainer>

    </ResponsiveContainer>

    <AsyncGamesList GameDates="@_gameDates"
        AsyncGameType="@_asyncGameType"
        StatusFilter="@_gameStatus"
        AsyncGameDiscordId="@_asyncGameDiscordId"
        AsyncGameFunName="@_asyncGameFunName" />

</StretchHeightContainer>
