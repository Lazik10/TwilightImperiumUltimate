@using TwilightImperiumUltimate.Web.Components.Grid
@using Microsoft.AspNetCore.Components.Forms

<div class="async-games-grid">
<StretchHeightContainer CssClass="mt-2xl">

    <div class="async-games-dropdown-filters">
        <ResponsiveDropDown TValue="string"
                            Id="async-game-id-filter"
                            Label="Game ID"
                            Data="@_gameNames"
                            Value="@_asyncGameDiscordId"
                            ValueChanged="OnGameSelect"
                            Placeholder="All game IDs"
                            AllowClear="true"
                            AllowFiltering="true"
                            AllowVirtualization="true"
                            Width="100" />

        <ResponsiveDropDown TValue="string"
                            Id="async-game-name-filter"
                            Label="Fun Name"
                            Data="@_gameFunNames"
                            Value="@_asyncGameFunName"
                            ValueChanged="OnGameFunNameSelect"
                            Placeholder="All fun names"
                            AllowClear="true"
                            AllowFiltering="true"
                            AllowVirtualization="true"
                            Width="100" />

        <ResponsiveDropDown TValue="AsyncGameType"
                            Id="async-game-type-filter"
                            Label="Games"
                            Data="@_gameTypes"
                            Value="@_asyncGameType"
                            ValueChanged="GameTypeChanged"
                            Width="100" />

        <ResponsiveDropDown TValue="AsyncGameStatusFilter"
                            Id="async-game-status-filter"
                            Label="Status"
                            Data="@_gameStatuses"
                            Value="@_gameStatus"
                            ValueChanged="GameStatusChanged"
                            Width="100" />

    </div>

    <div class="async-games-date-filters">
        <div class="async-games-date-filter">
            <ResponsiveLabel Text="Date from" CenterText="true" CssClass="async-games-date-label" />
            <ResponsiveDatePicker Id="async-games-date-from"
                                  Value="@_dateFrom"
                                  ValueChanged="OnDateFromChanged" />
        </div>
        <div class="async-games-date-filter">
            <ResponsiveLabel Text="Date to" CenterText="true" CssClass="async-games-date-label" />
            <ResponsiveDatePicker Id="async-games-date-to"
                                  Value="@_dateTo"
                                  ValueChanged="OnDateToChanged" />
        </div>
    </div>

    <AsyncGamesList GameDates="@_gameDates"
        AsyncGameType="@_asyncGameType"
        StatusFilter="@_gameStatus"
        AsyncGameDiscordId="@_asyncGameDiscordId"
        AsyncGameFunName="@_asyncGameFunName"
        DateFrom="@_dateFrom"
        DateTo="@_dateTo" />

</StretchHeightContainer>
</div>
