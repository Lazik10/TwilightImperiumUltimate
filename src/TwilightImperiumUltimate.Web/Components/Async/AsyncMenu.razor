<FlexColumnCenteredContainer>
    <div class="async-navbar">
        <FlexRowContainer Width="100" JustifyContent="Enums.JustifyContent.SpaceEvenly">
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(AsyncMenuItem.Statistics)">
                <ResponsiveLabel Text="@Strings.AsyncMenu_Statistics" CenterText="true" FontSize="base" />
            </TabNavItem>
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(AsyncMenuItem.Games)">
                <ResponsiveLabel Text="@Strings.AsyncMenu_Games" CenterText="true" FontSize="base" />
            </TabNavItem>
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(AsyncMenuItem.Players)">
                <ResponsiveLabel Text="@Strings.AsyncMenu_Players" CenterText="true" FontSize="base" />
            </TabNavItem>
        </FlexRowContainer>
    </div>
</FlexColumnCenteredContainer>
