<div class="async-navbar">
    <ResponsiveTabMenu AriaLabel="Async sections" CssClass="responsive-content-width mb-md faction-style">
        <ResponsiveTab Id="async-tab-statistics"
                       IsActive="@(SelectedItem == AsyncMenuItem.Statistics)"
                       OnClick="() => OnMenuItemClick.InvokeAsync(AsyncMenuItem.Statistics)">
            <ResponsiveLabel Text="@Strings.AsyncMenu_Statistics" CenterText="true" FontSize="lg" Style='@(SelectedItem == AsyncMenuItem.Statistics ? "color: var(--color-nav-hover) !important;" : null)' />
        </ResponsiveTab>
        <ResponsiveTabSeparator />
        <ResponsiveTab Id="async-tab-games"
                       IsActive="@(SelectedItem == AsyncMenuItem.Games)"
                       OnClick="() => OnMenuItemClick.InvokeAsync(AsyncMenuItem.Games)">
            <ResponsiveLabel Text="@Strings.AsyncMenu_Games" CenterText="true" FontSize="lg" Style='@(SelectedItem == AsyncMenuItem.Games ? "color: var(--color-nav-hover) !important;" : null)' />
        </ResponsiveTab>
        <ResponsiveTabSeparator />
        <ResponsiveTab Id="async-tab-players"
                       IsActive="@(SelectedItem == AsyncMenuItem.Players)"
                       OnClick="() => OnMenuItemClick.InvokeAsync(AsyncMenuItem.Players)">
            <ResponsiveLabel Text="@Strings.AsyncMenu_Players" CenterText="true" FontSize="lg" Style='@(SelectedItem == AsyncMenuItem.Players ? "color: var(--color-nav-hover) !important;" : null)' />
        </ResponsiveTab>
    </ResponsiveTabMenu>
</div>
