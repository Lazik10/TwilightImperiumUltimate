@using TwilightImperiumUltimate.Web.Components.Async.PlayerStats

<ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart" AlignItems="Enums.AlignItems.FlexStart" CssClass="background padding">

    @if (AsyncPlayerProfile is not null)
    {
        <TitleTexture Width="15" Texture="Enums.Texture.TopLeft" />

        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

            <AsyncPlayerNameLabel />

            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.Center" CssClass="mb-2xl">
                <ResponsiveEnumPicker 
                    TEnum="PlayerStatisticsType"
                    CurrentValue="@CurentStatisticsType"
                    CurrentValueChanged="@OnEnumChanged"
                    Width="35"
                    Label="@Strings.AsyncStats_Filter" />
                <Label Width="20" />
            </ResponsiveContainer>

            <CascadingValue Value="@CurentStatisticsType" Name="AsyncPlayerStatisticsType">

                <AsyncPlayerMainStats />

                <AsyncPlayerVictoryPointStats />

                <AsyncPlayerTurnStats />

                <AsyncPlayerCombatStats />

                <AsyncPlayerFactionStats />

                <AsyncPlayerOpponentsStats />

                <AsyncPlayerGamesStats />

            </CascadingValue>

            <div style="height: clamp(3.125rem, 3.125rem + 1vw, 6.25rem);"></div>

        </ResponsiveContainer>
    }
    else
    {
        <StretchHeightContainer />
    }
</ResponsiveContainer>
