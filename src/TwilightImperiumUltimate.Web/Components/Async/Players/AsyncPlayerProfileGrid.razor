@using TwilightImperiumUltimate.Web.Components.Async.PlayerStats

<ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart" AlignItems="Enums.AlignItems.FlexStart" Style="margin-top: calc(-1 * var(--space-2xl));">

    @if (AsyncPlayerProfile is not null)
    {
        <div class="async-player-profile-texture">
            <TitleTexture Width="100" Texture="Enums.Texture.TopLeft" />
        </div>

        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-2xl-non-mobile" Style="min-width: 0;">

            <AsyncPlayerNameLabel />

            <CascadingValue Value="@CurentStatisticsType" Name="AsyncPlayerStatisticsType">

                <div class="mb-2xl">
                    <AsyncPlayerMainStats>
                        <SummaryContent>
                            <div class="async-player-profile-filter mb-2xl">
                                <ResponsiveDropDown TValue="PlayerStatisticsType"
                                                    Id="async-player-profile-statistics-filter"
                                                    Data="@GetStatisticsTypeOptions()"
                                                    TextProperty="Value"
                                                    ValueProperty="Key"
                                                    Value="@CurentStatisticsType"
                                                    ValueChanged="@OnEnumChanged"
                                                    Label="@Strings.AsyncStats_Filter"
                                                    LabelPosition="LabelPosition.Column" />
                            </div>
                        </SummaryContent>
                    </AsyncPlayerMainStats>
                </div>

                <div class="mb-2xl" style="width: 100%;"><AsyncPlayerVictoryPointStats /></div>

                <div class="mb-2xl"><AsyncPlayerTurnStats /></div>

                <div class="mb-2xl"><AsyncPlayerCombatStats /></div>

                <div class="mb-2xl" style="width: 100%;"><AsyncPlayerFactionStats /></div>

                <div class="mb-2xl" style="width: 100%;"><AsyncPlayerOpponentsStats /></div>

                <div style="width: 100%;"><AsyncPlayerGamesStats /></div>

            </CascadingValue>

        </ResponsiveContainer>

        <div class="async-player-profile-texture-spacer"></div>
    }
    else
    {
        <StretchHeightContainer />
    }
    
</ResponsiveContainer>
