
<div class="mt-md mb-md">
    <AsyncPlayerSearchbar @ref="_searchbar" OnSearchUpdate="SearchPlayerGroup" />
</div>

<div class="mb-md">
    <AsyncPlayerAlphabet SelectedLetter="@_selectedLetter" OnLetterClick="SearchPlayerGroup" />
</div>

<StretchHeightContainer>

    @if (PlayerProfileNames is not null)
    {
        if (_playerGroups.Count == 0)
        {
            <Label Text="@Strings.AsyncPlayersList_NoPlayerMatch" FontSize="24" CenterText="true" TextColor="TextColor.White" CssClass="mt-3xl mb-3xl" />
        }
        else if (_filteredPlayerProfiles is not null && _filteredPlayerProfiles.Any())
        {
            <div class="players-grid">
                @foreach (var playerProfileName in _filteredPlayerProfiles)
                {
                    <ResponsiveButton Text="@playerProfileName.DiscordUsername" FontSize="14" OnClick="() => RedirectToPlayerProfile(playerProfileName.Id)" />
                }
            </div>
        }
        else
        {
            <Label Text="@Strings.AsyncPlayersList_NoPlayerMatch" FontSize="24" CenterText="true" TextColor="TextColor.White" CssClass="mt-3xl mb-3xl" />
        }
    }
    else
    {
        <Label Text="@Strings.AsyncPlayersList_NoPlayersFound" FontSize="24" CenterText="true" TextColor="TextColor.White" CssClass="mt-3xl mb-3xl" />
    }

</StretchHeightContainer>
