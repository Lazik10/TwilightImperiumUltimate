
    <StretchHeightContainer CssClass="mt-2xl">

    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column">

        <CascadingValue Value="_selectedGamesType" Name="Filter">

            <CascadingValue Value="@GetQueryLimit()" Name="Limit">

                <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" CssClass="async-statistics-content">

                    <StatisticsMenu SelectedMenuItem="@_selectedMenuItem"
                                    SelectedMenuItemChanged="UpdateSelectedMenuItem" />

                    <div class="async-statistics-filters @(IsLimitHiddenStatistics ? "async-statistics-filters-single" : string.Empty)">
                        <ResponsiveDropDown TValue="PlayerStatisticsType"
                                            Id="async-statistics-filter"
                                            Label="@Strings.AsyncStats_Filter"
                                            LabelPosition="LabelPosition.Column"
                                            Data="@_statisticsFilters"
                                            TextProperty="DisplayName"
                                            ValueProperty="Value"
                                            Value="@_selectedGamesType"
                                            ValueChanged="OnEnumChanged"
                                            Width="100" />

                        @if (!IsLimitHiddenStatistics)
                        {
                            <ResponsiveDropDown TValue="QueryLimit"
                                                Id="async-statistics-query-limit"
                                                Label="@Strings.AsyncStats_QueryLimit"
                                                LabelPosition="LabelPosition.Column"
                                                Data="@_queryLimitOptions"
                                                TextProperty="Value"
                                                ValueProperty="Key"
                                                Value="@_selectedQueryLimit"
                                                ValueChanged="@OnQueryLimitChanged"
                                                Width="100" />
                        }
                    </div>

                    @if (AsyncStatsProvider.SnapshotAge is { } snapshotAge)
                    {
                        <p class="async-statistics-snapshot-age" role="status">
                            Snapshot age: @FormatSnapshotAge(snapshotAge)
                        </p>
                    }

                    @if(_selectedMenuItem == AsyncStatisticsTypeMenuItem.General)
                    {
                        <GeneralStatistics />
                    }

                    @if (_selectedMenuItem == AsyncStatisticsTypeMenuItem.Games)
                    {
                        <GamesStatistics />
                    }

                    @if (_selectedMenuItem == AsyncStatisticsTypeMenuItem.Wins)
                    {
                        <WinsStatistics />
                    }

                    @if(_selectedMenuItem == AsyncStatisticsTypeMenuItem.Vp)
                    {
                        <VpStatistics />
                    }

                    @if (_selectedMenuItem == AsyncStatisticsTypeMenuItem.Eliminations)
                    {
                        <EliminationsStatistics />
                    }

                    @if(_selectedMenuItem == AsyncStatisticsTypeMenuItem.Turns)
                    {
                        <TurnsStatistics />
                    }

                    @if (_selectedMenuItem == AsyncStatisticsTypeMenuItem.Durations)
                    {
                        <DurationStatistics />
                    }

                    @if (_selectedMenuItem == AsyncStatisticsTypeMenuItem.Combat)
                    {
                        <CombatStatistics />
                    }

                    @if (_selectedMenuItem == AsyncStatisticsTypeMenuItem.Factions)
                    {
                        <FactionStatistics />
                    }

                    @if (_selectedMenuItem == AsyncStatisticsTypeMenuItem.Opponents)
                    {
                        <OpponentsStatistics />
                    }

                    @if (_selectedMenuItem == AsyncStatisticsTypeMenuItem.History)
                    {
                        <HistoryStatistics />
                    }

                </ResponsiveContainer>

            </CascadingValue>

        </CascadingValue>

    </ResponsiveContainer>

</StretchHeightContainer>



