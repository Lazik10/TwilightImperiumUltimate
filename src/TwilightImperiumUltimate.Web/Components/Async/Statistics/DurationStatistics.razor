@using TwilightImperiumUltimate.Web.Components.Statistics.DataGrid

<ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.Center">

    <DurationStatisticsTable Data="@DurationsStats.FastestGames"
                             GameClick="RedirectToGameDetails"
                             IsLoading="@(!_isDataLoaded || DurationsStats.FastestGames.Count == 0)" />
    <DurationStatisticsTable Data="@DurationsStats.LongestGames"
                             IsLongest="true"
                             GameClick="RedirectToGameDetails"
                             IsLoading="@(!_isDataLoaded || DurationsStats.LongestGames.Count == 0)" />

</ResponsiveContainer>
