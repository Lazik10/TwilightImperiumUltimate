@using TwilightImperiumUltimate.Web.Components.Statistics.Chart

<ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.Center">

    <GamesMostGamesChart Data="@GetMostGamesData()" Title="@Strings.AsyncGames_MostGamesTitle" SeriesTitle="@Strings.AsyncStats_Games" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || GameStats.MostGames.Count == 0)" />
    <GamesMostActiveGamesChart Data="@GetMostActiveGamesData()" Title="@Strings.AsyncGames_MostActiveGamesTitle" SeriesTitle="@Strings.AsyncStats_Games" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || GameStats.MostActiveGames.Count == 0)" />

</ResponsiveContainer>
