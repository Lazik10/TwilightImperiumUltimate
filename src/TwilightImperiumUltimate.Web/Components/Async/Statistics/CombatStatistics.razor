@using TwilightImperiumUltimate.Web.Components.Charts
@using TwilightImperiumUltimate.Web.Components.Statistics.Chart

<ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.Center">

    <CombatTotalHitsChart Data="@GetTotalHitsData()" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || CombatStats.TotalHitsPlayers.Count == 0)" />
    <CombatMaxHitsPerGameChart Data="@GetMaxHitsPerGameData()" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || CombatStats.MaxHitsPerGamePlayers.Count == 0)" />
    <CombatAverageHitsChart Data="@GetMaxAverageHitsPerGameData()" FormatValue="@FormatHitsPrecision" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || CombatStats.MaxAverageHitsPerGamePlayers.Count == 0)" />
    <CombatBestHitsDeviationChart Data="@GetBestHitsDeviationData()" FormatValue="@FormatHitsDeviation" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || CombatStats.BestHitsDeviationPlayers.Count == 0)" />
    <CombatWorstHitsDeviationChart Data="@GetWorstHitsDeviationData()" FormatValue="@FormatHitsDeviation" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || CombatStats.WorstHitsDeviationPlayers.Count == 0)" />

</ResponsiveContainer>
