@using TwilightImperiumUltimate.Web.Components.Charts
@using TwilightImperiumUltimate.Web.Components.Statistics.DataGrid
@using TwilightImperiumUltimate.Web.Components.Statistics.Chart

<ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.Center">

    <GeneralGameStatisticsTable Title="@Strings.AsyncGames_GamesStatsTitle"
                                Games="@GeneralStats.Games"
                                Active="@GeneralStats.Active"
                                Cancelled="@GeneralStats.Cancelled"
                                Finished="@GeneralStats.Finished"
                                Eliminations="@GeneralStats.Eliminations"
                                IsLoading="@(!_isDataLoaded)" />

    <GeneralPlayerStatisticsTable Title="@Strings.AsyncGames_PlayersStatsTitle"
                                  Players="@GeneralStats.Players"
                                  ActivePlayers="@GeneralStats.ActivePlayers"
                                  InactivePlayers="@GeneralStats.InactivePlayers"
                                  InactiveLessThanThreeMonths="@GeneralStats.InactiveLessThanThreeMonths"
                                  InactiveMoreThanThreeMonths="@GeneralStats.InactiveMoreThanThreeMonths"
                                  IsLoading="@(!_isDataLoaded)" />

    <RankingBarChart Title="@Strings.AsyncGames_PlayersByAverageTimerDistributionTitle"
                     Subtitle="@Strings.AsyncGames_MinTurns100"
                     Data="@GetTimerDistributionData()"
                     CategoryTitle="@Strings.AsyncStats_TimerCategory"
                    ValueTitle="@Strings.AsyncStats_Players"
                     SeriesTitle="@Strings.AsyncStats_Players"
                     BarColors="@GetTimerBarColors()"
                     IsLoading="@(!_isDataLoaded)" />

    <GeneralVpDistributionChart Data="@GetVpDistributionData()" IsLoading="@(!_isDataLoaded)" />

    <GeneralPlayerCountDistributionChart Data="@GetPlayerCountDistributionData()" IsLoading="@(!_isDataLoaded)" />

    <GeneralAverageTurnEndDistributionChart Data="@GetAverageTurnEndDistributionData()" IsLoading="@(!_isDataLoaded)" />

</ResponsiveContainer>
