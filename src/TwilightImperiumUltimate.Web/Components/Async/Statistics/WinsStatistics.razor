@using TwilightImperiumUltimate.Web.Components.Charts
@using TwilightImperiumUltimate.Web.Components.Statistics.Chart

<ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.Center">

    <WinsDeviationChart Data="@GetWinsDeviationData()" FormatValue="@FormatPercentage" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || WinsStats.AsyncWinsDeviationPlayers.Count == 0)" />
    <WinsPercentageChart Data="@GetWinPercentageData()" FormatValue="@FormatPercentage" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || WinsStats.AsyncWinsPercentagePlayers.Count == 0)" />
    <WinsMostWinsChart Data="@GetWinsData()" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || WinsStats.AsyncWinsPlayers.Count == 0)" />

</ResponsiveContainer>
