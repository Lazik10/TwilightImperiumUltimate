@using TwilightImperiumUltimate.Web.Components.Charts
@using TwilightImperiumUltimate.Web.Components.Statistics.Chart

<ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.Center">

    <TurnsFastestPlayersChart Data="@GetFastestPlayersData()" FormatValue="@(value => GetAverageTurn((long)value))" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || TurnsStats.AsyncFastestPlayers.Count == 0)" />
    <TurnsMostTurnsChart Data="@GetMostTurnsData()" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || TurnsStats.AsyncMostTurnsPlayers.Count == 0)" />

</ResponsiveContainer>

