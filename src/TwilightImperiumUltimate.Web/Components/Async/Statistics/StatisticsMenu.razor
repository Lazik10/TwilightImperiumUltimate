@using TwilightImperiumUltimate.Web.Helpers.Enums

<ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" Width="@Width">

    <Label Text="@Strings.AsyncStatisticsTypeMenuItem_CategoryTitle" TextColor="TextColor.Yellow" FontSize="24" CenterText="true" />

    @if (_menuItems.Count > 0)
    {
        @foreach (var menuItem in _menuItems)
        {
            <TextButton Text="@menuItem.GetDisplayName()" FontSize="14" Style="@GetMenuItemColor(menuItem)" OnClick="() => SelectedItemItem(menuItem)" CssClass="mt-xs mb-xs" />
        }
    }

</ResponsiveContainer>
