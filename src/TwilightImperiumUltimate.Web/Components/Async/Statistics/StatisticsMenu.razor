@using TwilightImperiumUltimate.Web.Helpers.Enums

<nav class="async-statistics-menu" aria-label="@Strings.AsyncStatisticsTypeMenuItem_CategoryTitle">
    <Label Text="@Strings.AsyncStatisticsTypeMenuItem_CategoryTitle" TextColor="TextColor.Yellow" FontSize="24" CenterText="true" />

    @if (_menuItems.Count > 0)
    {
        @for (var index = 0; index < _menuItems.Count; index++)
        {
            var menuItem = _menuItems[index];
            <TabNavItem OnClick="() => SelectedItemItem(menuItem)">
                <ResponsiveLabel Text="@menuItem.GetDisplayName()" CenterText="true" FontSize="base" />
            </TabNavItem>
            @if (index < _menuItems.Count - 1)
            {
                <span class="async-statistics-menu-separator" aria-hidden="true">/</span>
            }
        }
    }

</nav>
