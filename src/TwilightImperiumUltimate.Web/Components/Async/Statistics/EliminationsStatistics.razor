@using TwilightImperiumUltimate.Web.Components.Charts
@using TwilightImperiumUltimate.Web.Components.Statistics.Chart

<ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.Center">

    <RankingBarChart Data="@GetEliminationsPercentageData()" Title="@Strings.AsyncGames_MostEliminationsPercentageTitle" Subtitle="@Strings.AsyncGames_MinGamesCount" SeriesTitle="@Strings.AsyncStats_EliminationsPercentage" ValueFormatter="@FormatPercentage" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || EliminationsStats.MostEliminationsPercentagePlayers.Count == 0)" />
    <RankingBarChart Data="@GetEliminationsData()" Title="@Strings.AsyncGames_MostEliminationsTitle" Subtitle="@Strings.AsyncGames_MinGamesCount" SeriesTitle="@Strings.AsyncStats_Eliminations" TagClick="OnPlayerClick" IsLoading="@(!_isDataLoaded || EliminationsStats.MostEliminationsPlayers.Count == 0)" />

</ResponsiveContainer>
