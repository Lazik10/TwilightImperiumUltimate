@using TwilightImperiumUltimate.Web.Helpers.Numbers

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="100">

    @if (AsyncPlayerProfile is not null)
    {
        <ResponsiveGridContainer Columns="2" TabletColumns="2" MobileColumns="1" CssClass="mb-2xl">
            <ResponsiveLabel Text="@GetWinratePercentage()" FontSize="xl" CenterText="true" TextColor="@MainStatsTextColor" />
            <ResponsiveLabel Text="@GetGamesFinished()" FontSize="xl" CenterText="true" TextColor="@MainStatsTextColor" />
        </ResponsiveGridContainer>

        <ResponsiveRadzenTable ZebraStripes="true" EqualColumns="true" CssClass="mb-xl statistics-row-handel" TableTitle="@Strings.GameStats_Title">
            <RadzenTableHeader>
                <RadzenTableHeaderRow>
                    <RadzenTableHeaderCell scope="col">@Strings.GameStats_Games</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.GameStats_Active</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.GameStats_Finished</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.GameStats_Wins</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.GameStats_Winrate</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.GameStats_Eliminations</RadzenTableHeaderCell>
                </RadzenTableHeaderRow>
            </RadzenTableHeader>
            <RadzenTableBody>
                @if (!AsyncPlayerProfile.Settings.ShowGames)
                {
                    <RadzenTableRow>
                        <RadzenTableCell colspan="6">
                            <ResponsiveLabel Text="@Strings.AsyncPlayer_Statistics_Private" CenterText="true" TextColor="TextColor.Red" />
                        </RadzenTableCell>
                    </RadzenTableRow>
                }
                else
                {
                    <RadzenTableRow>
                        <RadzenTableCell class="yellow">@GameStats.GamesCount.ToString()</RadzenTableCell>
                        <RadzenTableCell class="green">@GameStats.Active.ToString()</RadzenTableCell>
                        <RadzenTableCell class="red">@GameStats.Finished.ToString()</RadzenTableCell>
                        <RadzenTableCell class="green">@ShowWins()</RadzenTableCell>
                        <RadzenTableCell class="@(GetWinrateCssClass())">@ShowWinRate()</RadzenTableCell>
                        <RadzenTableCell class="red">@GameStats.Eliminations.ToString()</RadzenTableCell>
                    </RadzenTableRow>
                }
            </RadzenTableBody>
        </ResponsiveRadzenTable>
    }

</ResponsiveContainer>
