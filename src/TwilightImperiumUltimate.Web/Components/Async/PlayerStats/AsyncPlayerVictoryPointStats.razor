@using TwilightImperiumUltimate.Web.Helpers.Numbers

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="100">

    @if (AsyncPlayerProfile is not null)
    {
        <div class="async-player-vp-table-desktop">
            <ResponsiveRadzenTable ZebraStripes="true" EqualColumns="true" CssClass="statistics-row-handel" TableTitle="@Strings.VpStats_Title">
            <RadzenTableHeader>
                <RadzenTableHeaderRow>
                    <RadzenTableHeaderCell scope="col">@Strings.VpStats_VictoryPoints</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.VpStats_Games</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.VpStats_TotalVp</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">Max VP</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.VpStats_AverageVp</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.VpStats_VpPercentageOfTotal</RadzenTableHeaderCell>
                </RadzenTableHeaderRow>
            </RadzenTableHeader>
            <RadzenTableBody>
                @if (!AsyncPlayerProfile.Settings.ShowVpStats)
                {
                    <RadzenTableRow>
                        <RadzenTableCell colspan="6">
                            <ResponsiveLabel Text="@Strings.AsyncPlayer_Statistics_Private" CenterText="true" TextColor="TextColor.Red" />
                        </RadzenTableCell>
                    </RadzenTableRow>
                }
                else
                {
                    @foreach (var stats in VpStats.VpStatsByVpGame)
                    {
                        <RadzenTableRow>
                            <RadzenTableCell>@stats.VpGameCategory.ToString()</RadzenTableCell>
                            <RadzenTableCell class="yellow">@ShowGames(stats.Games)</RadzenTableCell>
                            @if (stats.Games == 0)
                            {
                                <RadzenTableCell colspan="4"></RadzenTableCell>
                            }
                            else
                            {
                                <RadzenTableCell class="yellow">@stats.TotalVp.ToString()</RadzenTableCell>
                                <RadzenTableCell class="yellow">@stats.MaxPossibleVp.ToString()</RadzenTableCell>
                                <RadzenTableCell class="@(GetAverageVpCssClass(stats.AverageVpPerGame))">@stats.AverageVpPerGame.ToStringWithPrecision(2)</RadzenTableCell>
                                <RadzenTableCell class="@(GetAverageVpPercentageCssClass(stats.VpPercentageOfTotal))">
                                    <span class="async-player-vp-percentage-non-mobile">@stats.VpPercentageOfTotal.ToStringWithPrecisionAndPercentage(2)</span>
                                    <span class="async-player-vp-percentage-mobile">@stats.VpPercentageOfTotal.ToStringWithPrecisionAndPercentage(0)</span>
                                </RadzenTableCell>
                            }
                        </RadzenTableRow>
                    }

                    <RadzenTableRow class="async-player-vp-total-row">
                        <RadzenTableCell>Total</RadzenTableCell>
                        <RadzenTableCell class="yellow">@ShowGames(VpStats.VpStatsTotal.Games)</RadzenTableCell>
                        <RadzenTableCell class="yellow">@VpStats.VpStatsTotal.TotalVp.ToString()</RadzenTableCell>
                        <RadzenTableCell class="yellow">@VpStats.VpStatsTotal.MaxPossibleVp.ToString()</RadzenTableCell>
                        <RadzenTableCell class="@(GetAverageVpCssClass(VpStats.VpStatsTotal.AverageVpPerGame))">@VpStats.VpStatsTotal.AverageVpPerGame.ToStringWithPrecision(2)</RadzenTableCell>
                        <RadzenTableCell class="@(GetAverageVpPercentageCssClass(VpStats.VpStatsTotal.VpPercentageOfTotal))">
                            <span class="async-player-vp-percentage-non-mobile">@VpStats.VpStatsTotal.VpPercentageOfTotal.ToStringWithPrecisionAndPercentage(2)</span>
                            <span class="async-player-vp-percentage-mobile">@VpStats.VpStatsTotal.VpPercentageOfTotal.ToStringWithPrecisionAndPercentage(0)</span>
                        </RadzenTableCell>
                    </RadzenTableRow>
                }
            </RadzenTableBody>
            </ResponsiveRadzenTable>
        </div>

        <div class="async-player-vp-table-mobile">
            <ResponsiveRadzenTable ZebraStripes="true" CssClass="statistics-row-handel" TableTitle="@Strings.VpStats_Title">
                <RadzenTableHeader>
                    <RadzenTableHeaderRow>
                        <RadzenTableHeaderCell scope="col">@Strings.VpStats_VictoryPoints</RadzenTableHeaderCell>
                        @foreach (var stats in VpStats.VpStatsByVpGame)
                        {
                            <RadzenTableHeaderCell scope="col">@stats.VpGameCategory.ToString()</RadzenTableHeaderCell>
                        }
                        <RadzenTableHeaderCell scope="col">Total</RadzenTableHeaderCell>
                    </RadzenTableHeaderRow>
                </RadzenTableHeader>
                <RadzenTableBody>
                    @if (!AsyncPlayerProfile.Settings.ShowVpStats)
                    {
                        <RadzenTableRow>
                            <RadzenTableCell colspan="@(VpStats.VpStatsByVpGame.Count + 2)">
                                <ResponsiveLabel Text="@Strings.AsyncPlayer_Statistics_Private" CenterText="true" TextColor="TextColor.Red" />
                            </RadzenTableCell>
                        </RadzenTableRow>
                    }
                    else
                    {
                        <RadzenTableRow>
                            <RadzenTableCell>@Strings.VpStats_Games</RadzenTableCell>
                            @foreach (var stats in VpStats.VpStatsByVpGame)
                            {
                                <RadzenTableCell class="yellow">@ShowGames(stats.Games)</RadzenTableCell>
                            }
                            <RadzenTableCell class="yellow">@ShowGames(VpStats.VpStatsTotal.Games)</RadzenTableCell>
                        </RadzenTableRow>

                        <RadzenTableRow>
                            <RadzenTableCell>@Strings.VpStats_TotalVp</RadzenTableCell>
                            @foreach (var stats in VpStats.VpStatsByVpGame)
                            {
                                <RadzenTableCell class="yellow">@(stats.Games == 0 ? string.Empty : stats.TotalVp.ToString())</RadzenTableCell>
                            }
                            <RadzenTableCell class="yellow">@VpStats.VpStatsTotal.TotalVp.ToString()</RadzenTableCell>
                        </RadzenTableRow>

                        <RadzenTableRow>
                            <RadzenTableCell>Max VP</RadzenTableCell>
                            @foreach (var stats in VpStats.VpStatsByVpGame)
                            {
                                <RadzenTableCell class="yellow">@(stats.Games == 0 ? string.Empty : stats.MaxPossibleVp.ToString())</RadzenTableCell>
                            }
                            <RadzenTableCell class="yellow">@VpStats.VpStatsTotal.MaxPossibleVp.ToString()</RadzenTableCell>
                        </RadzenTableRow>

                        <RadzenTableRow>
                            <RadzenTableCell>@Strings.VpStats_AverageVp</RadzenTableCell>
                            @foreach (var stats in VpStats.VpStatsByVpGame)
                            {
                                <RadzenTableCell class="@(stats.Games == 0 ? string.Empty : GetAverageVpCssClass(stats.AverageVpPerGame))">@(stats.Games == 0 ? string.Empty : stats.AverageVpPerGame.ToStringWithPrecision(2))</RadzenTableCell>
                            }
                            <RadzenTableCell class="@(GetAverageVpCssClass(VpStats.VpStatsTotal.AverageVpPerGame))">@VpStats.VpStatsTotal.AverageVpPerGame.ToStringWithPrecision(2)</RadzenTableCell>
                        </RadzenTableRow>

                        <RadzenTableRow>
                            <RadzenTableCell>@Strings.VpStats_VpPercentageOfTotal</RadzenTableCell>
                            @foreach (var stats in VpStats.VpStatsByVpGame)
                            {
                                <RadzenTableCell class="@(stats.Games == 0 ? string.Empty : GetAverageVpPercentageCssClass(stats.VpPercentageOfTotal))">@(stats.Games == 0 ? string.Empty : stats.VpPercentageOfTotal.ToStringWithPrecisionAndPercentage(0))</RadzenTableCell>
                            }
                            <RadzenTableCell class="@(GetAverageVpPercentageCssClass(VpStats.VpStatsTotal.VpPercentageOfTotal))">@VpStats.VpStatsTotal.VpPercentageOfTotal.ToStringWithPrecisionAndPercentage(0)</RadzenTableCell>
                        </RadzenTableRow>
                    }
                </RadzenTableBody>
            </ResponsiveRadzenTable>
        </div>
    }

</ResponsiveContainer>
