
<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="100">

    @if (AsyncPlayerProfile is not null)
    {
        @if (!AsyncPlayerProfile.Settings.ShowOpponents)
        {
            <ResponsiveRadzenTable ZebraStripes="true" CssClass="statistics-row-handel" TableTitle="@Strings.OpponentStats_Opponents">
                <RadzenTableHeader>
                    <RadzenTableHeaderRow>
                        <RadzenTableHeaderCell scope="col">#</RadzenTableHeaderCell>
                        <RadzenTableHeaderCell scope="col">@Strings.OpponentStats_DiscordUsername</RadzenTableHeaderCell>
                        <RadzenTableHeaderCell scope="col">@Strings.OpponentStats_Games</RadzenTableHeaderCell>
                    </RadzenTableHeaderRow>
                </RadzenTableHeader>
                <RadzenTableBody>
                    <RadzenTableRow>
                        <RadzenTableCell colspan="3">
                            <ResponsiveLabel Text="@Strings.AsyncPlayer_Statistics_Private" CenterText="true" TextColor="TextColor.Red" />
                        </RadzenTableCell>
                    </RadzenTableRow>
                </RadzenTableBody>
            </ResponsiveRadzenTable>
        }
        else
        {
            var opponents = GetOpponentsByStatType().ToList();
            var midPoint = (int)Math.Ceiling(opponents.Count / 2.0);
            var opponentsFirstColumn = opponents.Take(midPoint).ToList();
            var opponentsSecondColumn = opponents.Skip(midPoint).ToList();
            var maxRows = Math.Max(opponentsFirstColumn.Count, opponentsSecondColumn.Count);

            <div class="async-opponents-desktop">
                <ResponsiveRadzenTable ZebraStripes="true" CssClass="statistics-row-handel" TableTitle="@Strings.OpponentStats_Opponents">
                    <RadzenTableHeader>
                        <RadzenTableHeaderRow>
                            <RadzenTableHeaderCell scope="col">#</RadzenTableHeaderCell>
                            <RadzenTableHeaderCell scope="col">@Strings.OpponentStats_DiscordUsername</RadzenTableHeaderCell>
                            <RadzenTableHeaderCell scope="col">@Strings.OpponentStats_Games</RadzenTableHeaderCell>
                            <RadzenTableHeaderCell scope="col">#</RadzenTableHeaderCell>
                            <RadzenTableHeaderCell scope="col">@Strings.OpponentStats_DiscordUsername</RadzenTableHeaderCell>
                            <RadzenTableHeaderCell scope="col">@Strings.OpponentStats_Games</RadzenTableHeaderCell>
                        </RadzenTableHeaderRow>
                    </RadzenTableHeader>
                    <RadzenTableBody>
                        @for (var i = 0; i < maxRows; i++)
                        {
                            var index = i;

                            <RadzenTableRow>
                                @if (index < opponentsFirstColumn.Count)
                                {
                                    var opponent = opponentsFirstColumn[index];
                                    <RadzenTableCell>@(index + 1).</RadzenTableCell>
                                    <RadzenTableCell>
                                        @if (opponent.Id == 0)
                                        {
                                            <span style="color: red;">@opponent.DiscordUserName</span>
                                        }
                                        else
                                        {
                                            <button type="button" class="clickable-cell" @onclick="() => ViewProfile(opponent.Id)"><ResponsiveLabel Text="@opponent.DiscordUserName" CenterText="true" FontSize="base" CssClass="clickable-cell-label" /></button>
                                        }
                                    </RadzenTableCell>
                                    <RadzenTableCell class="yellow">@opponent.Games</RadzenTableCell>
                                }
                                else
                                {
                                    <RadzenTableCell colspan="3"></RadzenTableCell>
                                }

                                @if (index < opponentsSecondColumn.Count)
                                {
                                    var opponent = opponentsSecondColumn[index];
                                    <RadzenTableCell>@(midPoint + index + 1).</RadzenTableCell>
                                    <RadzenTableCell>
                                        @if (opponent.Id == 0)
                                        {
                                            <span style="color: red;">@opponent.DiscordUserName</span>
                                        }
                                        else
                                        {
                                            <button type="button" class="clickable-cell" @onclick="() => ViewProfile(opponent.Id)"><ResponsiveLabel Text="@opponent.DiscordUserName" CenterText="true" FontSize="base" CssClass="clickable-cell-label" /></button>
                                        }
                                    </RadzenTableCell>
                                    <RadzenTableCell class="yellow">@opponent.Games</RadzenTableCell>
                                }
                                else
                                {
                                    <RadzenTableCell colspan="3"></RadzenTableCell>
                                }
                            </RadzenTableRow>
                        }
                    </RadzenTableBody>
                </ResponsiveRadzenTable>
            </div>

            <div class="async-opponents-mobile">
                <ResponsiveRadzenTable ZebraStripes="true" CssClass="statistics-row-handel" TableTitle="@Strings.OpponentStats_Opponents">
                    <RadzenTableHeader>
                        <RadzenTableHeaderRow>
                            <RadzenTableHeaderCell scope="col">#</RadzenTableHeaderCell>
                            <RadzenTableHeaderCell scope="col">@Strings.OpponentStats_DiscordUsername</RadzenTableHeaderCell>
                            <RadzenTableHeaderCell scope="col">@Strings.OpponentStats_Games</RadzenTableHeaderCell>
                        </RadzenTableHeaderRow>
                    </RadzenTableHeader>
                    <RadzenTableBody>
                        @for (var i = 0; i < opponents.Count; i++)
                        {
                            var index = i;
                            var opponent = opponents[index];

                            <RadzenTableRow>
                                <RadzenTableCell>@(index + 1).</RadzenTableCell>
                                <RadzenTableCell>
                                    @if (opponent.Id == 0)
                                    {
                                        <span style="color: red;">@opponent.DiscordUserName</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="clickable-cell" @onclick="() => ViewProfile(opponent.Id)"><ResponsiveLabel Text="@opponent.DiscordUserName" CenterText="true" FontSize="base" CssClass="clickable-cell-label" /></button>
                                    }
                                </RadzenTableCell>
                                <RadzenTableCell class="yellow">@opponent.Games</RadzenTableCell>
                            </RadzenTableRow>
                        }
                    </RadzenTableBody>
                </ResponsiveRadzenTable>
            </div>
        }
    }

</ResponsiveContainer>

