@using TwilightImperiumUltimate.Contracts.DTOs.Async.PlayerStats.FactionStats
@using TwilightImperiumUltimate.Web.Components.Charts
@using TwilightImperiumUltimate.Web.Helpers.Numbers

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="100">

    @if (AsyncPlayerProfile is not null && FactionsForDisplay is not null && FactionsForDisplay.Count > 0)
    {
        <div class="async-player-faction-filter">
            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
            <ResponsiveDropDown TValue="FactionStatisticsFilter"
                        Id="async-player-faction-stats-filter"
                        Data="@GetFactionFilterOptions()"
                        TextProperty="Value"
                        ValueProperty="Key"
                        Value="@_selectedFactionStatisticsFilter"
                        ValueChanged="OnFactionStatisticsFilterChanged"
                        Label="@RemoveTrailingColon(Strings.FactionStats_Factions)"
                        LabelPosition="LabelPosition.Column"
                        Width="40" />
            </ResponsiveContainer>
        </div>

        <div class="async-player-faction-filter">
            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
            <ResponsiveDropDown TValue="FactionStatisticsVpFilter"
                        Id="async-player-faction-stats-vp-filter"
                        Data="@GetFactionVpFilterOptions()"
                        TextProperty="Value"
                        ValueProperty="Key"
                        Value="@_selectedFactionVpStatisticsFilter"
                        ValueChanged="OnFactionStatisticsVpFilterChanged"
                        Label="@RemoveTrailingColon(Strings.FactionStats_VpCount)"
                        LabelPosition="LabelPosition.Column"
                        Width="40" />
            </ResponsiveContainer>
        </div>

        <div class="async-player-faction-filter">
            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
            <ResponsiveDropDown TValue="FactionStatisticsSubstatsFilter"
                        Id="async-player-faction-stats-substats-filter"
                        Data="@GetFactionSubstatsFilterOptions()"
                        TextProperty="Value"
                        ValueProperty="Key"
                        Value="@_selectedFactionStatisticsSubstatsFilter"
                        ValueChanged="OnFactionStatisticsSubstatsFilterChanged"
                        Label="@RemoveTrailingColon(Strings.FactionStats_Statistics)"
                        LabelPosition="LabelPosition.Column"
                        Width="40" />
            </ResponsiveContainer>
        </div>

        @if (!AsyncPlayerProfile.Settings.ShowFactionStats)
        {
            <ResponsiveLabel Text="@Strings.AsyncPlayer_Statistics_Private" CenterText="true" TextColor="TextColor.Red" CssClass="mt-md mb-2xl" />
        }
        else if (_selectedFactionStatisticsSubstatsFilter == FactionStatisticsSubstatsFilter.All)
        {
            <div class="async-player-faction-grid">
                <ResponsiveRadzenDataGrid TItem="AsyncPlayerFactionStatsDto"
                                          Data="@FactionsForDisplay"
                                          AllowPaging="false"
                                          AllowSorting="true"
                                          AllowAlternatingRows="true"
                                          CssClass="faction-overview-grid">
                    <HeaderTemplate>
                        <ResponsiveHeading Level="2" Text="@RemoveTrailingColon(Strings.FactionStats_Factions)" FontSize="lg" CenterText="true" CssClass="mb-0" />
                    </HeaderTemplate>
                    <Columns>
                        <RadzenDataGridColumn TItem="AsyncPlayerFactionStatsDto" Title="@Strings.FactionStats_Faction" Sortable="true">
                            <Template Context="faction">
                                <div style="display:flex; align-items:center; gap:0.5rem;">
                                    <AsyncFactionIconImg FactionName="@faction.FactionName" Height="20" />
                                    <span>@faction.FactionName.GetFactionUIText(FactionResourceType.Title)</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AsyncPlayerFactionStatsDto" Title="@Strings.FactionStats_Games" Sortable="true">
                            <Template Context="faction"><span style="color: @(TextColor.Yellow.ConvertToString());">@GetCorrectFactionStatsByVp(faction).Games</span></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AsyncPlayerFactionStatsDto" Title="@Strings.FactionStats_Wins" Sortable="true">
                            <Template Context="faction">
                                @if (GetCorrectFactionStatsByVp(faction).Games == 0)
                                {
                                    @string.Empty
                                }
                                else if (!IsWinrateEnabled())
                                {
                                    @Strings.AsyncPlayer_HiddenStat
                                }
                                else
                                {
                                    <span style="color: @(GetWinsColor(GetCorrectFactionStatsByVp(faction).Wins).ConvertToString());">@GetCorrectFactionStatsByVp(faction).Wins</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AsyncPlayerFactionStatsDto" Title="@Strings.FactionStats_WinPercentage" Sortable="true">
                            <Template Context="faction">
                                @if (GetCorrectFactionStatsByVp(faction).Games == 0)
                                {
                                    @string.Empty
                                }
                                else if (!IsWinrateEnabled())
                                {
                                    @Strings.AsyncPlayer_HiddenStat
                                }
                                else
                                {
                                    <span style="color: @(GetCorrectFactionStatsByVp(faction).WinRate.GetWinrateColor().ConvertToString());">@FormatPercentageValue(GetCorrectFactionStatsByVp(faction).WinRate)</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AsyncPlayerFactionStatsDto" Title="@Strings.FactionStats_Eliminations" Sortable="true">
                            <Template Context="faction">
                                @if (GetCorrectFactionStatsByVp(faction).Games == 0)
                                {
                                    @string.Empty
                                }
                                else
                                {
                                    <span style="color: @(TextColor.Red.ConvertToString());">@GetCorrectFactionStatsByVp(faction).Eliminations</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AsyncPlayerFactionStatsDto" Title="@Strings.FactionStats_AverageVp" Sortable="true">
                            <Template Context="faction">
                                @if (GetCorrectFactionStatsByVp(faction).Games == 0)
                                {
                                    @string.Empty
                                }
                                else
                                {
                                    <span style="color: @(((double)GetCorrectFactionStatsByVp(faction).AverageVp).GetAverageVpColor().ConvertToString());">@GetCorrectFactionStatsByVp(faction).AverageVp.ToStringWithPrecision(2)</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AsyncPlayerFactionStatsDto" Title="@Strings.FactionStats_AverageVpPercentage" Sortable="true">
                            <Template Context="faction">@(GetCorrectFactionStatsByVp(faction).Games == 0 ? string.Empty : FormatPercentageValue(GetCorrectFactionStatsByVp(faction).AverageVpPercentage))</Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </ResponsiveRadzenDataGrid>
            </div>
        }
        else
        {
            @switch (_selectedFactionStatisticsSubstatsFilter)
            {
                case FactionStatisticsSubstatsFilter.Games:
                    <RankingBarChart Data="@GetGamesData()"
                                    Title="@Strings.FactionStats_Games"
                                    XAxisLabel="@Strings.FactionStats_Games"
                                    SeriesTitle="@Strings.FactionStats_Games" />
                    break;
                case FactionStatisticsSubstatsFilter.Wins:
                    <RankingBarChart Data="@GetWinsData()"
                                    Title="@Strings.FactionStats_Wins"
                                    XAxisLabel="@Strings.FactionStats_Wins"
                                    SeriesTitle="@Strings.FactionStats_Wins" />
                    break;
                case FactionStatisticsSubstatsFilter.WinPercentage:
                    <RankingBarChart Data="@GetWinPercentageData()"
                                    Title="@Strings.FactionStats_WinPercentage"
                                    XAxisLabel="@Strings.FactionStats_WinPercentage"
                                    SeriesTitle="@Strings.FactionStats_WinPercentage"
                                    ValueFormatter="FormatPercentageValue" />
                    break;
                case FactionStatisticsSubstatsFilter.Eliminations:
                    <RankingBarChart Data="@GetEliminationsData()"
                                    Title="@Strings.FactionStats_Eliminations"
                                    XAxisLabel="@Strings.FactionStats_Eliminations"
                                    SeriesTitle="@Strings.FactionStats_Eliminations" />
                    break;
                case FactionStatisticsSubstatsFilter.MinVp:
                    <RankingBarChart Data="@GetMinVpData()"
                                    Title="@Strings.FactionStats_MinVp"
                                    XAxisLabel="@Strings.FactionStats_MinVp"
                                    SeriesTitle="@Strings.FactionStats_MinVp" />
                    break;
                case FactionStatisticsSubstatsFilter.AverageVp:
                    <RankingBarChart Data="@GetAverageVpData()"
                                    Title="@Strings.FactionStats_AverageVp"
                                    XAxisLabel="@Strings.FactionStats_AverageVp"
                                    SeriesTitle="@Strings.FactionStats_AverageVp"
                                    ValueFormatter="FormatAverageVpValue" />
                    break;
                case FactionStatisticsSubstatsFilter.MaxVp:
                    <RankingBarChart Data="@GetMaxVpData()"
                                    Title="@Strings.FactionStats_MaxVp"
                                    XAxisLabel="@Strings.FactionStats_MaxVp"
                                    SeriesTitle="@Strings.FactionStats_MaxVp" />
                    break;
                case FactionStatisticsSubstatsFilter.AverageVpPercentage:
                    <RankingBarChart Data="@GetAverageVpPercentageData()"
                                    Title="@Strings.FactionStats_AverageVpPercentage"
                                    XAxisLabel="@Strings.FactionStats_AverageVpPercentage"
                                    SeriesTitle="@Strings.FactionStats_AverageVpPercentage"
                                    ValueFormatter="FormatPercentageValue" />
                    break;
                default:
                    <ResponsiveLabel Text="@Strings.Loading" CenterText="true" />
                    break;
            }
        }
    }

</ResponsiveContainer>
