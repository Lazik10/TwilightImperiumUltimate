<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="100">

    @if (AsyncPlayerProfile is not null)
    {
        <ResponsiveRadzenTable ZebraStripes="true" EqualColumns="true" CssClass="mb-xl statistics-row-handel" TableTitle="Turn stats">
            <RadzenTableHeader>
                <RadzenTableHeaderRow>
                    <RadzenTableHeaderCell scope="col">@Strings.TurnStats_NumberOfTurns</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.TurnStats_AverageTurnTime</RadzenTableHeaderCell>
                </RadzenTableHeaderRow>
            </RadzenTableHeader>
            <RadzenTableBody>
                @if (!AsyncPlayerProfile.Settings.ShowTurnStats)
                {
                    <RadzenTableRow>
                        <RadzenTableCell colspan="2">
                            <ResponsiveLabel Text="@Strings.AsyncPlayer_Statistics_Private" CenterText="true" TextColor="TextColor.Red" />
                        </RadzenTableCell>
                    </RadzenTableRow>
                }
                else
                {
                    <RadzenTableRow>
                        <RadzenTableCell class="yellow">@TurnStats.TotalTurns.ToString()</RadzenTableCell>
                        <RadzenTableCell class="@(GetAverageTurnCssClass())">@GetAverageTurn()</RadzenTableCell>
                    </RadzenTableRow>
                }
            </RadzenTableBody>
        </ResponsiveRadzenTable>
    }

</ResponsiveContainer>
