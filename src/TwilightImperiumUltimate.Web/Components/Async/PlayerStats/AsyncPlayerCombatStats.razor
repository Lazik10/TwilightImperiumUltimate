@using TwilightImperiumUltimate.Web.Helpers.Numbers

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="100">

    @if (AsyncPlayerProfile is not null)
    {
        <div class="combat-stats-table-host">
            <ResponsiveRadzenTable ZebraStripes="true" EqualColumns="true" CssClass="statistics-row-handel combat-stats-table" TableTitle="@Strings.CombatStats_Title">
                <RadzenTableHeader>
                    <RadzenTableHeaderRow>
                        <RadzenTableHeaderCell scope="col"><span class="combat-stats-header-desktop">@Strings.CombatStats_ExpectedHits</span><span class="combat-stats-header-mobile">Expected</span></RadzenTableHeaderCell>
                        <RadzenTableHeaderCell scope="col"><span class="combat-stats-header-desktop">@Strings.CombatStats_ActualHits</span><span class="combat-stats-header-mobile">Actual</span></RadzenTableHeaderCell>
                        <RadzenTableHeaderCell scope="col"><span class="combat-stats-header-desktop">@Strings.CombatStats_HitsDeviation</span><span class="combat-stats-header-mobile">Deviation</span></RadzenTableHeaderCell>
                    </RadzenTableHeaderRow>
                </RadzenTableHeader>
                <RadzenTableBody>
                    @if (!AsyncPlayerProfile.Settings.ShowCombatStats)
                    {
                        <RadzenTableRow>
                            <RadzenTableCell colspan="3">
                                <ResponsiveLabel Text="@Strings.AsyncPlayer_Statistics_Private" CenterText="true" TextColor="TextColor.Red" />
                            </RadzenTableCell>
                        </RadzenTableRow>
                    }
                    else
                    {
                        <RadzenTableRow>
                            <RadzenTableCell class="yellow">@CombatStats.ExpectedHits.ToStringWithPrecision(2)</RadzenTableCell>
                            <RadzenTableCell class="yellow">@CombatStats.ActualHits.ToStringWithPrecision(0)</RadzenTableCell>
                            <RadzenTableCell class="@(GetDiceDeviationCssClass())">@GetHitDeviationText()</RadzenTableCell>
                        </RadzenTableRow>
                        <RadzenTableRow>
                            <RadzenTableHeaderCell scope="col"><span class="combat-stats-header-desktop">@Strings.CombatStats_MinHits</span><span class="combat-stats-header-mobile">Min</span></RadzenTableHeaderCell>
                            <RadzenTableHeaderCell scope="col"><span class="combat-stats-header-desktop">@Strings.CombatStats_AverageHits</span><span class="combat-stats-header-mobile">Avg</span></RadzenTableHeaderCell>
                            <RadzenTableHeaderCell scope="col"><span class="combat-stats-header-desktop">@Strings.CombatStats_MaxHits</span><span class="combat-stats-header-mobile">Max</span></RadzenTableHeaderCell>
                        </RadzenTableRow>
                        <RadzenTableRow>
                            <RadzenTableCell class="yellow">@CombatStats.MinHitsPerGame.ToStringWithPrecision(0)</RadzenTableCell>
                            <RadzenTableCell class="yellow">@CombatStats.AverageHitsPerGame.ToStringWithPrecision(0)</RadzenTableCell>
                            <RadzenTableCell class="yellow">@CombatStats.MaxHitsPerGame.ToStringWithPrecision(0)</RadzenTableCell>
                        </RadzenTableRow>
                    }
                </RadzenTableBody>
            </ResponsiveRadzenTable>
        </div>
    }

</ResponsiveContainer>
