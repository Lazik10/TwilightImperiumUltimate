
<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="100">

    @if (AsyncPlayerProfile is not null)
    {
        <div class="async-player-games-host">
        <ResponsiveRadzenTable ZebraStripes="true" CssClass="statistics-row-handel" TableTitle="@Strings.AsyncPlayer_GamesStatsTitle">
            <TableTitleActions>
                <ResponsiveCheckbox Label="@Strings.AsyncPlayer_GamesStatsExpandAll"
                                    IsChecked="@_allExpanded"
                                    IsCheckedChanged="OnExpandAllChanged"
                                    CssClass="async-player-games-expand-all-checkbox" />
            </TableTitleActions>
            <ChildContent>
            <RadzenTableHeader>
                <RadzenTableHeaderRow>
                    <RadzenTableHeaderCell scope="col">@Strings.AsyncPlayer_GamesStatsGame</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.AsyncPlayer_GamesStatsFunGame</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.AsyncPlayer_GamesStatsWin</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.AsyncPlayer_GamesStatsVp</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.AsyncPlayer_GamesStatsFaction</RadzenTableHeaderCell>
                    <RadzenTableHeaderCell scope="col">@Strings.AsyncPlayer_GamesStatsDuration</RadzenTableHeaderCell>
                </RadzenTableHeaderRow>
            </RadzenTableHeader>
            <RadzenTableBody>
                @if (!AsyncPlayerProfile.Settings.ShowGames)
                {
                    <RadzenTableRow>
                        <RadzenTableCell colspan="6">
                            <ResponsiveLabel Text="@Strings.AsyncPlayer_Statistics_Private" CenterText="true" TextColor="TextColor.Red" />
                        </RadzenTableCell>
                    </RadzenTableRow>
                }
                else if (!GroupedGames.Any())
                {
                    <RadzenTableRow>
                        <RadzenTableCell colspan="6">
                            <ResponsiveLabel Text="@Strings.AsyncPlayersList_NoPlayerMatch" CenterText="true" />
                        </RadzenTableCell>
                    </RadzenTableRow>
                }
                else
                {
                    @foreach (var year in GroupedGames)
                    {
                        var yearIsExpanded = IsYearExpanded(year.Year.Year);

                        <RadzenTableRow class="async-player-games-year-row" tabindex="0" role="button" aria-expanded="@(yearIsExpanded ? "true" : "false")" @onclick="() => ToggleYear(year.Year.Year)" @onkeydown="e => OnYearKeyDown(e, year.Year.Year)">
                            <RadzenTableCell colspan="6">@(yearIsExpanded ? "▾" : "▸") @year.Year.ToString("yyyy")</RadzenTableCell>
                        </RadzenTableRow>

                        @if (yearIsExpanded)
                        {
                            @foreach (var month in year.Months)
                            {
                                var monthIsExpanded = IsMonthExpanded(year.Year.Year, month.Month.Month);

                                <RadzenTableRow class="async-player-games-month-row" tabindex="0" role="button" aria-expanded="@(monthIsExpanded ? "true" : "false")" @onclick="() => ToggleMonth(year.Year.Year, month.Month.Month)" @onkeydown="e => OnMonthKeyDown(e, year.Year.Year, month.Month.Month)">
                                    <RadzenTableCell colspan="6">@(monthIsExpanded ? "▾" : "▸") @month.Month.ToString("MMMM")</RadzenTableCell>
                                </RadzenTableRow>

                                @if (monthIsExpanded)
                                {
                                    @foreach (var game in month.Games.OrderByDescending(x => x.StartDate))
                                    {
                                        <RadzenTableRow class="async-player-games-game-row" tabindex="0" role="button" @onclick="() => RedirectToGameDetails(game.AsyncGameID)" @onkeydown="e => OnGameKeyDown(e, game.AsyncGameID)">
                                            <RadzenTableCell>
                                                <span style="@GetAsyncGameIdTextColor(game)">@game.AsyncGameID</span>
                                            </RadzenTableCell>
                                            <RadzenTableCell class="async-player-games-fun-name-cell">
                                                <span title="@game.GameFunName">@GetDisplayGameFunName(game.GameFunName)</span>
                                            </RadzenTableCell>
                                            <RadzenTableCell class="async-player-games-win-cell">
                                                @if (ShowWins(game) && game.IsWinner)
                                                {
                                                    <span style="color: yellow;">W</span>
                                                }
                                            </RadzenTableCell>
                                            <RadzenTableCell class="@GetMobileVpCssClass(game)">@(ShowWins(game) ? $"{game.PlayerScore} / {game.Scoreboard}" : $"? / {game.Scoreboard}")</RadzenTableCell>
                                            <RadzenTableCell class="async-player-games-faction-cell">
                                                <span title="@(game.Faction.GetFactionUIText(FactionResourceType.Title))">
                                                    <AsyncFactionIconImg FactionName="@game.Faction" Height="24" />
                                                </span>
                                            </RadzenTableCell>
                                            <RadzenTableCell>@GetDurationTime(game)</RadzenTableCell>
                                        </RadzenTableRow>
                                    }
                                }
                            }
                        }
                    }
                }
            </RadzenTableBody>
            </ChildContent>
        </ResponsiveRadzenTable>
        </div>
    }

</ResponsiveContainer>
