@using TwilightImperiumUltimate.Web.Components.Grid

<section class="async-duration-section" style="width: 100%; max-width: 100%; min-width: 0; overflow: hidden;" aria-label="@(IsLongest ? "Longest games" : "Fastest games")">
    <ResponsiveRadzenTable ZebraStripes="true"
                           EqualColumns="false"
                           WidthDesktop="100%"
                           WidthTablet="100%"
                           WidthMobile="100%"
                           TableTitle="@TableTitle"
                           TableDescription="@TableDescription"
                           CssClass="duration-statistics-table mb-xl">
        <RadzenTableHeader>
            <RadzenTableHeaderRow>
                <RadzenTableHeaderCell scope="col">@Strings.AsyncStats_Game</RadzenTableHeaderCell>
                <RadzenTableHeaderCell scope="col">@Strings.AsyncStats_Duration</RadzenTableHeaderCell>
                <RadzenTableHeaderCell scope="col">@Strings.AsyncStats_FunGameName</RadzenTableHeaderCell>
                <RadzenTableHeaderCell scope="col">@Strings.AsyncStats_Players</RadzenTableHeaderCell>
                <RadzenTableHeaderCell scope="col">@Strings.AsyncStats_Vp</RadzenTableHeaderCell>
            </RadzenTableHeaderRow>
        </RadzenTableHeader>

        <RadzenTableBody>
            @if (IsLoading)
            {
                <RadzenTableRow>
                    <RadzenTableCell colspan="5">
                        <ResponsiveLabel Text="@Strings.Loading" CenterText="true" />
                    </RadzenTableCell>
                </RadzenTableRow>
            }
            else
            {
                @foreach (var game in Data)
                {
                    <tr class="rz-data-row" role="link" tabindex="0" @onclick="() => OnRowClick(game)" @onkeydown="eventArgs => OnRowKeyDown(eventArgs, game)">
                        <td>@game.Id</td>
                        <td class="text-align-center"><span class="@(IsLongest ? "red" : "green")">@GetDurationTime(game.Duration)</span></td>
                        <td title="@game.FunName">@GetFunGameName(game.FunName)</td>
                        <td class="text-align-center">@game.PlayerCount</td>
                        <td class="text-align-center">@game.Scoreboard</td>
                    </tr>
                }
            }
        </RadzenTableBody>
    </ResponsiveRadzenTable>
</section>
