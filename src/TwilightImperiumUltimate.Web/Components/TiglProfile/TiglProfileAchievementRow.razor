@using TwilightImperiumUltimate.Web.Helpers.Tigl
@using TwilightImperiumUltimate.Web.Helpers.Enums

<div class="achievement-row handel shadow @RarityClass @(IsEarned ? string.Empty : "achievement-unearned")">
    <div class="achievement-info">
        <ResponsiveLabel Text="@TiglAchievementDescriptions.GetDisplayName(Achievement.AchievementName)" FontSize="base" TextColor="EffectiveTextColor" CssClass="achievement-name-label" />
        <ResponsiveLabel Text="@TiglAchievementDescriptions.GetDescription(Achievement.AchievementName)" FontSize="sm" CssClass="achievement-desc-label" />
        @if (Achievement.Faction != TiglFactionName.None)
        {
            <ResponsiveLabel Text="@Achievement.Faction.GetDisplayName()" FontSize="sm" CssClass="achievement-faction-label" />
        }
    </div>
    <div class="achievement-meta">
        <ResponsiveLabel Text="@($"{RarityPercent:F1}% of players")" FontSize="sm" Truncate="false" />
        <ResponsiveLabel Text="@(IsEarned ? FormatDate(Achievement.AchievedAt) : string.Empty)" FontSize="sm" Truncate="false" />
    </div>
</div>
