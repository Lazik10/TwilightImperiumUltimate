<section class="section-container mb-xl"><ResponsiveRadzenTable ZebraStripes="true" CssClass="game-history-table" TableTitle="Game history"><RadzenTableHeader><RadzenTableHeaderRow><RadzenTableHeaderCell scope="col">Game</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Score</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Win</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Faction</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Duration</RadzenTableHeaderCell></RadzenTableHeaderRow></RadzenTableHeader><RadzenTableBody>@if(!Games.Any()){<RadzenTableRow><RadzenTableCell colspan="5"><ResponsiveLabel Text="No games played." CenterText="true" /></RadzenTableCell></RadzenTableRow>}@foreach(var game in Games){<RadzenTableRow tabindex="0" role="link" @onclick="() => OnGameSelected.InvokeAsync(game.MatchReportId)" @onkeydown="@(e => e.Key == "Enter" ? OnGameSelected.InvokeAsync(game.MatchReportId) : Task.CompletedTask)"><RadzenTableCell><span class="tigl-link">@game.GameId</span></RadzenTableCell><RadzenTableCell><span style="color: @(game.IsWinner ? "yellow" : "var(--color-white)");">@game.Score / @game.MaxScore</span></RadzenTableCell><RadzenTableCell><span style="color: yellow;">@(game.IsWinner ? "W" : "")</span></RadzenTableCell><RadzenTableCell><TiglFactionIconImg FactionName="@game.Faction" Height="20" /></RadzenTableCell><RadzenTableCell>@GetDuration(game)</RadzenTableCell></RadzenTableRow>}</RadzenTableBody></ResponsiveRadzenTable></section>
