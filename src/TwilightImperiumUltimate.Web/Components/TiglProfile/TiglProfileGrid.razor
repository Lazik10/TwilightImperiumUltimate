@if (IsLoading)
{
    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart" AlignItems="Enums.AlignItems.FlexStart" CssClass="tigl-profile-frame" Style="margin-top: calc(-1 * var(--space-2xl)); padding: 0;" Name="tigl-profile-frame">
        <div class="tigl-profile-left-texture" aria-hidden="true">
            <TitleTexture Width="100" Texture="Enums.Texture.TopLeft" />
        </div>
        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-2xl-non-mobile" Style="min-width: 0;" Name="tigl-profile-content-column">
            <div class="tigl-profile-content-fill" data-container-name="tigl-profile-content-fill">
                <TiglProfileHeader Profile="@Profile" />
                <TiglProfileLoadingTable Title="Overview" ColumnCount="3" />
                <TiglProfileLoadingTable Title="General" ColumnCount="12" />
                <TiglProfileLoadingTable Title="Ranks" ColumnCount="3" />
                <TiglProfileLoadingTable Title="Prestige Ranks" ColumnCount="4" />
                <TiglProfileLoadingTable Title="Factions" ColumnCount="5" />
                <TiglProfileLoadingTable Title="Seasons" ColumnCount="7" />
                <TiglProfileLoadingTable Title="Games" ColumnCount="6" />
                <TiglProfileLoadingTable Title="Top opponents" ColumnCount="3" />
                <TiglProfileLoadingTable Title="Achievements" ColumnCount="1" />
            </div>
        </ResponsiveContainer>
        <div class="tigl-profile-right-texture-spacer" data-container-name="tigl-profile-right-texture-spacer"></div>
    </ResponsiveContainer>
}
else
{
<ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart" AlignItems="Enums.AlignItems.FlexStart" CssClass="tigl-profile-frame" Style="margin-top: calc(-1 * var(--space-2xl)); padding: 0;" Name="tigl-profile-frame">
    @if (Profile is not null && !string.IsNullOrEmpty(Profile.TiglUserName))
    {
        <div class="tigl-profile-left-texture" aria-hidden="true">
            <TitleTexture Width="100" Texture="Enums.Texture.TopLeft" />
        </div>
        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-2xl-non-mobile" Style="min-width: 0;" Name="tigl-profile-content-column">
            <div class="tigl-profile-content-fill" data-container-name="tigl-profile-content-fill">
            <TiglProfileHeader Profile="@Profile" />
            <TiglProfileRankSummary Profile="@Profile" />
            <div class="tigl-profile-league-picker mt-md mb-xl">
                <ResponsiveDropDown TValue="TiglProfileCategory" Id="tigl-profile-league" Data="@Options" TextProperty="Value" ValueProperty="Key" Value="@CurrentCategory" ValueChanged="OnCategoryChanged" Label="Ladder" LabelPosition="LabelPosition.Column" Width="40" />
            </div>
            @if (SelectedLeagueProfile is not null)
            {
                <TiglLeagueSummaryCard Profile="@SelectedLeagueProfile" Prestige="@SelectedPrestige" Games="@FilteredGameHistory" />
                <TiglRatingProgression @key="CurrentCategory" Profile="@SelectedLeagueProfile" />
                <TiglRankHistoryTable Ranks="@FilteredRankHistory" />
                <TiglPrestigeHistoryTable Profile="@Profile" Prestiges="@FilteredPrestigeRanks" PathProvider="@PathProvider" />
            }
            <TiglFactionStatisticsTable Stats="@FilteredFactionStats"
                                        ShowFilters="@(SelectedLeague == TiglLeague.Fractured)"
                                        AreFiltersVisible="@_areFactionFiltersVisible"
                                        FilterButtonLabel="@FilterButtonLabel"
                                        FilterIconPath="@FilterIconPath"
                                        OnToggleFilters="ToggleFactionFilters">
                <FilterContent>
                    <ResponsiveDropDown TValue="FactionStatisticsFilter" Id="tigl-profile-faction-filter" Data="@FactionFilterOptions" TextProperty="Value" ValueProperty="Key" Value="@EffectiveFactionStatisticsFilter" ValueChanged="OnFactionStatisticsFilterChanged" Label="Factions" LabelPosition="LabelPosition.Column" Disabled="@(SelectedLeague == TiglLeague.ThundersEdge)" Width="100" />
                </FilterContent>
            </TiglFactionStatisticsTable>
            @if (SelectedLeagueProfile is not null)
            {
                <TiglSeasonHistoryTable Seasons="@FilteredSeasons" LeagueProfile="@SelectedLeagueProfile" OnGameSelected="NavigateToGameDetail" />
                <TiglGameHistoryTable Games="@FilteredGameHistory" OnGameSelected="NavigateToGameDetail" />
                <TiglTopOpponentsTable Opponents="@FilteredTopOpponents" OnPlayerSelected="NavigateToPlayerProfile" />
            }
            <section class="tigl-achievements" aria-label="Achievements">
                <ResponsiveCard CssClass="achievement-title-card mt-xl mb-md">
                    <div class="achievement-title-row">
                        <ResponsiveLabel Text="Achievements" FontSize="lg" CenterText="true" />
                        <ResponsiveCheckbox Label="Show all" IsChecked="@_showAllAchievements" IsCheckedChanged="OnShowAllAchievementsChanged" />
                    </div>
                </ResponsiveCard>
                @if (DisplayedAchievements.Any())
                {
                    <div class="achievements-list">
                        @foreach (var entry in DisplayedAchievements)
                        {
                            <TiglProfileAchievementRow @key="entry.Achievement.AchievementName" Achievement="entry.Achievement" RarityPercent="entry.RarityPercent" IsEarned="entry.IsEarned" />
                        }
                    </div>
                }
                else
                {
                    <ResponsiveLabel Text="No achievements yet." CenterText="true" FontSize="base" TextColor="TextColor.Grey" />
                }
            </section>
            </div>
        </ResponsiveContainer>

        <div class="tigl-profile-right-texture-spacer" data-container-name="tigl-profile-right-texture-spacer"></div>
    }
    else
    {
        <StretchHeightContainer />
    }
</ResponsiveContainer>
}
