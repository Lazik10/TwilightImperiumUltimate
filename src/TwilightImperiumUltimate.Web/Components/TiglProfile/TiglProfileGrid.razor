<ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart" AlignItems="Enums.AlignItems.FlexStart">
    @if (Profile is not null && !string.IsNullOrEmpty(Profile.TiglUserName))
    {
        <TitleTexture Width="15" Texture="Enums.Texture.TopLeft" />
        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" Direction="Enums.FlexDirection.Column" Style="min-width: 0;">
            <TiglProfileHeader Profile="@Profile" CurrentCategory="@CurrentCategory" CurrentCategoryChanged="OnCategoryChanged" />
            <TiglProfileRankSummary Profile="@Profile" />
            @if (SelectedLeagueProfile is not null)
            {
                <TiglLeagueSummaryCard Profile="@SelectedLeagueProfile" Prestige="@SelectedPrestige" />
                <TiglRatingProgression @key="CurrentCategory" Profile="@SelectedLeagueProfile" />
                <TiglRankHistoryTable Ranks="@FilteredRankHistory" />
                <TiglPrestigeHistoryTable Profile="@Profile" Prestiges="@FilteredPrestigeRanks" PathProvider="@PathProvider" />
                <TiglFactionStatisticsTable Stats="@FilteredFactionStats" />
                <TiglSeasonHistoryTable Seasons="@FilteredSeasons" OnGameSelected="NavigateToGameDetail" />
                <TiglGameHistoryTable Games="@FilteredGameHistory" OnGameSelected="NavigateToGameDetail" />
                <TiglTopOpponentsTable Opponents="@FilteredTopOpponents" OnPlayerSelected="NavigateToPlayerProfile" />
            }
            else
            {
                <TiglFactionStatisticsTable Stats="@FilteredFactionStats" />
            }
            <ResponsiveCard CssClass="mt-xl">
            <section class="tigl-achievements" aria-label="Achievements">
                <div class="achievement-title-row mb-md">
                    <ResponsiveHeading Level="2" Text="ACHIEVEMENTS" FontSize="lg" CenterText="true" />
                    <label class="achievement-checkbox-label handel shadow"><input type="checkbox" checked="@_showAllAchievements" @onchange="OnShowAllAchievementsChanged" /><span>Show all</span></label>
                </div>
                @if (DisplayedAchievements.Any())
                {
                    <div class="achievements-list">
                        @foreach (var entry in DisplayedAchievements)
                        {
                            <TiglProfileAchievementRow @key="entry.Achievement.AchievementName" Achievement="entry.Achievement" RarityPercent="entry.RarityPercent" IsEarned="entry.IsEarned" />
                        }
                    </div>
                }
                else
                {
                    <ResponsiveLabel Text="No achievements yet." CenterText="true" FontSize="base" TextColor="TextColor.Grey" />
                }
            </section>
            </ResponsiveCard>
        </ResponsiveContainer>
    }
    else
    {
        <StretchHeightContainer />
    }
</ResponsiveContainer>
