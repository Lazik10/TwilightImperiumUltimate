<section class="section-container mb-xl"><ResponsiveRadzenTable ZebraStripes="true" TableTitle="Seasons"><RadzenTableHeader><RadzenTableHeaderRow><RadzenTableHeaderCell scope="col">Season</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Games</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Win rate</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Details</RadzenTableHeaderCell></RadzenTableHeaderRow></RadzenTableHeader><RadzenTableBody>@if(!Seasons.Any()){<RadzenTableRow><RadzenTableCell colspan="4"><ResponsiveLabel Text="No season data." CenterText="true" /></RadzenTableCell></RadzenTableRow>}@foreach(var season in Seasons){<RadzenTableRow><RadzenTableCell>@season.Season</RadzenTableCell><RadzenTableCell>@season.GamesPlayed</RadzenTableCell><RadzenTableCell>@season.WinRate.ToString("F1")%</RadzenTableCell><RadzenTableCell><button type="button" class="tigl-table-action" aria-expanded="@IsExpanded(season)" @onclick="() => Toggle(season)">@(IsExpanded(season) ? "Hide" : "Show")</button></RadzenTableCell></RadzenTableRow>@if(IsExpanded(season)){foreach(var game in season.Games){<RadzenTableRow><RadzenTableCell colspan="2"><button type="button" class="tigl-link" @onclick="() => OnGameSelected.InvokeAsync(game.MatchReportId)">@game.GameId</button></RadzenTableCell><RadzenTableCell>@game.Score / @game.MaxScore @(game.IsWinner ? "W" : "")</RadzenTableCell><RadzenTableCell>@game.Faction.GetDisplayName()</RadzenTableCell></RadzenTableRow>}}}</RadzenTableBody></ResponsiveRadzenTable></section>
