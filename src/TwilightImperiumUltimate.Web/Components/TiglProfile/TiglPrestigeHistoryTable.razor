<section class="section-container mb-xl"><ResponsiveRadzenTable ZebraStripes="true" CssClass="prestige-history-table" TableTitle="Prestige Ranks"><RadzenTableHeader><RadzenTableHeaderRow><RadzenTableHeaderCell scope="col">Prestige</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Faction</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Achieved</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Rank-up Time</RadzenTableHeaderCell></RadzenTableHeaderRow></RadzenTableHeader><RadzenTableBody>@if(!Rows.Any()){<RadzenTableRow><RadzenTableCell colspan="4"><ResponsiveLabel Text="No prestige ranks." CenterText="true" /></RadzenTableCell></RadzenTableRow>}@foreach(var row in Rows){var item=row.Prestige;<RadzenTableRow><RadzenTableCell><ResponsiveLabel Text="@GetPrestigeText(item)" TextColor="@GetPrestigeColor(item)" CenterText="true" /></RadzenTableCell><RadzenTableCell>@if(item.Faction != TiglFactionName.None){<TiglFactionIconImg FactionName="@item.Faction" Height="20" />}else if(item.PrestigeRank != TiglPrestigeRank.GalacticThreat){@("-")}</RadzenTableCell><RadzenTableCell>@FormatDate(item.AchievedAt)</RadzenTableCell><RadzenTableCell>@row.Duration</RadzenTableCell></RadzenTableRow>}</RadzenTableBody></ResponsiveRadzenTable></section>
