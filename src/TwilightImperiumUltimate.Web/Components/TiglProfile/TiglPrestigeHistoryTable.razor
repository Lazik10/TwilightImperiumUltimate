<section class="section-container mb-xl"><ResponsiveRadzenTable ZebraStripes="true" TableTitle="Prestige rank history"><RadzenTableHeader><RadzenTableHeaderRow><RadzenTableHeaderCell scope="col">Prestige</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Faction</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Achieved</RadzenTableHeaderCell><RadzenTableHeaderCell scope="col">Duration</RadzenTableHeaderCell></RadzenTableHeaderRow></RadzenTableHeader><RadzenTableBody>@if(!Prestiges.Any()){<RadzenTableRow><RadzenTableCell colspan="4"><ResponsiveLabel Text="No prestige ranks." CenterText="true" /></RadzenTableCell></RadzenTableRow>}@for(var i=0;i<Prestiges.Count;i++){var item=Prestiges[i];<RadzenTableRow><RadzenTableCell><ResponsiveLabel Text="@item.PrestigeRank.GetDisplayName()" TextColor="@GetPrestigeColor(item.PrestigeRank)" CenterText="true" /></RadzenTableCell><RadzenTableCell>@if(item.Faction != TiglFactionName.None){<TiglFactionIconImg FactionName="@item.Faction" Height="20" /> @item.Faction.GetDisplayName()}else{@("-")}</RadzenTableCell><RadzenTableCell>@FormatDate(item.AchievedAt)</RadzenTableCell><RadzenTableCell>@GetDuration(i)</RadzenTableCell></RadzenTableRow>}</RadzenTableBody></ResponsiveRadzenTable></section>
