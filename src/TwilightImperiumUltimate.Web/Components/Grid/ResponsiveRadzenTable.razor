@namespace TwilightImperiumUltimate.Web.Components.Grid
@using Radzen.Blazor

@*
    Thin wrapper around Radzen's RadzenTable, for pages that want a plain (non-data-bound) table
    with this app's responsive/zebra-striped/Handel styling but don't need the column
    filtering/model-binding of ResponsiveTable. Compose it with the raw
    RadzenTableHeader/RadzenTableBody/RadzenTableRow/RadzenTableCell child components as usual.

    For a fully custom (non-Radzen) responsive table with declarative
    text/value/boolean/enum column filters and sticky columns, see
    Components/Shared/Tables/ResponsiveTable instead.
 m,
    NOTE: the "responsive-radzen-table-host" div is required so this component's own Blazor
    CSS-isolation scope attribute lands on something real in the DOM -- RadzenTable is a child
    component, not a raw HTML element authored directly in this file, so without a genuine wrapper
    element the ::deep selectors in ResponsiveRadzenTable.razor.css would never match anything.
*@

<div class="responsive-radzen-table-host" style="@GetHostStyle()">
    <RadzenTable class="@GetTableClass()" Style="@Style">
        @if (!string.IsNullOrWhiteSpace(TableTitle) || !string.IsNullOrWhiteSpace(TableDescription) || TableTitleActions is not null)
        {
            <caption class="responsive-radzen-table-caption handel white shadow">
                @if (!string.IsNullOrWhiteSpace(TableTitle) || TableTitleActions is not null)
                {
                    <div class="responsive-radzen-table-caption-row">
                        @if (!string.IsNullOrWhiteSpace(TableTitle))
                        {
                            <ResponsiveHeading Level="2" Text="@TableTitle" FontSize="lg" CenterText="true" CssClass="table-title handel white shadow" />
                        }

                        @if (TableTitleActions is not null)
                        {
                            <div class="responsive-radzen-table-caption-actions">
                                @TableTitleActions
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(TableDescription))
                {
                    <ResponsiveHeading Level="3" Text="@TableDescription" FontSize="md" CenterText="true" CssClass="table-description" />
                }
            </caption>
        }

        @ChildContent
    </RadzenTable>
</div>
