@namespace TwilightImperiumUltimate.Web.Components.Charts
@using Radzen
@using Radzen.Blazor

<RadzenBarChart Title="@Title" Subtitle="@Subtitle" IsLoading="@IsLoading" CategoryTitle="@YAxisLabel" ValueTitle="@XAxisLabel" CategoryFormatter="@FormatCategory" PrivateCategoryLabels="@GetPrivateCategoryLabels()" ChartHeight="@EffectiveChartHeight" ShowLegend="@ShowLegend" ShowValueAxis="@ShowValueAxis" ValueAxisStep="@AxisStep" ValueAxisMin="@ValueAxisMin" ValueAxisMax="@ValueAxisMax" ValueAxisFormatter="@ValueAxisFormatter" SeriesClick="@OnSeriesClick">
    <RadzenBarSeries Data="@Data" CategoryProperty="CategoryKey" ValueProperty="Value" Title="@SeriesTitle" Fills="@GetFills()" FillMode="FillMode.Solid">
        <RadzenSeriesDataLabels Visible="true" Position="DataLabelPosition.Auto" Formatter="@FormatValue" />
    </RadzenBarSeries>
</RadzenBarChart>
