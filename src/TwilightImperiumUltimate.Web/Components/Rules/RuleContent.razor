@using TwilightImperiumUltimate.Web.Helpers.Resources

<ResponsiveCard CssClass="rule-content-card handel white shadow mb-lg">
    <h2>@GetTransformedRuleId() - @TransformedRuleTitle</h2>
    <br />
    <div class="markup-text">@TransformedRuleContent</div>
    <br />
    @if(ShowNotes)
    {
        <Label Text="@Strings.Rules_Notes" />
        <div class="markup-text">@TransformedNoteContent</div>
    }
</ResponsiveCard>

