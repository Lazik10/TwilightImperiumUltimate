@using TwilightImperiumUltimate.Web.Helpers.Resources

<article class="rule-card handel white shadow" id="@GetTransformedRuleAnchor()">
    <header class="rule-card-header">
        <span class="rule-number">@GetTransformedRuleId()</span>
        <h1>@TransformedRuleTitle</h1>
    </header>

    <div class="markup-text rule-body">@TransformedRuleContent</div>

    @if (ShowNotes && !string.IsNullOrWhiteSpace(TransformedRule.NotesContent))
    {
        <aside class="rule-notes">
            <div class="rule-notes-title">@Strings.Rules_Notes</div>
            <div class="markup-text">@TransformedNoteContent</div>
        </aside>
    }
</article>
