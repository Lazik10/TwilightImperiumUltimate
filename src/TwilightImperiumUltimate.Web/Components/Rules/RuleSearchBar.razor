@using TwilightImperiumUltimate.Web.Components.Shared.Layouts
@using TwilightImperiumUltimate.Web.Resources

<div class="rule-searchbar">
    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
        <ResponsiveContainer Type="ContainerType.Flex"
                             Padding="none"
                             Width="50"
                             JustifyContent="Enums.JustifyContent.Center"
                             AlignItems="Enums.AlignItems.Center">
            <ResponsiveLabel Text="@Strings.Rules_Keyword"
                             FontSize="md"
                             CssClass="rule-search-label mr-lg" />
            <ResponsiveTextBox Id="rules-search"
                               Placeholder="@SearchPlaceholder"
                               Value="@SearchTerm"
                               InputChanged="SearchRules"
                               AutoComplete="on" />
        </ResponsiveContainer>
    </ResponsiveContainer>
</div>