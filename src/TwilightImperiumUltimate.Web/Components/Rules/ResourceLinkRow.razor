@using TwilightImperiumUltimate.Web.Enums

<ResponsiveContainer Type="ContainerType.Flex" Padding="none">
    <a href="@Link" target="_blank">@LinkText</a>
</ResponsiveContainer>

<ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart">
    <a href="@Link" target="_blank" download="@DownloadName">
        <ResponsiveContainer Type="ContainerType.Flex" Padding="none">
            <img src="@(PathProvider.GetIconPath(IconType.PdfDownload))" alt="" />
            <div>Download</div>
        </ResponsiveContainer>
    </a>
</ResponsiveContainer>
