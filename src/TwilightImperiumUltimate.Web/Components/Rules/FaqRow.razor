@using System.Globalization

@if(Culture == Strings.EnglishCulture)
{
    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" Width="Width">
        <div class="handel white shadow mb-sm" style="font-size: 24px;">
            @Faq.QuestionEnglish
        </div>
        <div class="text-handel white shadow" style="font-size: 18px;">
            @Faq.AnswerEnglish
        </div>
    </ResponsiveContainer>
}
else if (Culture == Strings.CzechCulture)
{
    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" Width="Width">
        <div class="handel white shadow mb-sm" style="font-size: 24px;">
            @Faq.QuestionCzech
        </div>
        <div class="text-handel white shadow" style="font-size: 18px;">
            @Faq.AnswerCzech
        </div>
    </ResponsiveContainer>
}
