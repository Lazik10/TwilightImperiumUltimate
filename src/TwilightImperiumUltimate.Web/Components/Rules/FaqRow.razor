@if (Culture == Strings.CzechCulture)
{
    <article class="faq-entry">
        <h3 class="handel white shadow">@Faq.QuestionCzech</h3>
        <p class="myriad-pro-regular white">@Faq.AnswerCzech</p>
    </article>
}
else
{
    <article class="faq-entry">
        <h3 class="handel white shadow">@Faq.QuestionEnglish</h3>
        <p class="myriad-pro-regular white">@Faq.AnswerEnglish</p>
    </article>
}
