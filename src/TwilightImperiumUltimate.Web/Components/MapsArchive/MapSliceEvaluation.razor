@using Radzen.Blazor
@using TwilightImperiumUltimate.Web.Components.Grid

@*
    Slice evaluation rendered as a real, semantic table (caption + <th scope="col"> headers) through
    the project-owned ResponsiveRadzenTable wrapper. The previous fixed 9-column GridLayout squeezed
    every header into an equal share of the width, so headers such as "Opt Resources" wrapped or were
    cut off on tablet/mobile. The table instead keeps every header on one line and scrolls
    horizontally when the columns no longer fit.
*@

<section class="slice-evaluation mt-sm mb-sm" aria-label="@Strings.SliceEvaluation_Specifications">

    <ResponsiveRadzenTable ZebraStripes="true" TableTitle="@Strings.SliceEvaluation_Specifications">

        <RadzenTableHeader>
            <RadzenTableHeaderRow>
                <RadzenTableHeaderCell scope="col" class="slice-evaluation-center">@Strings.SliceEvaluation_Id</RadzenTableHeaderCell>
                <RadzenTableHeaderCell scope="col" class="slice-evaluation-center"><span class="green">@Strings.SliceEvaluation_TotalOptimalValue</span></RadzenTableHeaderCell>
                <RadzenTableHeaderCell scope="col" class="slice-evaluation-center"><span class="yellow">@Strings.SliceEvaluation_TotalOptimalValueResources</span></RadzenTableHeaderCell>
                <RadzenTableHeaderCell scope="col" class="slice-evaluation-center"><span class="blue">@Strings.SliceEvaluation_TotalOptimalValueInfluence</span></RadzenTableHeaderCell>
                <RadzenTableHeaderCell scope="col" class="slice-evaluation-center"><span class="yellow">@Strings.SliceEvaluation_TotalResource</span></RadzenTableHeaderCell>
                <RadzenTableHeaderCell scope="col" class="slice-evaluation-center"><span class="blue">@Strings.SliceEvaluation_TotalInfluence</span></RadzenTableHeaderCell>
                <RadzenTableHeaderCell scope="col" class="slice-evaluation-center"><span class="green">@Strings.SliceEvaluation_LegendaryCount</span></RadzenTableHeaderCell>
                <RadzenTableHeaderCell scope="col">@Strings.SliceEvaluation_PlanetTraits</RadzenTableHeaderCell>
                <RadzenTableHeaderCell scope="col">@Strings.SliceEvaluation_TechnologySkips</RadzenTableHeaderCell>
            </RadzenTableHeaderRow>
        </RadzenTableHeader>

        <RadzenTableBody>
            @foreach (var sliceEvaluation in SliceEvaluations)
            {
                <RadzenTableRow @key="sliceEvaluation.Id">
                    <RadzenTableCell class="slice-evaluation-center">@sliceEvaluation.Id</RadzenTableCell>
                    <RadzenTableCell class="slice-evaluation-center"><span class="green">@sliceEvaluation.OptimalValueSum</span></RadzenTableCell>
                    <RadzenTableCell class="slice-evaluation-center"><span class="yellow">@sliceEvaluation.OptimalResourcesSum</span></RadzenTableCell>
                    <RadzenTableCell class="slice-evaluation-center"><span class="blue">@sliceEvaluation.OptimalInfluenceSum</span></RadzenTableCell>
                    <RadzenTableCell class="slice-evaluation-center"><span class="yellow">@sliceEvaluation.Resources</span></RadzenTableCell>
                    <RadzenTableCell class="slice-evaluation-center"><span class="blue">@sliceEvaluation.Influence</span></RadzenTableCell>
                    <RadzenTableCell class="slice-evaluation-center"><span class="green">@sliceEvaluation.LegendariesCount</span></RadzenTableCell>

                    <RadzenTableCell>
                        <span class="slice-evaluation-icons" role="img" aria-label="@GetPlanetTraitsLabel(sliceEvaluation)">
                            @foreach (var planetTrait in sliceEvaluation.PlanetTraits.Keys)
                            {
                                for (var i = 0; i < sliceEvaluation.PlanetTraits[planetTrait]; i++)
                                {
                                    <img src="@GetPlanetTraitPath(planetTrait)" alt="" aria-hidden="true" class="slice-evaluation-icon" />
                                }
                            }
                        </span>
                    </RadzenTableCell>

                    <RadzenTableCell>
                        <span class="slice-evaluation-icons" role="img" aria-label="@GetTechnologySkipsLabel(sliceEvaluation)">
                            @foreach (var technologyType in sliceEvaluation.TechnologySkips.Keys)
                            {
                                for (var i = 0; i < sliceEvaluation.TechnologySkips[technologyType]; i++)
                                {
                                    <img src="@GetTechnologyPath(technologyType)" alt="" aria-hidden="true" class="slice-evaluation-icon" />
                                }
                            }

                            @for (var i = 0; i < sliceEvaluation.LegendariesCount; i++)
                            {
                                <img src="@GetPlanetTraitPath(PlanetTrait.Legendary)" alt="" aria-hidden="true" class="slice-evaluation-icon" />
                            }

                            @for (var i = 0; i < sliceEvaluation.AlphaWormholesCount; i++)
                            {
                                <img src="@GetPlanetTraitPath(PlanetTrait.AlphaWormhole)" alt="" aria-hidden="true" class="slice-evaluation-icon" />
                            }

                            @for (var i = 0; i < sliceEvaluation.BetaWormholesCount; i++)
                            {
                                <img src="@GetPlanetTraitPath(PlanetTrait.BetaWormhole)" alt="" aria-hidden="true" class="slice-evaluation-icon" />
                            }

                            @for (var i = 0; i < sliceEvaluation.GammaWormholesCount; i++)
                            {
                                <img src="@GetPlanetTraitPath(PlanetTrait.GammaWormhole)" alt="" aria-hidden="true" class="slice-evaluation-icon" />
                            }
                        </span>
                    </RadzenTableCell>
                </RadzenTableRow>
            }
        </RadzenTableBody>

    </ResponsiveRadzenTable>

</section>
