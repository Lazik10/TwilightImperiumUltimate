@using TwilightImperiumUltimate.Web.Components.Shared.Bars
@using TwilightImperiumUltimate.Web.Models.MapArchive

<ResponsiveRadzenDataGrid TItem="MapModel"
                          Data="FilteredMaps"
                          AllowPaging="false"
                          AllowSorting="true"
                          AllowFiltering="true"
                          AllowAlternatingRows="true"
                          RowClick="@(map => NavigationManager.NavigateTo(GetMapDetailsUrl(map.Id)))"
                          CssClass="mb-md">
    <Columns>
        <RadzenDataGridColumn TItem="MapModel" Property="Name" Title="@Strings.MapArchive_MapName" />

        <RadzenDataGridColumn TItem="MapModel" Property="Rating" Title="@Strings.MapArchive_MapRating" Filterable="false">
            <Template Context="map">
                <StarRating IsReadOnly="true" Rating="@map.Rating" />
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="MapModel" Property="EventName" Title="@Strings.MapArchive_MapEvent" />

        <RadzenDataGridColumn TItem="MapModel" Property="UserName" Title="@Strings.MapArchive_MapAuthor" />

        <RadzenDataGridColumn TItem="MapModel" Property="MapTemplate" Title="@Strings.MapArchive_MapTemplate">
            <Template Context="map">
                @map.MapTemplate.GetDisplayName()
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</ResponsiveRadzenDataGrid>