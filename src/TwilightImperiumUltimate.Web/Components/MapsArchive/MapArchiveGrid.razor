@using TwilightImperiumUltimate.Web.Components.Shared.Bars
@using TwilightImperiumUltimate.Web.Models.MapArchive

<ResponsiveDataGrid TItem="MapModel"
                     Items="FilteredMaps"
                     ZebraStripes="true"
                     CssClass="mb-md"
                     SelectedItemChanged="RedirectToSelectedMap">

    <ResponsiveTableColumn Field="x => x.Name" Header="@Strings.MapArchive_MapName" Filter="ResponsiveFilterType.Text" HeaderAlign="center" />

    <ResponsiveTableColumn Field="x => x.Rating" Header="@Strings.MapArchive_MapRating" Sortable="true" HeaderAlign="center" Align="center">
        <CellTemplate Context="map">
            <StarRating IsReadOnly="true" Rating="@map.Rating" />
        </CellTemplate>
    </ResponsiveTableColumn>

    <ResponsiveTableColumn Field="x => x.EventName" Header="@Strings.MapArchive_MapEvent" Filter="ResponsiveFilterType.Text" HeaderAlign="center" />

    <ResponsiveTableColumn Field="x => x.UserName" Header="@Strings.MapArchive_MapAuthor" Filter="ResponsiveFilterType.Text" HeaderAlign="center" />

    <ResponsiveTableColumn Field="x => x.MapTemplate" Header="@Strings.MapArchive_MapTemplate" Filter="ResponsiveFilterType.Enum" HeaderAlign="center" Align="center">
        <CellTemplate Context="map">
            @map.MapTemplate.GetDisplayName()
        </CellTemplate>
    </ResponsiveTableColumn>

</ResponsiveDataGrid>