@namespace TwilightImperiumUltimate.Web.Components.Shared.Pagination

@*
    Renders a compact "<< < 1 2 3 4 5 > >>" pagination control. The outer ResponsiveContainer
    always spans the full available width and centers the button group; the buttons themselves
    are sized to fit their own content (not stretched), so the whole group only ever takes up as
    much width as it needs to display the arrows + up to MaxPageButtons page numbers.
*@

<ResponsiveContainer Type="ContainerType.Flex"
                     Padding="none"
                     JustifyContent="Enums.JustifyContent.Center"
                     AlignItems="Enums.AlignItems.Center"
                     CssClass="@CssClass"
                     Style="@Style">
    <nav class="pager-nav" aria-label="Pagination">
        <Button CssClass="pager-button pager-button--icon" Width="0" IsDisabled="@IsFirstPage" OnClick="MoveFirst" ButtonText="&laquo;" aria-label="First page" />
        <Button CssClass="pager-button pager-button--icon" Width="0" IsDisabled="@IsFirstPage" OnClick="MovePrevious" ButtonText="&lsaquo;" aria-label="Previous page" />

        @foreach (var pageNumber in VisiblePages)
        {
            <Button CssClass="@($"pager-button {(pageNumber == CurrentPage ? "pager-button--active" : string.Empty)}")"
                    Width="0"
                    IsDisabled="@(pageNumber == CurrentPage)"
                    OnClick="() => ChangePage(pageNumber)"
                    ButtonText="@pageNumber.ToString()"
                    aria-label='@($"Page {pageNumber}")'
                    aria-current="@(pageNumber == CurrentPage ? "page" : null)"
                    @key="pageNumber" />
        }

        <Button CssClass="pager-button pager-button--icon" Width="0" IsDisabled="@IsLastPage" OnClick="MoveNext" ButtonText="&rsaquo;" aria-label="Next page" />
        <Button CssClass="pager-button pager-button--icon" Width="0" IsDisabled="@IsLastPage" OnClick="MoveLast" ButtonText="&raquo;" aria-label="Last page" />
    </nav>
</ResponsiveContainer>
