<ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart">
    @if (ShowBounds)
    {
        <ResponsiveLabel Text="@MinValue.ToString()" CenterText="true" TextColor="TextColor.Red" Style="@($"font-size: {FontSize}px;")" />
    }
    <div style="position: relative; display: flex; width: 100%;">
        <div class="handel shadow value" style="color: yellow">
            @Value.ToString()
        </div>
        <div style="width: 100%">
            <div class="@(CssClass)"
                 style="min-height: @(FontSize)px; background-color: @(Color); width: @(GetComputedValue())%;"
                 max="100">
            </div>
        </div>
    </div>
    @if (ShowBounds)
    {
        <ResponsiveLabel Text="@MaxValue.ToString()" CenterText="true" TextColor="TextColor.Green" Style="@($"font-size: {FontSize}px;")" />
    }
</ResponsiveContainer>
