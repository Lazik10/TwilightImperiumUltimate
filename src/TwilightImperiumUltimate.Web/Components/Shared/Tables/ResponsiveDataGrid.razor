@namespace TwilightImperiumUltimate.Web.Components.Shared.Tables
@typeparam TItem
@inherits ResponsiveDataViewBase<TItem>

@*
    Sortable/selectable responsive grid. See ResponsiveDataGrid.razor.cs summary for details.
*@

<CascadingValue Value="(IResponsiveTableHost<TItem>)this" IsFixed="true">
    <div style="display:none" aria-hidden="true">@ChildContent</div>
</CascadingValue>

<div class="responsive-table-wrapper responsive-grid-wrapper @(EnableXScroll ? "responsive-table-scroll" : string.Empty) @CssClass" style="@WrapperStyle">
    @if (IsLoading)
    {
        <div class="responsive-table-state" role="status" aria-live="polite">@LoadingText</div>
    }
    else
    {
        var visibleItems = ApplySort(ApplyFilters(Items)).ToList();

        <table class="responsive-table responsive-grid @(ZebraStripes ? "responsive-table-zebra" : string.Empty) @(StickyHeader ? "responsive-table-sticky-header" : string.Empty)" style="@TableStyle">
            @if (!string.IsNullOrEmpty(Caption))
            {
                <caption class="responsive-table-caption handel white shadow">@Caption</caption>
            }
            <thead>
                <tr>
                    @foreach (var column in Columns)
                    {
                        <ResponsiveColumn IsHeader="true"
                                          Resizable="true"
                                          Vertical="column.Vertical"
                                          CssClass="@GetStickyClass(column)"
                                          Style="@GetColumnStyle(column)"
                                          Align="@column.HeaderAlign"
                                          AriaSort="@GetAriaSort(column)">
                            @if (column.Sortable)
                            {
                                <button type="button" class="responsive-grid-sort-button" @onclick="() => ToggleSortAsync(column)">
                                    @column.ResolvedHeader@GetSortIndicator(column)
                                </button>
                            }
                            else
                            {
                                @column.ResolvedHeader
                            }

                            @if (column.Filter != ResponsiveFilterType.None)
                            {
                                <div class="responsive-grid-header-filter">
                                    <ResponsiveColumnFilterControl TItem="TItem"
                                                                    Column="column"
                                                                    State="GetFilterState(column)"
                                                                    InputId="@($"filter-{GetColumnId(column)}")"
                                                                    OnChanged="NotifyFilterChangedAsync" />
                                </div>
                            }
                        </ResponsiveColumn>
                    }
                </tr>
                @if (HasActiveFilters)
                {
                    <tr class="responsive-table-clear-filters-row">
                        <th colspan="@Math.Max(Columns.Count, 1)">
                            <ResponsiveButton ButtonText="@Strings.ButtonText_ClearFilters"
                                              Width="100"
                                              OnClick="ClearAllFiltersAsync"
                                              CssClass="responsive-button-sm" />
                        </th>
                    </tr>
                }
            </thead>
            <tbody>
                @if (visibleItems.Count == 0)
                {
                    <tr>
                        <td colspan="@Math.Max(Columns.Count, 1)" class="responsive-table-state">@EmptyText</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in visibleItems)
                    {
                        <ResponsiveRow IsSelected="IsSelected(item)" OnClick="() => SelectRowAsync(item)">
                            @foreach (var column in Columns)
                            {
                                <ResponsiveColumn TextColor="column.TextColor"
                                                  CssClass="@GetStickyClass(column)"
                                                  Style="@GetColumnStyle(column)"
                                                  Align="@column.Align">
                                    @if (column.CellTemplate is not null)
                                    {
                                        @column.CellTemplate(item)
                                    }
                                    else
                                    {
                                        @column.Accessor(item)
                                    }
                                </ResponsiveColumn>
                            }
                        </ResponsiveRow>
                    }
                }
            </tbody>
        </table>
    }
</div>
