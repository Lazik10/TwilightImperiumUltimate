@namespace TwilightImperiumUltimate.Web.Components.Shared.Tables

@*
    A single table cell (<td>/<th>). Building block used internally by ResponsiveTable/ResponsiveDataGrid,
    and usable standalone for hand-built tables. Always applies the site's Handel font + text shadow;
    TextColor defaults to white.
*@

@if (IsHeader)
{
    <th @ref="_headerElement" scope="@Scope" aria-sort="@AriaSort" class="@ComputedCssClass" style="@ComputedStyle">
        @RenderedContent
        @if (Resizable)
        {
            <span @ref="_resizeHandleElement"
                  class="responsive-column-resize-handle"
                  role="separator"
                  aria-orientation="vertical"
                  aria-label="@Strings.Table_ResizeColumnHandle"
                  tabindex="0"
                  @onkeydown="OnResizeKeyDownAsync"></span>
        }
    </th>
}
else
{
    <td class="@ComputedCssClass" style="@ComputedStyle">
        @RenderedContent
    </td>
}

@code {
    private RenderFragment RenderedContent => ChildContent ?? (builder => builder.AddContent(0, Text));
}
