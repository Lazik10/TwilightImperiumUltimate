@if (_newVersionAvailable)
{
    <section class="update-notify-wrapper" role="status" aria-live="polite">
        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="update-notify-inner" Direction="FlexDirection.Column" AlignItems="Enums.AlignItems.Center">
            <ResponsiveText Text="@Strings.Update_Notification" CssClass="update-notify-text" FontSize="sm" CenterText="true" />
            <ResponsiveButton Text="@Strings.ButtonText_Reload" CssClass="update-notify-button" OnClickMouse="ReloadPage" />
        </ResponsiveContainer>
    </section>
}
