@if (HasHref)
{
    <a class="text-button handel white shadow @(CssClass)"
       href="@Href"
       target="@Target"
       rel="@Rel"
       style="@ComponentStyle"
       @onclick="HandleClickAsync">
        <span class="text-button-content">@MarkupString</span>
    </a>
}
else
{
    <button class="text-button handel white shadow @(CssClass)"
            type="button"
            style="@ComponentStyle"
            @onclick="HandleClickAsync">
        <span class="text-button-content">@MarkupString</span>
    </button>
}
