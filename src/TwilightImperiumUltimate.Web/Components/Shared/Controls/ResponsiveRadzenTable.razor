@namespace TwilightImperiumUltimate.Web.Components.Shared.Controls
@using Radzen.Blazor

@*
    Thin wrapper around Radzen's RadzenTable, for pages that want a plain (non-data-bound) table
    with this app's responsive/zebra-striped/Handel styling but don't need the column
    filtering/sorting/model-binding of ResponsiveTable/ResponsiveGrid. Compose it with the raw
    RadzenTableHeader/RadzenTableBody/RadzenTableRow/RadzenTableCell child components as usual.

    For a fully custom (non-Radzen) responsive table/grid with declarative
    text/value/boolean/enum column filters, sorting, and sticky columns, see
    Components/Shared/Tables/ResponsiveTable and ResponsiveGrid instead.
*@

<RadzenTable class="@GetTableClass()" Style="@Style">
    @ChildContent
</RadzenTable>
