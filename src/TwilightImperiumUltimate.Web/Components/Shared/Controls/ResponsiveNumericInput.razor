@namespace TwilightImperiumUltimate.Web.Components.Shared.Controls

<span class="responsive-numeric-input-host">
    @if (!string.IsNullOrWhiteSpace(AriaLabel))
    {
        <span id="@($"{Id}-accessible-label")" class="responsive-numeric-input__label">@AriaLabel</span>
    }
    <RadzenNumeric TValue="int"
                   id="@(Name is not null && Name != Id ? Id : null)"
                   Name="@(Name ?? Id)"
                   InputAttributes="@InputAttributes"
                   Min="@Min"
                   Max="@Max"
                   Step="@Step.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                   Value="@Value"
                   ValueChanged="OnValueChanged"
                   Disabled="Disabled"
                   class="@ComputedCssClass"
                   style="@ComputedStyle" />
</span>