@namespace TwilightImperiumUltimate.Web.Components.Shared.Controls
@using TwilightImperiumUltimate.Web.Helpers.Enums
@typeparam TEnum

@*
    Responsive equivalent of ResponsiveEnumPicker: same CurrentValue/CurrentValueChanged/ExcludeValues/
    arrow-symbol contract, built from ResponsiveContainer/ResponsiveLabel so text and spacing scale
    with the site's --font-size-*/--space-* tokens instead of raw px. The optional label can sit to
    the Left (Row, the default) of or above (Column) the +/- control via LabelPosition.
*@

<ResponsiveContainer Type="ContainerType.Flex"
                      Padding="none"
                      Width="@Width"
                      Direction="@(LabelPosition == Enums.LabelPosition.Column ? Enums.FlexDirection.Column : Enums.FlexDirection.Row)"
                      JustifyContent="Enums.JustifyContent.FlexStart"
                      AlignItems="@(LabelPosition == Enums.LabelPosition.Column ? Enums.AlignItems.Stretch : Enums.AlignItems.Center)">
    @if (!string.IsNullOrEmpty(Label))
    {
        <ResponsiveLabel Text="@Label"
                          FontSize="@FontSize"
                          TextColor="@LabelColor"
                          CenterText="@CenterLabel"
                          CssClass="@(LabelPosition == Enums.LabelPosition.Row ? "mr-md" : "mb-xs")" />
    }
    <ResponsiveContainer Type="ContainerType.Flex"
                         Padding="none"
                         Width="@(LabelPosition == Enums.LabelPosition.Row ? PickerWidth : 100)"
                         JustifyContent="Enums.JustifyContent.Center"
                         AlignItems="Enums.AlignItems.Center">
        <ArrowButton ArrowSymbol="@LeftArrowSymbol" OnArrowClick="PreviousValue" Width="@ButtonWidth" />
        <ResponsiveLabel Text="@CurrentValue.GetDisplayName()" FontSize="@FontSize" CenterText="true" TextColor="@ValueColor" CssClass="ml-md mr-md" />
        <ArrowButton ArrowSymbol="@RightArrowSymbol" OnArrowClick="NextValue" Width="@ButtonWidth" />
    </ResponsiveContainer>
</ResponsiveContainer>
