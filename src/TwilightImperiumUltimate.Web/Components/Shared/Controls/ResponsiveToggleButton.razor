@namespace TwilightImperiumUltimate.Web.Components.Shared.Controls

<div class="responsive-toggle-button @CssClass" style="@ComputedStyle">
    <span class="responsive-toggle-button-label @(!IsToggled ? "responsive-toggle-button-label-active" : string.Empty)">
        @OffText
    </span>

    <RadzenSwitch Name="@Name" Value="@IsToggled" ValueChanged="HandleValueChangedAsync" />

    <span class="responsive-toggle-button-label @(IsToggled ? "responsive-toggle-button-label-active" : string.Empty)">
        @OnText
    </span>
</div>
