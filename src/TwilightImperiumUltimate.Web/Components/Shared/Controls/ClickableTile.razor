@namespace TwilightImperiumUltimate.Web.Components.Shared.Controls

@*
    Accessible replacement for the repeated "clickable <div>" image-tile / text-tile pattern
    (grid tiles that open a big-image overlay, faction sheet buttons, etc.). Renders a real
    <button> so the tile is keyboard operable and reachable by assistive technology, while
    keeping the same CSS classes so existing tile/grid styling is preserved.
*@

<button type="button" class="clickable-tile @CssClass" style="@Style" @onclick="HandleClickAsync">
    @ChildContent
</button>
