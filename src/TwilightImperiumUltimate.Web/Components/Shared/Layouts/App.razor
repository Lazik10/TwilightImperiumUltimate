@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <AuthorizeView>
                        <Authorized Context="authorizationContext">
                            <PageTitle>Forbidden</PageTitle>
                            <HeadContent>
                                <meta name="robots" content="noindex, follow" />
                            </HeadContent>
                            <LayoutView Layout="@typeof(MainLayout)">
                                <StretchHeightContainer>
                                    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
                                        <ResponsiveHeading Text="403" Level="1" FontSize="2xl" CenterText="true" CssClass="mb-2xl" />
                                        <ResponsiveHeading Text="Access denied" Level="2" FontSize="lg" CenterText="true" CssClass="mb-0" />
                                    </ResponsiveContainer>
                                </StretchHeightContainer>
                            </LayoutView>
                        </Authorized>
                        <NotAuthorized Context="anonymousContext">
                            <PageTitle>Unauthorized</PageTitle>
                            <HeadContent>
                                <meta name="robots" content="noindex, follow" />
                            </HeadContent>
                            <LayoutView Layout="@typeof(MainLayout)">
                                <StretchHeightContainer>
                                    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
                                        <ResponsiveHeading Text="401" Level="1" FontSize="2xl" CenterText="true" CssClass="mb-2xl" />
                                        <ResponsiveHeading Text="Authentication required" Level="2" FontSize="lg" CenterText="true" CssClass="mb-0" />
                                    </ResponsiveContainer>
                                </StretchHeightContainer>
                            </LayoutView>
                        </NotAuthorized>
                    </AuthorizeView>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="body" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <HeadContent>
                <meta name="robots" content="noindex, follow" />
            </HeadContent>
            <LayoutView Layout="@typeof(MainLayout)">
                <StretchHeightContainer>
                    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
                                    <ResponsiveHeading Text="404" Level="1" FontSize="2xl" CenterText="true" CssClass="mb-2xl" />
                                    <ResponsiveHeading Text="Page not found" Level="2" FontSize="lg" CenterText="true" CssClass="mb-0" />
                    </ResponsiveContainer>
                </StretchHeightContainer>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
