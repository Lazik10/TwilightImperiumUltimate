@using Microsoft.AspNetCore.Components.Authorization
@using TwilightImperiumUltimate.Web.Components.Shared.Layouts
@using TwilightImperiumUltimate.Web.Resources
@using TwilightImperiumUltimate.Web.Pages;

<ResponsiveContainer Type="fluid" Padding="none" CssClass="flex-row account-menu" AlignItems="Enums.AlignItems.Center" JustifyContent="Enums.JustifyContent.FlexEnd">
    <div class="account-menu-auth">
        @if(CurrentUserState.User is null)
        {
            <a href="@Pages.Login" class="handel white shadow">@Strings.Page_AccountLogin</a>
            <div class="handel white shadow" aria-hidden="true">/</div>
            <a href="@Pages.Register" class="handel white shadow">@Strings.Page_AccountRegister</a>
        }
        else
        {
            <div class="menu-container" @onmouseenter="OpenAccountDropdown" @onmouseleave="CloseAccountDropdown" @onfocusin="OpenAccountDropdown" @onfocusout="CloseAccountDropdown">
                <MenuButton CssClass="account-trigger" AriaHasPopup="true" AriaExpanded="_isAccountDropdownOpen" AriaControls="account-dropdown">@CurrentUserState.User.UserName</MenuButton>
                <div class="dropdown" id="account-dropdown">
                    <a href="@Pages.AccountInfo">@Strings.Page_AccountInfo</a>
                        <AuthorizeView Roles="Admin">
                            <a href="@Pages.Admin">@Strings.Page_Admin</a>
                        </AuthorizeView>
                        <AuthorizeView Roles="TiglAdmin">
                            <a href="@Pages.TiglAdmin">@Strings.Page_TiglAdmin</a>
                        </AuthorizeView>
                    <a href="@Pages.ResendPasswordRecoveryEmail">@Strings.Page_AccountPasswordReset</a>
                    <MenuButton CssClass="account-logout" OnClick="Logout">@Strings.Login_Logout</MenuButton>
                </div>
            </div>
        }
    </div>

    <div class="account-menu-tools">
        <CultureMenu />
        <InfoIcon />
    </div>
</ResponsiveContainer>
