@using System.Globalization;
@using TwilightImperiumUltimate.Web.Resources;

@if (InlineMode)
{
    <div class="culture-menu-inline @CssClass">
        @foreach (var culture in SupportedCultures)
        {
            <CultureFlagButton Culture="@culture.Code" Label="@culture.Label" OnCultureSelected="SetCulture" />
        }
    </div>
}
else
{
    <div class="culture-menu-wrapper" @onkeydown="HandleKeyDown">
        <button type="button" class="culture-menu-trigger" @onclick="ToggleMenu" aria-haspopup="true" aria-expanded="@(_isMenuVisible ? "true" : "false")" aria-controls="country-menu" aria-label="Change language">
            <img class="culture-flag active-culture-flag"
                 src="@(GetCultureIconPath(CultureInfo.CurrentCulture.Name))"
                 alt="">
        </button>
        @if (_isMenuVisible)
        {
            @* Invisible full-viewport backdrop that closes the dropdown when clicked. It is
               rendered behind #country-menu (DOM order below) so the flag buttons stay on top and
               remain clickable; it is aria-hidden and never focusable, so it never appears in the
               keyboard/screen-reader navigation path. *@
            <div class="culture-menu-backdrop" aria-hidden="true" @onclick="CloseMenu"></div>
        }
        <div id="country-menu" style="@(_isMenuVisible ? "" : "display:none")">
            @foreach (var culture in SupportedCultures)
            {
                <CultureFlagButton Culture="@culture.Code" Label="@culture.Label" OnCultureSelected="SetCulture" />
            }
        </div>
    </div>
}

