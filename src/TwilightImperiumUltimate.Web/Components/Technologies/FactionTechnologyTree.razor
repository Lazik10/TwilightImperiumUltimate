@using TwilightImperiumUltimate.Web.Components.Shared.Layouts

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

    <div class="faction-tech-tree-grid">

        @foreach (var technology in Technologies)
        {
            <div class="image-container">
                <TechnologyCard TechnologyName="@technology.TechnologyName" />
            </div>
        }

    </div>

</ResponsiveContainer>
