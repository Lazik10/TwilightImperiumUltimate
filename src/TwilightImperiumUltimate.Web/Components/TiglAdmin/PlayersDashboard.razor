@using TwilightImperiumUltimate.Contracts.DTOs.Tigl
@using TwilightImperiumUltimate.Contracts.DTOs.Rankings
@using Radzen
@using TwilightImperiumUltimate.Web.Helpers.Enums

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mb-xl">

    <ResponsiveCard>
        <GridLayout Columns="8" CssClass="handel">
        <div class="span-8" style="height: clamp(0.625rem, 0.625rem + 1vw, 1.25rem);"></div>

        <Label Text="Find Player" CenterText="true" TextColor="TextColor.Green" FontSize="24" CssClass="span-8" />
        <div class="span-8" style="height: clamp(0.625rem, 0.625rem + 1vw, 1.25rem);"></div>

        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="span-8">
            <Label Text="By TIGL Name:" TextColor="TextColor.Yellow" Width="50" />
            <ResponsiveDropDown Id="players-dashboard-by-tigl-name"
                            TValue="int"
                            Data="@_users"
                            TextProperty="TiglUserName"
                            ValueProperty="Id"
                            AllowFiltering="true"
                            AllowVirtualization="true"
                            FilterCaseSensitivity="@FilterCaseSensitivity.CaseInsensitive"
                            Placeholder="Type TIGL Name..."
                            ValueChanged="@(async (int id) => await OnUserSelected(id))"
                            Style="width: 50%;"
                            CssClass="mb-md" />

            <Label Text="By Discord Name:" TextColor="TextColor.Yellow" Width="50" />
            <ResponsiveDropDown Id="players-dashboard-by-discord-name"
                            TValue="int"
                            Data="@_users"
                            TextProperty="DiscordUserName"
                            ValueProperty="Id"
                            AllowFiltering="true"
                            AllowVirtualization="true"
                            FilterCaseSensitivity="@FilterCaseSensitivity.CaseInsensitive"
                            Placeholder="Type Discord Tag..."
                            ValueChanged="@(async (int id) => await OnUserSelected(id))"
                            Style="width: 50%;" />
        </ResponsiveContainer>

            <div class="span-8" style="height: clamp(1.25rem, 1.25rem + 1vw, 2.5rem);"></div>
        </GridLayout>
    </ResponsiveCard>

    @if (_selectedUser is not null && !_loading)
    {
        <GridLayout Columns="8" CssClass="handel white shadow background mt-xl">
            <div class="span-8" style="height: clamp(0.625rem, 0.625rem + 1vw, 1.25rem);"></div>
            <Label Text="Player Overview" CenterText="true" TextColor="TextColor.Green" FontSize="24" CssClass="span-8" />
            <div class="span-8" style="height: clamp(0.625rem, 0.625rem + 1vw, 1.25rem);"></div>

            @if (_userOverview is not null)
            {
                <Label Text="Prophecy of Kings" CenterText="true" TextColor="TextColor.Yellow" CssClass="span-8" />
                <Label Text="@GetLeagueRank(_userOverview, TiglLeague.ProphecyOfKings)" TextColor="@(GetLeagueRankTextColor(_userOverview, TiglLeague.ProphecyOfKings))" CenterText="true" CssClass="span-8" FontSize="24" />

                <div class="span-8" style="height: clamp(0.313rem, 0.313rem + 1vw, 0.625rem);"></div>

                <Label Text="Thunders Edge" CenterText="true" TextColor="TextColor.Yellow" CssClass="span-8" />
                <Label Text="@GetLeagueRank(_userOverview, TiglLeague.ThundersEdge)" TextColor="@(GetLeagueRankTextColor(_userOverview, TiglLeague.ThundersEdge))" CenterText="true" CssClass="span-8" FontSize="24" />

                <div class="span-8" style="height: clamp(0.313rem, 0.313rem + 1vw, 0.625rem);"></div>

                <Label Text="Fractured" CenterText="true" TextColor="TextColor.Yellow" CssClass="span-8" />
                <Label Text="@GetLeagueRank(_userOverview, TiglLeague.Fractured)" TextColor="@(GetLeagueRankTextColor(_userOverview, TiglLeague.Fractured))" CenterText="true" CssClass="span-8" FontSize="24" />
            }
            else
            {
                <Label Text="...Loading overview..." CenterText="true" CssClass="span-8" />
            }

            <div class="span-8" style="height: clamp(0.625rem, 0.625rem + 1vw, 1.25rem);"></div>
        </GridLayout>

        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="background mt-xl">
            <Label Text="League" CenterText="true" TextColor="TextColor.Green" FontSize="24" CssClass="mb-md" />

            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="50" CssClass="mb-md">
                <ResponsiveEnumPicker Label="League"
                            TEnum="TiglLeague"
                            CurrentValue="@_selectedLeague"
                            CurrentValueChanged="ChangeLeague"
                            Width="100"
                            ExcludeValues="new List<TiglLeague>() { TiglLeague.Test }"/>
            </ResponsiveContainer>

        </ResponsiveContainer>

        <GridLayout Columns="8" CssClass="handel white shadow background mt-md">
            <div class="span-8" style="height: clamp(0.625rem, 0.625rem + 1vw, 1.25rem);"></div>
            <Label Text="Rank History" CenterText="true" TextColor="TextColor.Yellow" FontSize="24" CssClass="span-8" />
            <div class="span-8" style="height: clamp(1.25rem, 1.25rem + 1vw, 2.5rem);"></div>

            @if (_rankHistory.Count == 0)
            {
                <Label Text="No rank history found for this user." CenterText="true" CssClass="span-8" />
                <div class="span-8" style="height: clamp(0.625rem, 0.625rem + 1vw, 1.25rem);"></div>
            }
            else
            {
                @foreach (var r in _rankHistory.Where(x => x.League == _selectedLeague).OrderBy(x => x.AchievedAt))
                {
                    <Label />
                    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="span-6" JustifyContent="Enums.JustifyContent.Center">
                        <Label Text="@r.Rank.GetDisplayName()" Width="40" TextColor="@(r.Rank.GetRankColor())" />
                        <Label Text="@FormatTimestamp(r.AchievedAt)" Width="40" CenterText="true" />
                        <ResponsiveButton Text="Remove" TextColor="TextColor.Red" Width="20" OnClick="async () => await RemoveRankHistoryAsync(r)" />
                    </ResponsiveContainer>
                    <Label />

                    <div class="span-8" style="height: clamp(0.313rem, 0.313rem + 1vw, 0.625rem);"></div>
                }
            }

            <div class="span-8" style="height: clamp(1.25rem, 1.25rem + 1vw, 2.5rem);"></div>

            <Label Text="Add Rank" CenterText="true" TextColor="TextColor.Yellow" CssClass="span-8" />

            <div class="span-8" style="height: clamp(0.313rem, 0.313rem + 1vw, 0.625rem);"></div>

            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="span-3">
                <ResponsiveEnumPicker TEnum="TiglRankName" Label="Rank" LabelWidth="30" CurrentValue="@_newRankName" CurrentValueChanged="(TiglRankName v) => _newRankName = v" ExcludeValues="ExcludedRanksForLeague" />
            </ResponsiveContainer>

            <Label Text="Date" CenterText="true" />

            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="span-2">
                <ResponsiveDatePicker Id="players-dashboard-rank-date" @bind-Value="_newRankDate" Style="width: 100%;" />
            </ResponsiveContainer>

            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="span-2">
                <ResponsiveButton ButtonText="Add" OnClick="async () => await AddRankHistoryAsync()" Width="80" />
            </ResponsiveContainer>

            <div class="span-8" style="height: clamp(0.625rem, 0.625rem + 1vw, 1.25rem);"></div>
        </GridLayout>

        <GridLayout Columns="8" CssClass="handel white background mt-xl">
            <div class="span-8" style="height: clamp(0.625rem, 0.625rem + 1vw, 1.25rem);"></div>
            <Label Text="Prestige Rank History" CenterText="true" TextColor="TextColor.Yellow" FontSize="24" CssClass="span-8" />
            <div class="span-8" style="height: clamp(1.25rem, 1.25rem + 1vw, 2.5rem);"></div>

            @if (_prestigeHistory.Count == 0)
            {
                <Label Text="No prestige rank history found for this user." CenterText="true" CssClass="span-8" />
                <div style="height: clamp(0.625rem, 0.625rem + 1vw, 1.25rem);"></div>
            }
            else
            {
                @foreach (var p in _prestigeHistory.Where(x => x.League == _selectedLeague).OrderByDescending(x => x.AchievedAt))
                {
                    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="span-8" JustifyContent="Enums.JustifyContent.Center">
                        <Label Text="@p.PrestigeRank.GetDisplayName()" Width="30" />
                        <Label Text="@p.Level.ToString()" Width="10" CenterText="true" />
                        <Label Text="@FormatTimestamp(p.AchievedAt)" Width="30" />
                        <ResponsiveButton Text="Remove" TextColor="TextColor.Red" Width="20" OnClick="async () => await RemovePrestigeRankAsync(p)" />
                    </ResponsiveContainer>

                    <div class="span-8" style="height: clamp(0.313rem, 0.313rem + 1vw, 0.625rem);"></div>
                }
            }

            <div class="span-8" style="height: clamp(0.938rem, 0.938rem + 1vw, 1.875rem);"></div>

            <Label Text="Add Prestige Rank" CenterText="true" TextColor="TextColor.Yellow" CssClass="span-8" />
            <div class="span-8" style="height: clamp(0.313rem, 0.313rem + 1vw, 0.625rem);"></div>

            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="span-8" JustifyContent="Enums.JustifyContent.Center">
                <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="30">
                    <ResponsiveDropDown Id="players-dashboard-prestige-rank"
                                    TValue="TiglPrestigeRank"
                                    Data="@_prestigeRankOptions"
                                    ValueProperty="Value"
                                    TextProperty="Text"
                                    @bind-Value="_newPrestigeRank"
                                    Style="width:80%; color: black;" />
                </ResponsiveContainer>
                <Label Text="Level" Width="10" CenterText="true" />
                <RadzenNumeric style="width:10%" @bind-Value="_newPrestigeLevel" Min="0" Max="7" />
                <Label Text="Date" Width="10" CenterText="true" />
                <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="20">
                    <ResponsiveDatePicker Id="players-dashboard-prestige-rank-date" @bind-Value="_newPrestigeRankDate" Style="width: 90%;" />
                </ResponsiveContainer>
                <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="30">
                    <ResponsiveButton ButtonText="Add" OnClick="async () => await AddPrestigeRankAsync()" Width="80" />
                </ResponsiveContainer>
            </ResponsiveContainer>

            <div class="span-8" style="height: clamp(0.625rem, 0.625rem + 1vw, 1.25rem);"></div>
        </GridLayout>
    }

</ResponsiveContainer>
