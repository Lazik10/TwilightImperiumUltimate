@using TwilightImperiumUltimate.Contracts.DTOs.Tigl
@using TwilightImperiumUltimate.Web.Helpers.Enums

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

    <ResponsiveTable TItem="TiglParameterDto"
                     Items="_parameters"
                     IsLoading="_loading"
                     LoadingText="@Strings.TiglAdmin_LoadingParameters"
                     EmptyText="@Strings.TiglAdmin_NoParametersFound"
                     CssClass="mb-2xl">

        <ResponsiveTableColumn Field="x => x.Name" Header="Name">
            <CellTemplate Context="parameter">
                @parameter.Name.GetDisplayName()
            </CellTemplate>
        </ResponsiveTableColumn>

        <ResponsiveTableColumn Field="x => x.Enabled" Header="Toggle" HeaderAlign="center" Align="center">
            <CellTemplate Context="parameter">
                <TableActionSwitch IsToggled="parameter.Enabled"
                                OnText="@Strings.String_Enabled"
                                OffText="@Strings.String_Disabled"
                                IsToggledChanged="@(async () => await ToggleParameterAsync(parameter))" />
            </CellTemplate>
        </ResponsiveTableColumn>

    </ResponsiveTable>

</ResponsiveContainer>
