@using TwilightImperiumUltimate.Web.Models.TiglAdmin
@using Microsoft.AspNetCore.Components.Forms

@if (_loading)
{
    <Label Text="@Strings.TiglAdmin_LoadingSeasons" CenterText="true" CssClass="mt-2xl mb-3xl" />
}
else
{
    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mb-md">
        <ResponsiveHeading Level="2" Text="@GetActiveSeasonName()" CenterText="true" Style="color: lawngreen !important;" />
    </ResponsiveContainer>

    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

        <ResponsiveTable TItem="SeasonEditModel"
                         Items="_seasonEdits"
                         CssClass="mb-md">

            <ResponsiveTableColumn Field="x => x.SeasonNumber" Header="@Strings.TiglAdmin_SeasonId">
                <CellTemplate Context="s">
                    <span style="color: @((s.IsActive ? TextColor.Green : TextColor.Red).ConvertToString());">@s.SeasonNumber</span>
                </CellTemplate>
            </ResponsiveTableColumn>

            <ResponsiveTableColumn Field="x => x.SeasonName" Header="@Strings.TiglAdmin_SeasonName">
                <CellTemplate Context="s">
                    @if (s.IsEditing)
                    {
                        <input class="handel white" style="width:95%; color:black;" @bind="s.SeasonName" />
                    }
                    else
                    {
                        <span style="color: @((s.IsActive ? TextColor.Green : TextColor.Red).ConvertToString());">@s.SeasonName</span>
                    }
                </CellTemplate>
            </ResponsiveTableColumn>

            <ResponsiveTableColumn Field="x => x.IsActive" Header="@Strings.TiglAdmin_Status">
                <CellTemplate Context="s">
                    <span style="color: @((s.IsActive ? TextColor.Green : TextColor.Red).ConvertToString());">
                        @(s.IsActive ? Strings.TiglAdmin_ActiveYes : Strings.TiglAdmin_ActiveNo)
                    </span>
                </CellTemplate>
            </ResponsiveTableColumn>

            <ResponsiveTableColumn Field="x => x.StartDate" Header="@Strings.TiglAdmin_StartDate">
                <CellTemplate Context="s">
                    @if (s.IsEditing)
                    {
                        <InputDate class="handel white" style="width:95%; color: black;" @bind-Value="s.StartDateValue" />
                    }
                    else
                    {
                        <span style="color: @((s.IsActive ? TextColor.Green : TextColor.Red).ConvertToString());">@FormatDate(s.StartDate)</span>
                    }
                </CellTemplate>
            </ResponsiveTableColumn>

            <ResponsiveTableColumn Field="x => x.EndDate" Header="@Strings.TiglAdmin_EndDate">
                <CellTemplate Context="s">
                    @if (s.IsEditing)
                    {
                        <InputDate class="handel white" style="width:95%; color: black;" @bind-Value="s.EndDateValue" />
                    }
                    else
                    {
                        <span style="color: @((s.IsActive ? TextColor.Green : TextColor.Red).ConvertToString());">@FormatDate(s.EndDate)</span>
                    }
                </CellTemplate>
            </ResponsiveTableColumn>

            <ResponsiveTableColumn Field="x => x.IsEditing" Header="@Strings.TiglAdmin_Edit" HeaderAlign="center" Align="center">
                <CellTemplate Context="s">
                    @if (!s.IsEditing)
                    {
                        <TableActionButton Text="@Strings.TiglAdmin_Edit" OnClick="() => BeginEdit(s)" IsDisabled="@_sendingRequest" />
                    }
                    else
                    {
                        <TableActionButton Text="@Strings.NewsAdmin_Cancel" OnClick="() => CancelEdit(s)" />
                    }
                </CellTemplate>
            </ResponsiveTableColumn>

            <ResponsiveTableColumn Field="x => x.SeasonNumber" Header="@Strings.TiglAdmin_Actions" HeaderAlign="center">
                <CellTemplate Context="s">
                    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Width="100" JustifyContent="Enums.JustifyContent.SpaceEvenly">
                        @if (s.IsEditing)
                        {
                            <TableActionButton Text="@Strings.TiglAdmin_Save" OnClick="() => SaveSeasonAsync(s)" IsDisabled="@_sendingRequest" />
                        }
                        else
                        {
                            @if (!s.IsActive)
                            {
                                <TableActionButton Text="@Strings.TiglAdmin_SetActive" OnClick="() => SetActiveAsync(s.SeasonNumber)" IsDisabled="@_sendingRequest" />
                            }
                            @if (s.IsActive)
                            {
                                <TableActionButton Text="@Strings.TiglAdmin_EndSeason" OnClick="EndSeasonAsync" IsDisabled="@_sendingRequest" />
                            }
                        }
                    </ResponsiveContainer>
                </CellTemplate>
            </ResponsiveTableColumn>

        </ResponsiveTable>

        <ResponsiveCard CssClass="mb-xl">
            <ResponsiveHeading Level="3" Text="@Strings.TiglAdmin_AddNewSeason" CenterText="true" CssClass="mb-lg" />

            <ResponsiveGridContainer Columns="2" TabletColumns="2" MobileColumns="1" Width="100" Gap="var(--space-md)" JustifyItems="Enums.AlignItems.Stretch">
                <ResponsiveLabel Text="#" />
                <ResponsiveNumericInput Id="new-season-number"
                                        Name="season-number"
                                        AriaLabel="@Strings.TiglAdmin_SeasonId"
                                        Min="1"
                                        @bind-Value="_newSeasonNumber" />

                <ResponsiveLabel Text="@Strings.TiglAdmin_SeasonName" />
                <ResponsiveTextBox Id="new-season-name"
                                   Name="season-name"
                                   AriaDescribedBy="new-season-name"
                                   @bind-Value="_newSeasonName" />

                <ResponsiveLabel Text="@Strings.TiglAdmin_StartDate" />
                <ResponsiveDatePicker Id="new-season-start-date" @bind-Value="_newSeasonStartValue" Style="width: 100%;" />

                <ResponsiveLabel Text="@Strings.TiglAdmin_EndDate" />
                <ResponsiveDatePicker Id="new-season-end-date" @bind-Value="_newSeasonEndValue" Style="width: 100%;" />
            </ResponsiveGridContainer>

            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" CssClass="mt-lg">
                <ResponsiveButton ButtonText="@Strings.TiglAdmin_AddSeasonButtonText" OnClick="AddSeasonAsync" IsDisabled="@_sendingRequest" Width="30" />
            </ResponsiveContainer>
        </ResponsiveCard>
    </ResponsiveContainer>
}

