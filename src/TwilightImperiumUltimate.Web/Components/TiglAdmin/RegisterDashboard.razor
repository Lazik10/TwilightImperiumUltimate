@using TwilightImperiumUltimate.Web.Components.Shared.Forms

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

    @if (_loading)
    {
        <ResponsiveText Text="@Strings.TiglAdmin_LoadingRegistrationParameters" CenterText="true" CssClass="mt-xl mb-xl" />
    }
    else if (!_manualRegisterEnabled)
    {
        <ResponsiveText Text="@Strings.TiglAdmin_ManualRegistrationDisabled" CssClass="mb-md" />
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_manualRegisterError))
        {
            <ResponsiveText Text="@_manualRegisterError" CenterText="true" TextColor="TextColor.Red" CssClass="mb-md" />
        }

        @if (_manualRegisterSuccess)
        {
            <ResponsiveText Text="@Strings.TiglAdmin_RegisterUserSuccess" TextColor="TextColor.Green" CenterText="true" CssClass="mb-md" />
        }

        <ResponsiveForm Model="_newUser"
                        OnValidSubmit="ManualRegisterUser"
                        IsSubmitting="_manualRegistering"
                        SubmitText="@Strings.TiglAdmin_RegisterUserButton"
                        SubmittingText="@Strings.TiglAdmin_RegisterUserButton"
                        Columns="1"
                        CssClass="mb-xl">

            <ResponsiveFormField Id="register-discord-id" Label="@Strings.TiglAdmin_DiscordId" For="@(() => _newUser.DiscordId)" Required="true">
                <ResponsiveTextBox Id="register-discord-id" Value="@_newUser.DiscordId.ToString()" ValueChanged="OnDiscordIdChanged" />
            </ResponsiveFormField>

            <ResponsiveFormField Id="register-discord-tag" Label="@Strings.TiglAdmin_DiscordTag" For="@(() => _newUser.DiscordTag)">
                <ResponsiveTextBox Id="register-discord-tag" @bind-Value="_newUser.DiscordTag" />
            </ResponsiveFormField>

            <ResponsiveFormField Id="register-tigl-username" Label="@Strings.TiglAdmin_TiglUserName" For="@(() => _newUser.TiglUserName)" Required="true">
                <ResponsiveTextBox Id="register-tigl-username" @bind-Value="_newUser.TiglUserName" />
            </ResponsiveFormField>

        </ResponsiveForm>
    }

</ResponsiveContainer>
