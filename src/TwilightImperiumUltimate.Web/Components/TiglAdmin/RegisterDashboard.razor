@using TwilightImperiumUltimate.Contracts.DTOs.Tigl

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="70">

        <Label Text="Manual User Registration" FontSize="32" CenterText="true" CssClass="mt-md mb-md" />

        @if (_loading)
        {
            <Label Text="...Loading registration parameters..." CenterText="true" CssClass="mt-xl mb-xl" />
        }
        else if (!_manualRegisterEnabled)
        {
            <HelpText Text="Manual registration is disabled. Enable 'Test Registrations' in Parameters to use this form." CssClass="mb-md" />
        }
        else
        {
            <Title Text="Test Registration (Manual)" MarginTop="10" MarginBottom="10" FontSize="22" TextColor="TextColor.Yellow" />
            <HelpText Text="This form is visible because 'Test Registrations' parameter is enabled." CssClass="mb-md" />

            @if (!string.IsNullOrWhiteSpace(_manualRegisterError))
            {
                <Label Text="@_manualRegisterError" TextColor="TextColor.Red" CssClass="mb-sm" />
            }

            <GridLayout CssClass="background mb-md" Style="grid-template-columns: 25% 75%; row-gap:10px;">
                <Label Text="Discord ID" />
                <input class="handel white" style="width:95%; color:black;" @bind="_newUser.DiscordId" />

                <Label Text="Discord Tag (Username)" />
                <input class="handel white" style="width:95%; color:black;" @bind="_newUser.DiscordTag" />

                <Label Text="TIGL Username" />
                <input class="handel white" style="width:95%; color:black;" @bind="_newUser.TiglUserName" />
            </GridLayout>

            @if (_manualRegisterSuccess)
            {
                <Label Text="User registered successfully." TextColor="TextColor.Green" CenterText="true" CssClass="mb-sm" />
            }
            <ResponsiveButton ButtonText="Register User" OnClick="ManualRegisterUser" IsDisabled="@_manualRegistering" Width="30" CssClass="mb-md" />
        }

    </ResponsiveContainer>

</ResponsiveContainer>
