
<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="@(Width)">

    @if (DropDownEnabled && Picked)
    {
        <ResponsiveDropDown Id="@_dropdownId"
                            TValue="ObjectiveCardName"
                            Value="@_selectedObjectiveCard"
                            ValueChanged="@(async (ObjectiveCardName v) => { _selectedObjectiveCard = v; await HandleObjectiveChange(); })"
                            Data="@_objectives"
                            ValueProperty="Key"
                            TextProperty="Value"
                            Style="max-width: 230px; height: 100%; text-overflow: ellipsis; white-space: nowrap; overflow: hidden;"
                            CssClass="title" />
    }

    <div class="image-item clickable" @onclick="HandleClick">
        <img src="@GetCardImagePath()">
    </div>

</ResponsiveContainer>
