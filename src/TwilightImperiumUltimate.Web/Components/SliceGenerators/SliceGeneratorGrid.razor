@using TwilightImperiumUltimate.Web.Components.MapGenerator

<div class="slice-generator-grid">

    <SliceGeneratorNavBar SelectedMenuItem="@_selectedMenuItem" OnMenuItemClick="OnMenuItemClick" />

    @if(_selectedMenuItem == SliceGeneratorMenuItem.SliceGenerator)
    {
        <CascadingValue Value="this" Name="SliceGeneratorGrid">
            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-md">
                <ResponsiveButton ButtonText="@Strings.SliceGenerator_GenerateRandomSlices" OnClick="GenerateSlices" Width="30" />
            </ResponsiveContainer>

            <div class="slice-controls">
                <SliceHexTileMenu @ref="_sliceHexTileMenu" />

                <SliceQuickMenu OnMenuIconClick="HandleQuickMenuClick" />
            </div>

            <div id="sliceArea" class="slice-generator-slices-grid">
                @foreach (var slice in Slices)
                {
                    <Slice SliceModel="slice" />
                }
            </div>
        </CascadingValue>
    }
    else if (_selectedMenuItem == SliceGeneratorMenuItem.SliceEvaluation)
    {
        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-md mb-md">
            <ResponsiveButton ButtonText="@Strings.SliceGenerator_GenerateRandomSlices" OnClick="GenerateSlices" Width="30" />
        </ResponsiveContainer>

        <SliceEvaluationGrid Slices="Slices" />
    }
    else if (_selectedMenuItem == SliceGeneratorMenuItem.Settings)
    {
        <SliceGeneratorSettings OnSettingsChange="async () =>  await UpdateSlices()" />
    }
</div>
