<ResponsiveTabMenu AriaLabel="@Strings.Page_SliceGenerator_PageTitle" CssClass="faction-style mb-md">
    <ResponsiveTab Id="slice-generator-slices-tab"
                   IsActive="@(SelectedMenuItem == SliceGeneratorMenuItem.SliceGenerator)"
                   OnClick="() => OnMenuItemClick.InvokeAsync(SliceGeneratorMenuItem.SliceGenerator)">
        @Strings.SliceGeneratorMenu_Slices
    </ResponsiveTab>
    <ResponsiveTabSeparator />
    <ResponsiveTab Id="slice-generator-stats-tab"
                   IsActive="@(SelectedMenuItem == SliceGeneratorMenuItem.SliceEvaluation)"
                   OnClick="() => OnMenuItemClick.InvokeAsync(SliceGeneratorMenuItem.SliceEvaluation)">
        @Strings.SliceGeneratorMenu_Stats
    </ResponsiveTab>
    <ResponsiveTabSeparator />
    <ResponsiveTab Id="slice-generator-settings-tab"
                   IsActive="@(SelectedMenuItem == SliceGeneratorMenuItem.Settings)"
                   OnClick="() => OnMenuItemClick.InvokeAsync(SliceGeneratorMenuItem.Settings)">
        @Strings.SliceGeneratorMenu_Settings
    </ResponsiveTab>
</ResponsiveTabMenu>
