<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
    <div class="slice-generator-navbar">
        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Width="100" JustifyContent="Enums.JustifyContent.SpaceEvenly">
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(SliceGeneratorMenuItem.SliceGenerator)">
                <ResponsiveLabel Text="@Strings.SliceGeneratorMenu_Slices" CenterText="true" FontSize="base" />
            </TabNavItem>
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(SliceGeneratorMenuItem.SliceEvaluation)">
                <ResponsiveLabel Text="@Strings.SliceGeneratorMenu_Stats" CenterText="true" FontSize="base" />
            </TabNavItem>
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(SliceGeneratorMenuItem.Settings)">
                <ResponsiveLabel Text="@Strings.SliceGeneratorMenu_Settings" CenterText="true" FontSize="base" />
            </TabNavItem>
        </ResponsiveContainer>
    </div>
</ResponsiveContainer>
