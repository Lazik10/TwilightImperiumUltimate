@using TwilightImperiumUltimate.Web.Components.Shared.Layouts
@inherits TwilightImperiumBaseComponent

<button type="button"
    class="hex-container @(IsTileSelected ? "hex-container-selected" : string.Empty)"
    draggable="true"
    aria-label="@($"Select {SystemTile?.SystemTileName}")"
    aria-pressed="@IsTileSelected"
    @onclick="HandleTileClick"
    @ondragstart="@(() => StartDragSystemTile())"
    @ondrop="RequestDropSystemTile"
    @ondrop:preventDefault="true"
    @ondragover="@(() => DragOverSystemTile())"
    @ondragover:preventDefault="true"
    @ondragend="@(() => EndDragSystemTile())"
    title="@(SystemTile?.SystemTileName.ToString())">

    <img src="@ImagePath"
         style="transform: rotate(@(_degrees)deg);
                transition: transform 0.5s ease;"
        alt="Hexagon" 
        @onclick="HandleImageClick"
        @onclick:stopPropagation="true">

    @if (Overlay == SystemTileOverlay.Id || Overlay == SystemTileOverlay.Resources || Overlay == SystemTileOverlay.Influence)
    {
        <div class="hex-text @(SystemTileOverlayColor) handel shadow">
            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
                @SystemTileOverlayText
            </ResponsiveContainer>
        </div>
    }
    else if (Overlay == SystemTileOverlay.ResourcesAndInfluence)
    {
        <div class="hex-text white handel shadow">
            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
                <ResponsiveContainer Type="ContainerType.Flex" Padding="none">
                    <div class="yellow">@SystemTile?.Resources</div><span class="ml-sm mr-sm">/</span><div class="blue">@SystemTile?.Influence</div>
                </ResponsiveContainer>
            </ResponsiveContainer>
        </div>
    }
</button>

