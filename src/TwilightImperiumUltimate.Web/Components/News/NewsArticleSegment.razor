@using TwilightImperiumUltimate.Web.Components.Shared.Layouts
@using TwilightImperiumUltimate.Web.Components.Shared.Text

<article class="news-article-segment">
    <div class="news-article-segment-texture" aria-hidden="true">
        <TitleTexture Width="100" Texture="Enums.Texture.TopLeft" />
    </div>

    <div class="news-article-segment-content">
        <div class="article-title-line mt-2xl" aria-hidden="true">
            <TitleLine />
        </div>

        <ResponsiveHeading Level="2" Text="@NewsArticle.Title" CssClass="article-title handel-cz" />

        <div class="article-title-line" aria-hidden="true">
            <TitleLine />
        </div>

        <ResponsiveText TagName="TagName.Div" CssClass="markup-text pt-2xl mb-2xl">
            @_markupString
        </ResponsiveText>

        <footer class="article-meta width-100 mb-2xl">
            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="flex-row article-meta-row" JustifyContent="Enums.JustifyContent.SpaceBetween" AlignItems="Enums.AlignItems.Center">
                <ResponsiveText TagName="TagName.P" CssClass="author" Text='@(string.Concat(Strings.News_AuthorLabel, " ", NewsArticle.User?.UserName))' />

                <ResponsiveText TagName="TagName.P" CssClass="author">
                    @Strings.News_DateLabel <time datetime="@CreatedAt">@CreatedAt</time>
                </ResponsiveText>
            </ResponsiveContainer>
        </footer>
    </div>
</article>
