@using TwilightImperiumUltimate.Web.Components.Shared.Bars

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

    <ResponsiveFormField TValue="string" Id="role-assignment-search" Label="@Strings.SearchForPlayer" CssClass="mb-md">
        <ResponsiveAutocomplete Id="role-assignment-search"
                                Name="role-assignment-search"
                                Data="_userLookupSuggestions"
                                Value="@_userSearchText"
                                ValueChanged="OnUserSearchChanged"
                                Placeholder="@Strings.Admin_PlayerLookupPlaceholder"
                                Width="40" />
    </ResponsiveFormField>

    <ResponsiveFormField TValue="string" Id="role-assignment-role" Label="@Strings.SelectedRole" CssClass="mb-lg">
        <ResponsiveDropDown TValue="string"
                            Id="role-assignment-role"
                            Name="role-assignment-role"
                            Data="_roles"
                            TextProperty="Name"
                            ValueProperty="Name"
                            Value="@_selectedRole"
                            ValueChanged="OnRoleSelected"
                            Width="40" />
    </ResponsiveFormField>

    @if (IsUserSelected)
    {
        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart" AlignItems="Enums.AlignItems.Center" CssClass="mb-md">
            <ResponsiveLabel Text="@Strings.Admin_UserRoles" CssClass="mr-md" />

            @foreach (var role in _specificUserRoles)
            {
                <ResponsiveLabel Text="@role.Name" CssClass="mr-md" />
            }
        </ResponsiveContainer>
    }
    else
    {
        <ResponsiveText Text="@Strings.Admin_NoUserSelected" TextColor="TextColor.Red" CssClass="mb-md" />
    }

    <ResponsiveButtonGroup GroupStyle="ButtonGroupStyle.Row">
        <ResponsiveButton ButtonText="@Strings.Admin_AddUserRole" OnClick="AddRoleToUser" ButtonType="ButtonType.Submit" IsDisabled="IsAddRolePossible()" />
        <ResponsiveButton ButtonText="@Strings.Admin_RemoveUserRole" OnClick="RemoveRoleFromUser" ButtonType="ButtonType.Submit" IsDisabled="IsRemoveRolePossible()" />
    </ResponsiveButtonGroup>

    @if (_showRoleAddSuccess)
    {
        <ResponsiveText Text="@Strings.Admin_AddRoleToUserSuccess" CenterText="true" TextColor="TextColor.Green" FontSize="lg" CssClass="mt-xl mb-xl" />
    }

    @if (_showRoleRemoveSuccess)
    {
        <ResponsiveText Text="@Strings.Admin_RemoveRoleFromUserSuccess" CenterText="true" TextColor="TextColor.Green" FontSize="lg" CssClass="mt-xl mb-xl" />
    }

</ResponsiveContainer>
