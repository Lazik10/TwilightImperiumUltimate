
<ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="mt-2xl mb-lg">
    <ResponsiveButton Text="@Strings.GameTracker_PublicObjectives" OnClick="() => UpdateWindow(GameTrackerWindow.PublicObjectives)" FontSize="22" />
    <ResponsiveButton Text="@Strings.GameTracker_SecretObjectives" OnClick="() => UpdateWindow(GameTrackerWindow.SecretObjectives)" FontSize="22" />
    <ResponsiveButton Text="@Strings.GameTracker_BonusPoints" OnClick="() => UpdateWindow(GameTrackerWindow.BonusPoints)" FontSize="22" />
</ResponsiveContainer>

@if (_window == GameTrackerWindow.PublicObjectives)
{
    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
        <ObjectiveScoreGrid />
    </ResponsiveContainer>
}
else if (_window == GameTrackerWindow.SecretObjectives)
{
    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
        <SecretScoreGrid />
    </ResponsiveContainer>
}
else if (_window == GameTrackerWindow.BonusPoints)
{
    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
        <BonusScoreGrid />
    </ResponsiveContainer>
}

