@using TwilightImperiumUltimate.Web.Components.Cards
@using TwilightImperiumUltimate.Web.Components.Factions

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

    <Label Text="Custodians and Imperial" CenterText="true" FontSize="24" CssClass="mb-md" />

    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Width="60" AlignItems="Enums.AlignItems.Center" CssClass="background">
        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="25">
            <img src="@(PathProvider.GetIconPath(IconType.Custodians))" style="width: 50%;" />
            <Label Text="Score:" CenterText="true" />
            <GridLayout Columns="4">
                @foreach (var player in _players)
                {
                    <ScorePlayerIcon FactionName="@player.FactionName" ScoreStatusFilter="@GetCustodiansScoreStatus(player)" OnClick="() => ScoreCustodians(player)" />
                }
            </GridLayout>
        </ResponsiveContainer>

        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" AlignItems="Enums.AlignItems.Center" JustifyContent="Enums.JustifyContent.SpaceEvenly" Width="25">
            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.SpaceBetween">
                <StrategyCard Name="@StrategyCardName.Imperial" MaxHeight="250"/>
                <GridLayout Columns="2">
                    @foreach (var player in _players)
                    {
                        <FactionIconImg FactionName="@player.FactionName" />
                        <ResponsiveNumericPicker 
                            CenterLabel="true" 
                            Value="player.BonusObjectives.ImperialScore" 
                            OnDecrease="() => DecreasePlayerImperialScore(player)"
                            OnIncrease="() => IncreasePlayerImperialScore(player)" />
                    }
                </GridLayout>
            </ResponsiveContainer>
        </ResponsiveContainer>
    </ResponsiveContainer>

    <Label Text="Agenda" FontSize="24" CenterText="true" CssClass="mb-md" />

    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Width="60" AlignItems="Enums.AlignItems.FlexStart" CssClass="background">

        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.FlexStart" JustifyContent="Enums.JustifyContent.SpaceEvenly" CssClass="mr-md">
            <VerticalCard Name="@AgendaCardName.PoliticalCensure.ToString()" TypeOfCard="@CardType.Agenda.ToString()" />
            <Label Text="Score:" CenterText="true" />
            <GridLayout Columns="4">
                @foreach (var player in _players)
                {
                    <ScorePlayerIcon FactionName="@player.FactionName" ScoreStatusFilter="@GetAgendaScoreStatus(AgendaCardName.PoliticalCensure, player)" OnClick="() => ScoreAgendaBonusObjective(AgendaCardName.PoliticalCensure, player)" />
                }
            </GridLayout>
        </ResponsiveContainer>

        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.FlexStart" JustifyContent="Enums.JustifyContent.SpaceEvenly" CssClass="mr-md">
            <VerticalCard Name="@AgendaCardName.ClassifiedDocumentLeaks.ToString()" TypeOfCard="@CardType.Agenda.ToString()" />
            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
                @if (ShowClassifiedDocumnetLeaks())
                {
                    <Label Text="Select secret:" CenterText="true" />
                    <RadzenDropDown @bind-Value="_selectedObjectiveCard"
                                Data="@_objectives"
                                Change="() => HandleClassifiedDocumentLeaks()"
                                ValueProperty="Key"
                                TextProperty="Value"
                                Style="width: 100%; max-width: 200px; height: 100%; text-overflow: ellipsis; white-space: nowrap; overflow: hidden;"
                                class="title handel" />
                    <ResponsiveButton ButtonText="Clear" OnClick="() => ClearClassifiedDocumentLeaks(true)" Width="100"/>
                }
                else
                {
                    <Label Text="No secret scored!" CenterText="true" TextColor="TextColor.Red" />
                }
            </ResponsiveContainer>
        </ResponsiveContainer>

        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.FlexStart" JustifyContent="Enums.JustifyContent.SpaceEvenly">
            <VerticalCard Name="@AgendaCardName.Mutiny.ToString()" TypeOfCard="@CardType.Agenda.ToString()" />
            <ResponsiveContainer Type="ContainerType.Flex" Padding="none">
                <ClickableTile Style="width: 45%;" OnClick="() => UpdateMutiny(true)">
                    <Label Text="For" TextColor="GetMutinyTextColor(true)" CenterText="true" />
                </ClickableTile>
                <Label Text="/" CenterText="true" Width="10" />
                <ClickableTile Style="width: 45%;" OnClick="() => UpdateMutiny(false)">
                    <Label Text="Against" TextColor="GetMutinyTextColor(false)" CenterText="true" />
                </ClickableTile>
            </ResponsiveContainer>
            <GridLayout Columns="4">
                @foreach (var player in _players)
                {
                    <ScorePlayerIcon FactionName="@player.FactionName" ScoreStatusFilter="@GetAgendaScoreStatus(AgendaCardName.Mutiny, player)" OnClick="() => ScoreAgendaBonusObjective(AgendaCardName.Mutiny, player)" />
                }
            </GridLayout>
        </ResponsiveContainer>

        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.FlexStart" JustifyContent="Enums.JustifyContent.SpaceEvenly" CssClass="mr-md">
            <VerticalCard Name="@AgendaCardName.SeedOfAnEmpire.ToString()" TypeOfCard="@CardType.Agenda.ToString()" />
            <Label Text="Score:" CenterText="true" />
            <GridLayout Columns="4">
                @foreach (var player in _players)
                {
                    <ScorePlayerIcon FactionName="@player.FactionName" ScoreStatusFilter="@GetAgendaScoreStatus(AgendaCardName.SeedOfAnEmpire, player)" OnClick="() => ScoreAgendaBonusObjective(AgendaCardName.SeedOfAnEmpire, player)" />
                }
            </GridLayout>
        </ResponsiveContainer>

        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.FlexStart" JustifyContent="Enums.JustifyContent.SpaceEvenly">
            <VerticalCard Name="@AgendaCardName.IncentiveProgram.ToString()" TypeOfCard="@CardType.Agenda.ToString()" />
            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" AlignItems="Enums.AlignItems.FlexStart">
                <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="25">
                    <ClickableTile OnClick="async () => await HandleIncentiveProgram(ObjectiveCardType.StageOne)">
                        <Label Text="Revealed" TextColor="GetIncentiveProgramTextColor(ObjectiveCardType.StageOne)" />
                        <ObjectiveCard Picked="false" ObjectiveCardType="ObjectiveCardType.StageOne" />
                    </ClickableTile>
                </ResponsiveContainer>
                <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="25">
                    <ClickableTile OnClick="async () => await HandleIncentiveProgram(ObjectiveCardType.StageTwo)">
                        <Label Text="Revealed" TextColor="GetIncentiveProgramTextColor(ObjectiveCardType.StageTwo)" />
                        <ObjectiveCard Picked="false" ObjectiveCardType="ObjectiveCardType.StageTwo" />
                    </ClickableTile>
                </ResponsiveContainer>
            </ResponsiveContainer>
        </ResponsiveContainer>

    </ResponsiveContainer>

    <Label Text="Relics & Action Cards" FontSize="24" CenterText="true" CssClass="mt-md" />

    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Width="60" AlignItems="Enums.AlignItems.FlexStart" CssClass="background mb-md">

        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.FlexStart" JustifyContent="Enums.JustifyContent.SpaceEvenly" Width="20">

            <VerticalCard Name="@RelicCardName.ShardOfTheThrone.ToString()" TypeOfCard="@CardType.Relic.ToString()" />
            <Label Text="Score:" CenterText="true" />
            <GridLayout Columns="4">
                @foreach (var player in _players)
                {
                    <ScorePlayerIcon FactionName="@player.FactionName" ScoreStatusFilter="@GetRelicScoreStatus(RelicCardName.ShardOfTheThrone, player)" OnClick="() => ScoreRelicBonusObjective(RelicCardName.ShardOfTheThrone, player)" />
                }
            </GridLayout>

        </ResponsiveContainer>

        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.FlexStart" JustifyContent="Enums.JustifyContent.SpaceEvenly" Width="20">

            <VerticalCard Name="@RelicCardName.TheCrownOfEmphidia.ToString()" TypeOfCard="@CardType.Relic.ToString()" />
            <Label Text="Score:" CenterText="true" />
            <GridLayout Columns="4">
                @foreach (var player in _players)
                {
                    <ScorePlayerIcon FactionName="@player.FactionName" ScoreStatusFilter="@GetRelicScoreStatus(RelicCardName.TheCrownOfEmphidia, player)" OnClick="() => ScoreRelicBonusObjective(RelicCardName.TheCrownOfEmphidia, player)" />
                }
            </GridLayout>

        </ResponsiveContainer>

        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" Width="25">

        </ResponsiveContainer>

        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Direction="Enums.FlexDirection.Column" AlignItems="Enums.AlignItems.FlexStart" JustifyContent="Enums.JustifyContent.SpaceEvenly" Width="20">

            <VerticalCard Name="@ActionCardName.ImperialRider.ToString()" TypeOfCard="@CardType.Action.ToString()" />
            <Label Text="Score:" CenterText="true" />
            <GridLayout Columns="4">
                @foreach (var player in _players)
                {
                    <ScorePlayerIcon FactionName="@player.FactionName" ScoreStatusFilter="@GetActionScoreStatus(ActionCardName.ImperialRider, player)" OnClick="() => ScoreActionBonusObjective(ActionCardName.ImperialRider, player)" />
                }
            </GridLayout>

        </ResponsiveContainer>

    </ResponsiveContainer>

</ResponsiveContainer>


