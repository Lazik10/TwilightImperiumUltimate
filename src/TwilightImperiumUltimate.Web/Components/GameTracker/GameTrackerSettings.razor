@using TwilightImperiumUltimate.Web.Components.Factions
@using TwilightImperiumUltimate.Web.Components.Shared.Shapes

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" Width="70">

        <Title Text="@Strings.GameTracker_Settings" FontSize="48" CssClass="mb-2xl"/>

        <GridLayout Columns="2" Gap="40" >

            <ResponsiveNumericPicker Label="@Strings.GameTracker_ScorePoints"
                Value="@GameTrackerSettingsService.NumberOfPoints"
                OnDecrease="DecreaseScorePoints"
                OnIncrease="IncreaseScorePoints"
                Width="100"
                FontSize="lg"
                CenterLabel="false" />

                <div />

            <ResponsiveNumericPicker Label="@Strings.GameTracker_NumberOfPlayers"
                           Value="@GameTrackerSettingsService.NumberOfPlayers"
                           OnDecrease="DecreasePlayerCount"
                           OnIncrease="IncreasePlayerCount"
                           Width="100"
                           FontSize="lg"
                           CenterLabel="false" />

            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart">
                <YesNoPicker Title="@Strings.GameTracker_EnablePlayerNames"
                             DefaultValue="@GameTrackerSettingsService.EnablePlayerNames"
                             OnValueChange="TogglePlayerNames"
                             Width="100"
                             FontSize="24" />
            </ResponsiveContainer>

            @foreach (var player in _players)
            {
                <ResponsiveContainer Type="ContainerType.Flex" Padding="none">

                    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Width="20" CssClass="mr-sm">
                            <FactionIconImg FactionName="@player.FactionName" MaxHeight="50px" />
                    </ResponsiveContainer>

                    <Rectangle Width="50" Height="50" Fill="@player.ColoTextName" OnClick="() => HandleRectangleClick(player)"/>

                    @if(GameTrackerSettingsService.EnablePlayerNames)
                    {
                        <RadzenTextBox Placeholder="@player.DefaultName"
                                       @bind-Value="@player.Name"
                                       class="title white handel"
                                       Style="max-height: 25px; margin-right: 20px; margin-left: 20px;" />
                    }
                    else
                    {
                        <Label Text="@player.DefaultName" CenterText="true" FontSize="20" />
                    }

                    <ResponsiveDropDown Id="@($"game-tracker-faction-{player.DefaultName}")"
                                        TValue="FactionName"
                                        Value="@player.FactionName"
                                        ValueChanged="@(async (FactionName v) => { player.FactionName = v; await UpdatePlayerColors(); })"
                                        Data="_factionNames"
                                        TextProperty="Value"
                                        ValueProperty="Key"
                                        CssClass="title" />

                </ResponsiveContainer>
            }

            @if (_players.Count % 2 == 1)
            {
                <div />
            }

            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart">
                <YesNoPicker Title="@Strings.GameVersion_ProphecyOfKings"
                             DefaultValue="GameTrackerSettingsService.GameVersions.Contains(GameVersion.ProphecyOfKings)"
                             OnValueChange="async () => await UpdateGameVersion(GameVersion.ProphecyOfKings)"
                             Width="100"
                             FontSize="24" />
            </ResponsiveContainer>

            <div />
        </GridLayout>

        <ResponsiveButton ButtonText="@Strings.GameTracker_InitializePhaseComplete" Width="25" IsDisabled="!IsNextPhasePossible()" OnClick="ProceedToNextPhase" CssClass="mt-2xl"/>

    </ResponsiveContainer>

</ResponsiveContainer>