@using TwilightImperiumUltimate.Web.Helpers.Enums

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-2xl">

    <GridLayout Columns="PlayersCount" Width="60">

    @foreach (var player in GetPlayers())
    {
        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mb-md">
            <Label Text="@player.Name" FontSize="24" CenterText="true" TextColor="@player.PlayerColor.GetTextColor(true)" />
            <Label Text="@player.FactionName.GetFactionUIText(FactionResourceType.Title)" FontSize="24" CenterText="true" TextColor="@player.PlayerColor.GetTextColor(true)" CssClass="mb-sm" />
            <StrategyCardPicker MaxHeight="300" StrategyCards="_strategyCards" Player="@player" />
        </ResponsiveContainer>
    }

    </GridLayout>

</ResponsiveContainer>
