@using TwilightImperiumUltimate.Web.Helpers.Enums

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-lg">

    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Width="60">

        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
            <Label Text="!This Game Winner!" CenterText="true" FontSize="32" TextColor="@Winner.PlayerColor.GetTextColor(true)" CssClass="mb-sm" />
            <Label Text="@Winner.Name" CenterText="true" FontSize="32" TextColor="@Winner.PlayerColor.GetTextColor(true)" CssClass="mb-sm" />
            <Label Text="@Winner.FactionName.GetFactionUIText(FactionResourceType.Title)" CenterText="true" FontSize="32" TextColor="@Winner.PlayerColor.GetTextColor(true)" CssClass="mb-md" />

            <img src="@PathProvider.GetIconPath(IconType.WinnerTrophy)" style="max-height: 300px;" />

        </ResponsiveContainer>

        <PlayersGrid />

    </ResponsiveContainer>

</ResponsiveContainer>
