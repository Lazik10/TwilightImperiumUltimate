@using TwilightImperiumUltimate.Web.Components.PreviewSlices

<div class="milty-draft-slice" style="@(IsColorless())">
    <ResponsiveCard CssClass="slice-detail-card" OnClick="PickSlice" IsDisabled="IsDisabled()">
        <ResponsiveLabel Text="@GetSliceOwnerLabel()" TextColor="@GetSliceOwnerTextColor()" CenterText="true" CssClass="mb-sm" />
        <SlicePreview SliceModel="SliceModel" ArchiveLayout="true" ShowName="false" />
    </ResponsiveCard>
</div>
