@using TwilightImperiumUltimate.Web.Helpers.Enums

<div style="@(IsColorless())">
    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
        <Label Text="@(Initiative.GetDisplayName())" FontSize="24" TextColor="Color.GetTextColor(!IsPicked)" CenterText="true" CssClass="mb-sm" />

        <ResponsiveButton ButtonText="@Strings.MiltyDraft_PickOption" OnClick="PickInitiative" IsDisabled="IsDisabled()" Width="100" />

    </ResponsiveContainer>
</div>
