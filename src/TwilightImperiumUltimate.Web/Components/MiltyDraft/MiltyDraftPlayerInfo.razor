@using TwilightImperiumUltimate.Web.Helpers.Enums

<ResponsiveCard CssClass="milty-draft-player-info mt-sm">
    <div class="milty-draft-player-info-content">
        <ResponsiveGridContainer Columns="1" TabletColumns="1" MobileColumns="1" Width="100" Gap="var(--space-sm)">
            <ResponsiveLabel Text="@GetPlayerName()" TextColor="@TextColor" CenterText="true" FontSize="2xl" Truncate="true" CssClass="milty-draft-player-info-name" />

            <ResponsiveLabel Text="@Strings.MiltyDraft_PlayerFaction" TextColor="@TextColor" FontSize="md" Truncate="true" CssClass="milty-draft-player-info-detail-label" />
            <ResponsiveLabel Text="@GetFactionText()" TextColor="@TextColor" CenterText="true" FontSize="md" Truncate="true" />

            <ResponsiveLabel Text="@Strings.MiltyDraft_PlayerInitiative" TextColor="@TextColor" FontSize="md" Truncate="true" CssClass="milty-draft-player-info-detail-label" />
            <ResponsiveLabel Text="@GetInitiativeText()" TextColor="@TextColor" CenterText="true" FontSize="md" Truncate="true" />

            <ResponsiveLabel Text="@Strings.PlacementStyle_Slice" TextColor="@TextColor" FontSize="md" Truncate="true" CssClass="milty-draft-player-info-detail-label" />
            <ResponsiveLabel Text="@GetSliceId()" TextColor="@TextColor" CenterText="true" FontSize="md" Truncate="true" />
        </ResponsiveGridContainer>
    </div>

</ResponsiveCard>
