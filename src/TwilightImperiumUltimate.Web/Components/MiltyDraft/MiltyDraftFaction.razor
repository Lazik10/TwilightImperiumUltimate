@using TwilightImperiumUltimate.Web.Helpers.Enums

<ResponsiveButton OnClick="OnClick" IsDisabled="IsDisabled" Style="width: 100%; background: transparent; border: 0; padding: 0;" aria-label="@Faction.ToString()">
    <div style="height: 100%; filter: @(ApplyGreyscale()); -webkit-filter: @(ApplyGreyscale())">
        <div class="link responsive-icon">
            <img class="icon"
                 src="@GetFactionImage()"
                 alt=""
                 title="@Faction.ToString()"
                 style="filter: @(ApplyGreyscale()); -webkit-filter: @(ApplyGreyscale())" />
        </div>
    </div>
</ResponsiveButton>
