<ResponsiveTabMenu AriaLabel="@Strings.MiltyDraft_Title_PageTitle" CssClass="faction-style mb-md">
    <ResponsiveTab Id="milty-draft-draft-tab"
                   IsActive="@(SelectedMenuItem == MiltyDraftMenuItem.Draft)"
                   OnClick="() => OnMenuItemClick.InvokeAsync(MiltyDraftMenuItem.Draft)">
        @Strings.MiltyDraft_Draft
    </ResponsiveTab>
    <ResponsiveTabSeparator />
    <ResponsiveTab Id="milty-draft-map-tab"
                   IsActive="@(SelectedMenuItem == MiltyDraftMenuItem.Map)"
                   OnClick="() => OnMenuItemClick.InvokeAsync(MiltyDraftMenuItem.Map)">
        @Strings.MiltyDraft_DraftPreview
    </ResponsiveTab>
    <ResponsiveTabSeparator />
    <ResponsiveTab Id="milty-draft-settings-tab"
                   IsActive="@(SelectedMenuItem == MiltyDraftMenuItem.Settings)"
                   OnClick="() => OnMenuItemClick.InvokeAsync(MiltyDraftMenuItem.Settings)">
        @Strings.MiltyDraft_Settings
    </ResponsiveTab>
</ResponsiveTabMenu>
