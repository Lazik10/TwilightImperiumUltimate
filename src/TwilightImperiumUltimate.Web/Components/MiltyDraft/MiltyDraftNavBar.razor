<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
    <div class="milty-draft-navbar">
        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Width="100" JustifyContent="Enums.JustifyContent.SpaceEvenly">
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(MiltyDraftMenuItem.Draft)">
                <ResponsiveLabel Text="@Strings.MiltyDraft_Draft" CenterText="true" FontSize="base" />
            </TabNavItem>
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(MiltyDraftMenuItem.Map)">
                <ResponsiveLabel Text="@Strings.MiltyDraft_DraftPreview" CenterText="true" FontSize="base" />
            </TabNavItem>
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(MiltyDraftMenuItem.Settings)">
                <ResponsiveLabel Text="@Strings.MiltyDraft_Settings" CenterText="true" FontSize="base" />
            </TabNavItem>
        </ResponsiveContainer>
    </div>
</ResponsiveContainer>
