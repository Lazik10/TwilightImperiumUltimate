@using TwilightImperiumUltimate.Web.Components.MapGenerator
@using TwilightImperiumUltimate.Web.Helpers.Enums

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

    @if (MiltyDraftService.State == MiltyDraftState.Initialized)
    {
        <Label Text="@Strings.MiltyDraft_DraftNotInProgress" FontSize="32" CenterText="true" CssClass="mt-2xl mb-2xl" />
    }
    else
    {
        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexEnd" CssClass="mt-2xl mb-sm">
            <span class="mr-sm"><QuickMenuItem IconType="IconType.CopyMapString" IconTypeClicked="IconType.CopyMapStringClicked" OnClick="HandleCopyMapString" /></span>
            <QuickMenuItem IconType="IconType.DownloadMapImage" IconTypeClicked="IconType.DownloadMapImageClicked" OnClick="HandleDownloadImage" />
        </ResponsiveContainer>

        <div id="draftpreviewArea" class="mb-3xl">

            <GridLayout Columns="3" Width="100" Gap="10" AlignItems="stretch" CssClass="mb-md">

                @if (Players is not null && Players.Count > 0)
                {
                    foreach (var player in Players)
                    {
                        <MiltyDraftPlayerInfo Player="@player" />
                    }
                }

            </GridLayout>

            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart" CssClass="mb-md">
                <Label Text="@Strings.MiltyDraft_MapString" TextColor="TextColor.Green" FontSize="24" Width="15" />
                <Label Text="@MapTtsString()" CenterText="true" FontSize="18"/>
            </ResponsiveContainer>

            @if (IsSupportedPreviewMap())
            {
                @DynamicComponent
            }

        </div>
    }

</ResponsiveContainer>
