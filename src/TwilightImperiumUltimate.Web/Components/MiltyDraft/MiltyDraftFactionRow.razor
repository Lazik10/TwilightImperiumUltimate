
<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="background mt-sm mb-sm">

    <GridLayout Width="100" Gap="10" Columns="GetGridColumns()">

        @if (GetMiltyDraftState() == MiltyDraftState.Initialized)
        {
            for (int i = 0; i < MiltyDraftSettingsService.NumberOfFactions; i++)
            {
                <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
                    <MiltyDraftFaction Faction="FactionName.None" />
                    <ResponsiveButton ButtonText="@Strings.MiltyDraft_PickOption" IsDisabled="true" Width="100" CssClass="mt-sm" />
                </ResponsiveContainer>
            }
        }
        else
        {
            @foreach (var faction in DraftedFactions)
            {
                <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
                    <MiltyDraftFaction Faction="faction.FactionName" IsPicked="faction.IsPicked" Color="faction.Color" IsColorless="IsColorless(faction)" />
                    <ResponsiveButton ButtonText="@Strings.MiltyDraft_PickOption" OnClick="async () => await PickFaction(faction)" IsDisabled="IsDisabled(faction)" Width="100" CssClass="mt-sm" />
                </ResponsiveContainer>
            }
        }

    </GridLayout>

</ResponsiveContainer>
