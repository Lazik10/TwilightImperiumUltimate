
<div class="milty-draft-faction-grid">

    @if (GetMiltyDraftState() == MiltyDraftState.Initialized)
    {
        for (int i = 0; i < MiltyDraftSettingsService.NumberOfFactions; i++)
        {
            <div class="milty-draft-faction-item">
                <MiltyDraftFaction Faction="FactionName.None" IsDisabled="true" />
                <ResponsiveLabel Text="Unpicked" TextColor="TextColor.White" CenterText="true" CssClass="mt-sm" />
            </div>
        }
    }
    else
    {
        @foreach (var faction in DraftedFactions)
        {
            <div class="milty-draft-faction-item">
                <MiltyDraftFaction Faction="faction.FactionName" IsPicked="faction.IsPicked" Color="faction.Color" IsColorless="IsColorless(faction)" IsDisabled="IsDisabled(faction)" OnClick="async () => await PickFaction(faction)" />
                <ResponsiveLabel Text="@GetFactionLabel(faction)" TextColor="@GetFactionTextColor(faction)" CenterText="true" CssClass="mt-sm" />
            </div>
        }
    }

</div>
