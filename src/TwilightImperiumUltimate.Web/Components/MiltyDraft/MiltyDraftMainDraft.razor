@using TwilightImperiumUltimate.Web.Components.MapGenerator
@using TwilightImperiumUltimate.Web.Helpers.Enums

@if ((Initiatives is not null && Initiatives.Count > 0
     && Slices is not null && Slices.Count > 0
     && DraftState == MiltyDraftState.Initialized) ||
    (Initiatives is not null && Initiatives.Count > 0
    && Slices is not null && Slices.Count > 0
    && DraftedFactions is not null && DraftedFactions.Count > 0
    && DraftState != MiltyDraftState.Initialized))
{
    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-md">

        <ResponsiveButton ButtonText="@(GetButtonText())" OnClick="StartMiltyDraft" IsDisabled="GetButtonStatus()" Width="30" />

        @if (IsImportedSlicesEnabledAndImportedStringInvalid().Result)
        {
            <HelpText Text="@Strings.MiltyDraft_InvalidImportedSlicesStringFormat" TextColor="TextColor.Red" CssClass="mt-md" />
        }

        @if (DraftState == MiltyDraftState.Started && !MiltyDraftService.FirstPickAssigned)
        {
            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="mt-md">
                <ResponsiveButton ButtonText="@Strings.MiltyDraft_NewPickOrder" OnClick="NewPickOrder" Width="30" />
                <ResponsiveButton ButtonText="@Strings.MiltyDraft_NewFactions" OnClick="NewFactions" Width="30" />
                <ResponsiveButton ButtonText="@Strings.MiltyDraft_NewSlices" OnClick="NewSlices" Width="30" />
            </ResponsiveContainer>
        }

        <div style="border: 10px solid @(DraftState == MiltyDraftState.Started ? MiltyDraftService.ActivePlayer.PlayerColor.GetUIColor() : "transparent"); width: 100%; padding-left: 10px; padding-right: 10px;" class="mt-2xl">

            @if (DraftState == MiltyDraftState.Started)
            {
                <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="background mt-sm">

                    <GridLayout Columns="3" Gap="0" Width="100" CssClass="mb-md">
                        <Label Text="@Strings.MiltyDraft_ActivePlayer" FontSize="24" TextColor="TextColor.Green" PaddingLeft="40" />
                        <Label Text="@GetPlayerName(ActivePlayer)" FontSize="36" CenterText="true" TextColor="ActivePlayerColor.GetTextColor()" />
                    </GridLayout>

                    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="mb-sm">
                        <Label Text="@Strings.MiltyDraft_NextPicks" TextColor="TextColor.White" PaddingLeft="20" />
                        @foreach (var player in PlayersOrderOfPicks)
                        {
                            <Label Text="@GetPlayerName(player)" TextColor="player.PlayerColor.GetTextColor()" />
                        }
                    </ResponsiveContainer>

                </ResponsiveContainer>
            }
            else if (DraftState == MiltyDraftState.Finished)
            {
                <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="background">

                    <Label Text="@Strings.MiltyDraft_Finnished" FontSize="36" TextColor="TextColor.Green" CenterText="true" CssClass="mt-sm" />

                </ResponsiveContainer>
            }

            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexEnd" CssClass="mt-xl">
                <QuickMenuItem IconType="IconType.DownloadMapImage" IconTypeClicked="IconType.DownloadMapImageClicked" OnClick="HandleDownloadImage" />
            </ResponsiveContainer>

            <div id="draftArea">

                <Label Text="@Strings.MiltyDraft_Positions" TextColor="TextColor.Green" FontSize="24" PaddingLeft="20" />

                <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="background mt-sm">

                    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="mb-sm">
                        @foreach (var initiative in Initiatives)
                        {
                            <CascadingValue Value="this" Name="MiltyDraftMainDraft">
                                <MiltyDraftInitiativeOrder Initiative="initiative.Initiative" FontSize="28" IsPicked="initiative.Picked" Color="initiative.DraftColor" />
                            </CascadingValue>
                        }
                    </ResponsiveContainer>

                </ResponsiveContainer>

                <Label Text="@Strings.MiltyDraft_Factions" TextColor="TextColor.Green" FontSize="24" PaddingLeft="20" CssClass="mt-2xl" />

                <CascadingValue Value="this" Name="MiltyDraftMainDraft">
                    <MiltyDraftFactionRow DraftedFactions="DraftedFactions"/>
                </CascadingValue>

                <Label Text="@Strings.MiltyDraft_Slices" TextColor="TextColor.Green" FontSize="24" PaddingLeft="20" CssClass="mt-2xl" />

                <GridLayout Width="100" Gap="10" Columns="3">

                    @foreach (var slice in Slices)
                    {
                        <CascadingValue Value="this" Name="MiltyDraftMainDraft">
                            <MiltyDraftSlice SliceModel="slice" />
                        </CascadingValue>
                    }

                    @for (var i = 0; i < (3 - (Slices.Count % 3)); i++)
                    {
                        <div class="background" style="width: 100%; height: 100%;" />    
                    }

                </GridLayout>

            </div>

        </div>

    </ResponsiveContainer>
}
else
{
    <Title Text="@Strings.MiltyDraft_GeneratingDraft" FontSize="32" CssClass="mt-3xl" />
}