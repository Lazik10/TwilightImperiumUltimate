@using TwilightImperiumUltimate.Web.Components.MapGenerator
@using TwilightImperiumUltimate.Web.Helpers.Enums

<div class="milty-draft-main">
    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-md">

        <ResponsiveButton ButtonText="@(GetButtonText())" OnClick="StartMiltyDraft" IsDisabled="GetButtonStatus()" Width="30" CssClass="mt-xl milty-draft-primary-action" Style="--responsive-button-mobile-width: 80%; white-space: nowrap;" />

        @if (IsImportedSlicesEnabledAndImportedStringInvalid().Result)
        {
            <HelpText Text="@Strings.MiltyDraft_InvalidImportedSlicesStringFormat" TextColor="TextColor.Red" CssClass="mt-md" />
        }

        @if (DraftState == MiltyDraftState.Started && !MiltyDraftService.FirstPickAssigned)
        {
            <div class="milty-draft-regeneration-actions">
                <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.SpaceBetween" CssClass="mt-md">
                    <ResponsiveButton ButtonText="@Strings.MiltyDraft_NewPickOrder" OnClick="NewPickOrder" Width="30" MobileWidth="80" CssClass="milty-draft-first-regeneration-action" Style="white-space: nowrap;" />
                    <ResponsiveButton ButtonText="@Strings.MiltyDraft_NewFactions" OnClick="NewFactions" Width="30" MobileWidth="80" Style="white-space: nowrap;" />
                    <ResponsiveButton ButtonText="@Strings.MiltyDraft_NewSlices" OnClick="NewSlices" Width="30" MobileWidth="80" Style="white-space: nowrap;" />
                </ResponsiveContainer>
            </div>
        }

        <div style="width: 100%; padding-left: 10px; padding-right: 10px;">

            @if (DraftState == MiltyDraftState.Started)
            {
                <ResponsiveCard CssClass="mt-xl mb-xs">
                    <ResponsiveHeading Level="5" Text="Picking" CenterText="true" CssClass="mb-xs" />

                    <ResponsiveHeading Level="2" Text="@GetPlayerName(ActivePlayer)" CenterText="true" CssClass="mb-md" Style="@($"color: {ActivePlayerColor.GetTextColor().ConvertToString()} !important;")" />

                    <div class="milty-draft-next-picks">
                        <ResponsiveGridContainer Columns="7" TabletColumns="4" MobileColumns="2" Width="100" Gap="var(--space-xs)" CssClass="milty-draft-next-picks-grid mb-sm">
                            <ResponsiveLabel Text="@Strings.MiltyDraft_NextPicks" TextColor="TextColor.White" CssClass="milty-draft-next-picks-label" />
                            @foreach (var player in PlayersOrderOfPicks)
                            {
                                <ResponsiveLabel Text="@GetPlayerName(player)" TextColor="player.PlayerColor.GetTextColor()" CenterText="true" Truncate="true" CssClass="milty-draft-next-picks-player" />
                            }
                        </ResponsiveGridContainer>
                    </div>

                </ResponsiveCard>
            }
            else if (DraftState == MiltyDraftState.Finished)
            {
                <ResponsiveCard CssClass="mt-xl mb-xs">
                    <ResponsiveHeading Level="2" Text="@Strings.MiltyDraft_Finnished" CenterText="true" CssClass="mb-0" />
                </ResponsiveCard>
            }

            <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexEnd" CssClass="mb-sm">
                <QuickMenuItem IconType="IconType.DownloadMapImage" IconTypeClicked="IconType.DownloadMapImageClicked" OnClick="HandleDownloadImage" />
            </ResponsiveContainer>

            <div id="draftArea">

                <ResponsiveCard CssClass="mt-sm">
                    <ResponsiveHeading Level="3" Text="@Strings.MiltyDraft_Positions.TrimEnd(':')" CenterText="true" CssClass="mb-sm" />

                    @if (Initiatives.Count > 0)
                    {
                        <GridLayout Columns="3" Gap="10" Width="100" CssClass="mb-sm">
                            @foreach (var initiative in Initiatives)
                            {
                                <CascadingValue Value="this" Name="MiltyDraftMainDraft">
                                    <MiltyDraftInitiativeOrder Initiative="initiative.Initiative" FontSize="28" IsPicked="initiative.Picked" Color="initiative.DraftColor" />
                                </CascadingValue>
                            }
                        </GridLayout>
                    }
                    else
                    {
                        <ResponsiveLabel Text="@Strings.MiltyDraft_GeneratingDraft" CenterText="true" CssClass="mb-sm" />
                    }

                </ResponsiveCard>

                <ResponsiveCard CssClass="mt-lg">
                    <ResponsiveHeading Level="3" Text="@Strings.MiltyDraft_Factions.TrimEnd(':')" CenterText="true" CssClass="mb-sm" />

                    <CascadingValue Value="this" Name="MiltyDraftMainDraft">
                        <MiltyDraftFactionRow DraftedFactions="DraftedFactions" />
                    </CascadingValue>
                </ResponsiveCard>

                <ResponsiveCard CssClass="milty-draft-slices-header-card mt-lg mb-sm">
                    <ResponsiveHeading Level="3" Text="@Strings.MiltyDraft_Slices.TrimEnd(':')" CenterText="true" />
                </ResponsiveCard>

                @if (Slices.Count > 0)
                {
                    <div class="milty-draft-slices-grid">
                        @foreach (var slice in Slices)
                        {
                            <CascadingValue Value="this" Name="MiltyDraftMainDraft">
                                <MiltyDraftSlice SliceModel="slice" />
                            </CascadingValue>
                        }
                    </div>
                }
                else
                {
                    <ResponsiveLabel Text="@Strings.MiltyDraft_GeneratingDraft" CenterText="true" CssClass="mb-sm" />
                }

            </div>

        </div>

    </ResponsiveContainer>
</div>