<ResponsiveTabMenu AriaLabel="@Strings.Page_MapGenerator_PageTitle" CssClass="faction-style mb-md">
    <ResponsiveTab Id="map-generator-map-tab"
                   IsActive="@(SelectedMenuItem == MapGeneratorMenuItem.MapGenerator)"
                   OnClick="() => OnMenuItemClick.InvokeAsync(MapGeneratorMenuItem.MapGenerator)">
        @Strings.MapGeneratorMenu_Map
    </ResponsiveTab>
    <ResponsiveTabSeparator />
    <ResponsiveTab Id="map-generator-stats-tab"
                   IsActive="@(SelectedMenuItem == MapGeneratorMenuItem.MapEvaluation)"
                   OnClick="() => OnMenuItemClick.InvokeAsync(MapGeneratorMenuItem.MapEvaluation)">
        @Strings.MapGeneratorMenu_Stats
    </ResponsiveTab>
    <ResponsiveTabSeparator />
    <ResponsiveTab Id="map-generator-settings-tab"
                   IsActive="@(SelectedMenuItem == MapGeneratorMenuItem.Settings)"
                   OnClick="() => OnMenuItemClick.InvokeAsync(MapGeneratorMenuItem.Settings)">
        @Strings.MapGeneratorMenu_Settings
    </ResponsiveTab>
</ResponsiveTabMenu>