<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
    <div class="map-generator-navbar">
        <ResponsiveContainer Type="ContainerType.Flex" Padding="none" Width="100" JustifyContent="Enums.JustifyContent.SpaceEvenly">
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(MapGeneratorMenuItem.MapGenerator)">
                <ResponsiveLabel Text="@Strings.MapGeneratorMenu_Map" CenterText="true" FontSize="base" />
            </TabNavItem>
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(MapGeneratorMenuItem.MapEvaluation)">
                <ResponsiveLabel Text="@Strings.MapGeneratorMenu_Stats" CenterText="true" FontSize="base" />
            </TabNavItem>
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(MapGeneratorMenuItem.Settings)">
                <ResponsiveLabel Text="@Strings.MapGeneratorMenu_Settings" CenterText="true" FontSize="base" />
            </TabNavItem>
        </ResponsiveContainer>
    </div>
</ResponsiveContainer>