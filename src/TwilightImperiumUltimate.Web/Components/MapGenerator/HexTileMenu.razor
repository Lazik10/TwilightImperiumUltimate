@using TwilightImperiumUltimate.Web.Resources
@using TwilightImperiumUltimate.Web.Services.MapGenerators
@inject IMapGeneratorSettingsService MapGeneratorSettingsService

<div class="hex-menu">

    <ResponsiveButton OnClick="ToggleTileMenu"
                      ButtonText="@GetButtonText()"
                      CssClass="tile-menu-toggle" />

    @if (_showTileMenu)
    {
        <ResponsiveCard CssClass="tile-menu-card">
            <div class="tile-menu-content">
                <ResponsiveDropDown Id="hex-tile-menu-filter"
                                      TValue="SystemTileTypeFilter"
                                      Value="@_selectedSystemTileType"
                                      ValueChanged="@(v => { _selectedSystemTileType = v; GetSystemTilesToShow(); })"
                                      Data="@_systemTileTypes"
                                      TextProperty="Value"
                                      ValueProperty="Key"
                                      Style="min-height: 40px;"
                                      CssClass="title radzen-dropdown" />

                <div class="scrollbar-area">
                    @foreach (var systemTile in SystemTiles)
                    {
                        <MapHexTile @key="systemTile.SystemTileName"
                                    SystemTile="systemTile"
                                    MapPosition="-1"
                                    SwappedSystemTileFromMenu="RefreshSystemTilesMenu" />
                    }
                </div>
            </div>
        </ResponsiveCard>
    }
</div>
