@using TwilightImperiumUltimate.Web.Components.Shared.Controls
@using TwilightImperiumUltimate.Web.Components.Factions
@using TwilightImperiumUltimate.Web.Components.Shared.Layouts
@using TwilightImperiumUltimate.Web.Components.Shared.Text
@using TwilightImperiumUltimate.Web.Resources

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
    <ResponsiveCard CssClass="mb-md">
        <ResponsiveHeading Level="4" Text="General" CenterText="true" CssClass="mb-sm" />

        <ResponsiveGridContainer Columns="2" TabletColumns="2" MobileColumns="1" Width="100" Gap="var(--space-xl)">
            <ResponsiveDropDown Id="map-generator-settings-map-template"
                                TValue="MapTemplate"
                                Label="@Strings.MapGeneratorSettings_MapTemplate.TrimEnd(':')"
                                LabelPosition="LabelPosition.Column"
                                Value="@SelectedMapTemplate"
                                ValueChanged="SetMapTemplate"
                                Data="@_mapTemplates"
                                ValueProperty="Key"
                                TextProperty="Value" />

            <ResponsiveDropDown Id="map-generator-settings-placement-style"
                                TValue="PlacementStyle"
                                Label="@Strings.MapGeneratorSettings_PlacementStyle.TrimEnd(':')"
                                LabelPosition="LabelPosition.Column"
                                Value="@SelectedPlacementStyle"
                                ValueChanged="SetPlacementStyle"
                                Data="@_placementStyles"
                                ValueProperty="Key"
                                TextProperty="Value" />

            <ResponsiveDropDown Id="map-generator-settings-system-weight"
                                TValue="SystemWeight"
                                Label="@Strings.MapGeneratorSettings_SystemWeight.TrimEnd(':')"
                                LabelPosition="LabelPosition.Column"
                                Value="@SelectedSystemWeight"
                                ValueChanged="SetSystemWeight"
                                Data="@_systemWeights"
                                ValueProperty="Key"
                                TextProperty="Value" />
        </ResponsiveGridContainer>
    </ResponsiveCard>

    <ResponsiveCard CssClass="mb-md">
        <ResponsiveHeading Level="4" Text="Overlays" CenterText="true" CssClass="mb-sm" />

        <ResponsiveGridContainer Columns="2" TabletColumns="2" MobileColumns="1" Width="100" Gap="var(--space-xl)">
            <ResponsiveDropDown Id="map-generator-settings-map-overlay"
                                TValue="SystemTileOverlay"
                                Label="Map"
                                LabelPosition="LabelPosition.Column"
                                Value="@SelectedMapOverlay"
                                ValueChanged="SetMapOverlay"
                                Data="@_systemTileOverlays"
                                ValueProperty="Key"
                                TextProperty="Value" />

            <ResponsiveDropDown Id="map-generator-settings-menu-overlay"
                                TValue="SystemTileOverlay"
                                Label="Menu"
                                LabelPosition="LabelPosition.Column"
                                Value="@SelectedMenuOverlay"
                                ValueChanged="SetMenuOverlay"
                                Data="@_systemTileOverlays"
                                ValueProperty="Key"
                                TextProperty="Value" />
        </ResponsiveGridContainer>
    </ResponsiveCard>

    <ResponsiveCard CssClass="mb-md">
        <ResponsiveHeading Level="4" Text="@Strings.MapGeneratorSettings_SystemTiles.TrimEnd(':')" CenterText="true" CssClass="mb-sm" />

        <ResponsiveGridContainer Columns="2" TabletColumns="2" MobileColumns="1" Width="100" Gap="var(--space-xl)">
            <ResponsiveDropDown Id="map-generator-settings-prophecy-of-kings" TValue="bool" Label="@Strings.GameVersion_ProphecyOfKings" LabelPosition="LabelPosition.Column" Value="@MapGeneratorSettingsService.GameVersions.Contains(GameVersion.ProphecyOfKings)" ValueChanged="value => SetGameVersion(GameVersion.ProphecyOfKings, value)" Data="@BooleanOptions" ValueProperty="Key" TextProperty="Value" />

            <ResponsiveDropDown Id="map-generator-settings-thunders-edge" TValue="bool" Label="@Strings.GameVersion_ThundersEdge" LabelPosition="LabelPosition.Column" Value="@MapGeneratorSettingsService.GameVersions.Contains(GameVersion.ThundersEdge)" ValueChanged="value => SetGameVersion(GameVersion.ThundersEdge, value)" Data="@BooleanOptions" ValueProperty="Key" TextProperty="Value" />

            <ResponsiveDropDown Id="map-generator-settings-uncharted-space" TValue="bool" Label="@Strings.GameVersion_UnchartedSpace" LabelPosition="LabelPosition.Column" Value="@MapGeneratorSettingsService.GameVersions.Contains(GameVersion.UnchartedSpace)" ValueChanged="value => SetGameVersion(GameVersion.UnchartedSpace, value)" Data="@BooleanOptions" ValueProperty="Key" TextProperty="Value" />
        </ResponsiveGridContainer>
    </ResponsiveCard>

    <ResponsiveCard CssClass="mb-md">
        <ResponsiveHeading Level="4" Text="Other" CenterText="true" CssClass="mb-sm" />

        <ResponsiveGridContainer Columns="2" TabletColumns="2" MobileColumns="1" Width="100" Gap="var(--space-xl)">
            <ResponsiveDropDown Id="map-generator-enable-faction-pick" TValue="bool" Label="@Strings.MapGeneratorSettings_EnableFactionPick.TrimEnd(':')" LabelPosition="LabelPosition.Column" Value="@MapGeneratorSettingsService.EnableFactionPick" ValueChanged="OnFactionPickChanged" Data="@BooleanOptions" ValueProperty="Key" TextProperty="Value" />

            <ResponsiveDropDown Id="map-generator-settings-legendary-planets" TValue="int" Label="@Strings.MapGeneratorSettings_NumberOfLegendaryPlanets.TrimEnd(':')" LabelPosition="LabelPosition.Column" Value="@MapGeneratorSettingsService.NumberOfLegendaryPlanets" ValueChanged="SetNumberOfLegendaryPlanets" Data="@GetLegendaryPlanetOptions()" />

            <ResponsiveDropDown Id="map-generator-settings-legendaries-in-equidistant" TValue="bool" Label="@Strings.MapGeneratorSettings_LegendariesInEquidistant.TrimEnd(':')" LabelPosition="LabelPosition.Column" Value="@MapGeneratorSettingsService.LegendaryPriorityInEquidistant" ValueChanged="SetLegendaryPriorityInEquidistant" Data="@BooleanOptions" ValueProperty="Key" TextProperty="Value" />

            <ResponsiveDropDown Id="map-generator-settings-wormhole-density" TValue="WormholeDensity" Label="@Strings.WormholeDensityPicker_WormholeDensity.TrimEnd(':')" LabelPosition="LabelPosition.Column" Value="@MapGeneratorSettingsService.WormholeDensity" ValueChanged="SetWormholeDensity" Data="@_wormholeDensities" ValueProperty="Key" TextProperty="Value" />

            <ResponsiveDropDown Id="map-generator-settings-enable-player-names" TValue="bool" Label="@Strings.MapGeneratorSettings_EnablePlaerNames.TrimEnd(':')" LabelPosition="LabelPosition.Column" Value="@MapGeneratorSettingsService.EnablePlayerNames" ValueChanged="SetPlayerNamesEnabled" Data="@BooleanOptions" ValueProperty="Key" TextProperty="Value" />
        </ResponsiveGridContainer>
    </ResponsiveCard>

    @if (MapGeneratorSettingsService.EnableFactionPick)
    {
        <FactionMenuPicker ProvidedFactions="@MapGeneratorSettingsService.FactionsForMapGenerator" OnFactionChanged="OnFactionChanged" />
    }

    @if (MapGeneratorSettingsService.EnablePlayerNames)
    {
        <ResponsiveCard CssClass="mb-md">
            <ResponsiveHeading Level="4" Text="@Strings.MapGeneratorSettings_EnablePlaerNames.TrimEnd(':')" CenterText="true" CssClass="mb-sm" />

            <ResponsiveGridContainer Columns="2" TabletColumns="2" MobileColumns="1" Width="100" Gap="var(--space-xl)">
                @foreach (var player in MapGeneratorSettingsService.Players)
                {
                    <ResponsiveTextBox Id="@($"map-generator-player-name-{MapGeneratorSettingsService.Players.IndexOf(player)}")" Value="@player.PlayerName" ValueChanged="value => player.PlayerName = value" Placeholder="@Strings.Player" />
                }
            </ResponsiveGridContainer>
        </ResponsiveCard>
    }
</ResponsiveContainer>
