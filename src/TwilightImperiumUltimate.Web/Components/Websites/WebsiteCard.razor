@inherits TwilightImperiumBaseComponent

<article class="website-card">
    <a class="website-card-link" href="@WebsitePath" target="_blank" rel="noopener noreferrer">
        <div class="website-card-image">
            <img src="@GetWebsiteIconPath()" alt="@Title" />
        </div>
        <Label Text="@Title" FontSize="16" CenterText="true" CssClass="website-card-title" />
    </a>
</article>

