@using TwilightImperiumUltimate.Web.Helpers.Enums

<RadzenTableRow>
    <RadzenTableCell>
        <GridButtonColumn Text="@Ranking.TiglUserName" Href="@GetProfileUrl(Ranking.Id)" TextColor="@RankColor" />
    </RadzenTableCell>
    <RadzenTableCell>
        <Label Text="@GetPrestigeRankText()" CenterText="true" TextColor="@RankColor" />
    </RadzenTableCell>
    <RadzenTableCell>
        <Label Text="@GetRankText()" CenterText="true" TextColor="@RankColor" />
    </RadzenTableCell>
    <RadzenTableCell>
        <Label Text="@Ranking.GamesPlayed.ToString(CultureInfo.InvariantCulture)" CenterText="true" TextColor="@RankColor" />
    </RadzenTableCell>
    <RadzenTableCell>
        <Label Text="@GetDurationTime()" CenterText="true" TextColor="@RankColor" />
    </RadzenTableCell>
</RadzenTableRow>
