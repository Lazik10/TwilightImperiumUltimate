@using TwilightImperiumUltimate.Web.Helpers.Enums

<RadzenTableRow class="rank-player-row"
                tabindex="0"
                role="link"
                @onclick="() => NavigateToProfile(Ranking.Id)"
                @onkeydown="OnRowKeyDown">
    <RadzenTableCell>
        <ResponsiveLabel Text="@Ranking.TiglUserName" CenterText="false" TextColor="@RankColor" UseHandelStyling="false" CssClass="rank-player-name" Style="@GetPlayerNameStyle()" />
    </RadzenTableCell>
    <RadzenTableCell>
                    <ResponsiveLabel Text="@GetPrestigeRankText()" CenterText="true" TextColor="@RankColor" UseHandelStyling="false" Style="@GetRankColorStyle()" />
    </RadzenTableCell>
    <RadzenTableCell>
                    <ResponsiveLabel Text="@GetRankText()" CenterText="true" TextColor="@RankColor" UseHandelStyling="false" Style="@GetRankColorStyle()" />
    </RadzenTableCell>
    <RadzenTableCell>
                    <ResponsiveLabel Text="@Ranking.GamesPlayed.ToString(CultureInfo.InvariantCulture)" CenterText="true" TextColor="@RankColor" UseHandelStyling="false" Style="@GetRankColorStyle()" />
    </RadzenTableCell>
    <RadzenTableCell>
                    <ResponsiveLabel Text="@GetDurationTime()" CenterText="true" TextColor="@RankColor" UseHandelStyling="false" Style="@GetRankColorStyle()" />
    </RadzenTableCell>
</RadzenTableRow>
