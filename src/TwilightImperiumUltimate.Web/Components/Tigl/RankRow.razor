@using TwilightImperiumUltimate.Web.Helpers.Enums

<ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="background mb-xs" OnClick="@(() => NavigateToProfile(Ranking.Id))">

    <Label Text="@Ranking.TiglUserName" Width="30" PaddingLeft="50" TextColor="@RankColor" />
    <Label Text="@GetPrestigeRankText()" CenterText=true Width="30" TextColor="@RankColor" />
    <Label Text="@GetRankText()" CenterText=true Width="30" TextColor="@RankColor" />
    <Label Text="@Ranking.GamesPlayed.ToString()" CenterText=true Width="10" TextColor="@RankColor" />
    <Label Text="@GetDurationTime()" CenterText=true Width="20" TextColor="@RankColor" />

</ResponsiveContainer>