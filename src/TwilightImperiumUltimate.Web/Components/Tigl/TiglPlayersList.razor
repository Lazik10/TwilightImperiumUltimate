<div class="mt-md mb-md">
    <TiglPlayerSearchbar OnSearchUpdate="SearchPlayers" />
</div>

<div class="mb-md">
    <TiglPlayerAlphabet OnLetterClick="FilterByLetter" />
</div>

<StretchHeightContainer CssClass="background">

    @if (Loading)
    {
        <Label Text="@Strings.Loading" FontSize="24" CenterText="true" TextColor="TextColor.White" CssClass="mt-3xl mb-3xl" />
    }
    else if (Users is not null)
    {
        if (!Users.Any())
        {
            <Label Text="@Strings.TiglPlayersList_NoPlayerMatch" FontSize="24" CenterText="true" TextColor="TextColor.White" CssClass="mt-3xl mb-3xl" />
        }
        else if (_filteredUsers is not null && _filteredUsers.Any())
        {
            <div class="players-grid">
                @foreach (var user in _filteredUsers)
                {
                    <TextButton Text="@(GetUserName(user))" FontSize="14" OnClick="() => RedirectToPlayer(user.Id)" />
                }
            </div>
        }
        else
        {
            <Label Text="@Strings.TiglPlayersList_NoPlayerMatch" FontSize="24" CenterText="true" TextColor="TextColor.White" CssClass="mt-3xl mb-3xl" />
        }
    }
    else
    {
        <Label Text="@Strings.TiglPlayersList_NoPlayersFound" FontSize="24" CenterText="true" TextColor="TextColor.White" CssClass="mt-3xl mb-3xl" />
    }

</StretchHeightContainer>
