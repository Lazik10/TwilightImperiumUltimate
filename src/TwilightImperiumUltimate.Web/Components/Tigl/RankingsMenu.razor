<FlexColumnCenteredContainer>
    <div class="ranking-navbar">
        <FlexRowContainer Width="100" JustifyContent="Enums.JustifyContent.SpaceEvenly">
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(RankingsMenuItem.Ranks)">
                <ResponsiveLabel Text="@Strings.RankingsMenu_Ranks" CenterText="true" FontSize="base" />
            </TabNavItem>
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(RankingsMenuItem.Leaders)">
                <ResponsiveLabel Text="@Strings.RankingsMenu_Leaders" CenterText="true" FontSize="base" />
            </TabNavItem>
            <TabNavItem Width="33%" OnClick="() => OnMenuItemClick.InvokeAsync(RankingsMenuItem.Achievements)">
                <ResponsiveLabel Text="@Strings.RankingsMenu_Achievements" CenterText="true" FontSize="base" />
            </TabNavItem>
        </FlexRowContainer>
    </div>
</FlexColumnCenteredContainer>
