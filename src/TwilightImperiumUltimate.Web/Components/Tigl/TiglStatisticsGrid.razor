<StretchHeightContainer >

    <ResponsiveTabMenu AriaLabel="@Strings.TiglStatistics_StatisticType" CssClass="faction-style mt-md mb-md">
        <ResponsiveTab Id="tigl-statistics-tab-factions"
                       ControlsId="tigl-statistics-panel"
                       IsActive="@(_selectedStatisticsType == TiglStatisticsType.Factions)"
                       OnClick="@(() => ChangeStatisticsType(TiglStatisticsType.Factions))">
            @TiglStatisticsType.Factions.GetDisplayName()
        </ResponsiveTab>
        <ResponsiveTabSeparator />
        <ResponsiveTab Id="tigl-statistics-tab-players"
                       ControlsId="tigl-statistics-panel"
                       IsActive="@(_selectedStatisticsType == TiglStatisticsType.Players)"
                       OnClick="@(() => ChangeStatisticsType(TiglStatisticsType.Players))">
            @TiglStatisticsType.Players.GetDisplayName()
        </ResponsiveTab>
        <ResponsiveTabSeparator />
        <ResponsiveTab Id="tigl-statistics-tab-games"
                       ControlsId="tigl-statistics-panel"
                       IsActive="@(_selectedStatisticsType == TiglStatisticsType.Games)"
                       OnClick="@(() => ChangeStatisticsType(TiglStatisticsType.Games))">
            @TiglStatisticsType.Games.GetDisplayName()
        </ResponsiveTab>
    </ResponsiveTabMenu>

    <div id="tigl-statistics-panel" role="tabpanel" aria-labelledby="@ActiveTabId">
        <CascadingValue Value="_selectedSeasonNumber" Name="SelectedSeasonNumber">
            <CascadingValue Value="_selectedLeague" Name="SelectedLeague">

            @if(_selectedStatisticsType == TiglStatisticsType.Factions)
            {
                <TiglStatisticsFactionsGrid />
            }
            else if(_selectedStatisticsType == TiglStatisticsType.Players)
            {
                <TiglStatisticsPlayersGrid />
            }
            else if(_selectedStatisticsType == TiglStatisticsType.Games)
            {
                <TiglStatisticsGamesGrid />
            }

            </CascadingValue>
        </CascadingValue>
    </div>

</StretchHeightContainer>