<StretchHeightContainer >

    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="mt-md">
        <ResponsiveEnumPicker TEnum="TiglStatisticsType"
                    CurrentValue="@_selectedStatisticsType"
                    CurrentValueChanged="@ChangeStatisticsType"
                    Width="100"
                    Label="@Strings.TiglStatistics_StatisticType" />
    </ResponsiveContainer>

    @if (_selectedStatisticsType != TiglStatisticsType.Factions)
    {
        <ResponsiveContainer Type="ContainerType.Flex" Padding="none">
            <SeasonPicker FontSize="md"
                          SeasonNumberChanged="OnSeasonChanged"
                          Width="100" />
        </ResponsiveContainer>

        <ResponsiveContainer Type="ContainerType.Flex" Padding="none">
            <ResponsiveEnumPicker Label="@Strings.TiglLeaderboard_League" TEnum="TiglLeague" CurrentValue="@_selectedLeague" CurrentValueChanged="@OnLeagueChanged" ExcludeValues="new List<TiglLeague> { TiglLeague.Test }" />
        </ResponsiveContainer>
    }

    <div style="height: clamp(0.625rem, 0.625rem + 1vw, 1.25rem);"></div>

    <CascadingValue Value="_selectedSeasonNumber" Name="SelectedSeasonNumber">
        <CascadingValue Value="_selectedLeague" Name="SelectedLeague">

        @if(_selectedStatisticsType == TiglStatisticsType.Factions)
        {
                <TiglStatisticsFactionsGrid />
            }
            else if(_selectedStatisticsType == TiglStatisticsType.Players)
            {
                <TiglStatisticsPlayersGrid />
            }
            else if(_selectedStatisticsType == TiglStatisticsType.Games)
            {
                <TiglStatisticsGamesGrid />
            }
        }

        </CascadingValue>
    </CascadingValue>

</StretchHeightContainer>