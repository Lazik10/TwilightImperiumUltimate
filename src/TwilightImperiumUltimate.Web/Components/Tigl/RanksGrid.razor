<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-md mb-md">

    <ResponsiveEnumPicker TEnum="TiglLeague"
        Label="@Strings.TiglLeague_League"
        CenterText=true CurrentValue="_league" 
        ExcludeValues="new List<TiglLeague>() { TiglLeague.Test }"
        CurrentValueChanged="ChangeLeague"
        Width="50"
        MinChoiceWidth="70"/>

</ResponsiveContainer>

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="background mt-md mb-md">
    <ResponsiveContainer Type="ContainerType.Flex" Padding="none">
        <Label Text="Username" PaddingLeft="50" Width="30" />
        <Label Text="Prestige" CenterText=true Width="30" />
        <Label Text="Rank" CenterText=true Width="30" />
        <Label Text="Games" CenterText=true Width="10" />
        <Label Text="Last Rank Up" CenterText=true Width="20" />
    </ResponsiveContainer>
</ResponsiveContainer>

@if (!_loading)
{
    @if (_groupedRankings?.Count > 0)
    {
        @foreach (var group in _groupedRankings)
        {
            <Label Text="@(group.Key + " (" + group.Value.Count + ")")" CenterText="true" TextColor="TextColor.Yellow" FontSize="16" CssClass="mt-2xl mb-xs"/>

            @foreach (var rank in group.Value)
            {
                <RankRow Ranking="rank" PrestigeRankText="@group.Key" />
            }

            <div style="height: clamp(0.625rem, 0.625rem + 1vw, 1.25rem);"></div>
        }
    }
    else
    {
        <Label Text="No Data" CenterText="true" CssClass="mt-2xl mb-2xl" />
    }
}
else
{
    <Label Text="@Strings.Loading" CenterText="true" CssClass="mt-2xl mb-2xl" />
}