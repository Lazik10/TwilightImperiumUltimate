@*
    Responsive via ResponsiveRadzenTable instead of the old fixed-percentage GridLayout/Label rows.
    Category grouping (GroupRankingsStandard/GroupRankingsFractured in the code-behind) is
    business logic and stays unchanged -- only the rendering of each group/row changed. See
    blazor.instructions.md -- do not reintroduce Components/Shared/Tables/ResponsiveTable or
    ResponsiveGrid, they are obsolete in this codebase.
*@

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-md mb-md">

    <ResponsiveTabMenu AriaLabel="@Strings.TiglLeague_League" CssClass="mb-md">
        <ResponsiveTab Id="ranks-tab-standard"
                       ControlsId="ranks-panel"
                       IsActive="@(_league == TiglLeague.ThundersEdge)"
                       OnClick="@(() => ChangeLeague(TiglLeague.ThundersEdge))">
            @Strings.TiglGames_CategoryStandard
        </ResponsiveTab>
        <ResponsiveTab Id="ranks-tab-fractured"
                       ControlsId="ranks-panel"
                       IsActive="@(_league == TiglLeague.Fractured)"
                       OnClick="@(() => ChangeLeague(TiglLeague.Fractured))">
            @Strings.TiglGames_CategoryFractured
        </ResponsiveTab>
    </ResponsiveTabMenu>

</ResponsiveContainer>

<div id="ranks-panel" role="tabpanel" aria-labelledby="@ActiveTabId">

@if (!_loading)
{
    @if (_groupedRankings?.Count > 0)
    {
        <ResponsiveRadzenTable ZebraStripes="true" CssClass="ranks-table mb-2xl">
            <RadzenTableHeader>
                <RadzenTableRow>
                    <RadzenTableCell class="ranks-header-cell">Username</RadzenTableCell>
                    <RadzenTableCell class="ranks-header-cell">Prestige</RadzenTableCell>
                    <RadzenTableCell class="ranks-header-cell">Rank</RadzenTableCell>
                    <RadzenTableCell class="ranks-header-cell">Games</RadzenTableCell>
                    <RadzenTableCell class="ranks-header-cell">Last Rank Up</RadzenTableCell>
                </RadzenTableRow>
            </RadzenTableHeader>
            <RadzenTableBody>
                @foreach (var group in _groupedRankings)
                {
                    <RadzenTableRow>
                        <RadzenTableCell colspan="5">
                            <div class="rank-group-label">
                                <span style="color: @GetGroupRankColor(group.Value).ConvertToString();">@group.Key</span>
                                <span class="rank-group-count"> (@group.Value.Count)</span>
                            </div>
                        </RadzenTableCell>
                    </RadzenTableRow>

                    @foreach (var rank in group.Value)
                    {
                        <RankRow @key="rank.Id" Ranking="rank" PrestigeRankText="@group.Key" />
                    }
                }
            </RadzenTableBody>
        </ResponsiveRadzenTable>
    }
    else
    {
        <Label Text="No Data" CenterText="true" CssClass="mt-2xl mb-2xl" />
    }
}
else
{
    <Label Text="@Strings.Loading" CenterText="true" CssClass="mt-2xl mb-2xl" />
}

</div>