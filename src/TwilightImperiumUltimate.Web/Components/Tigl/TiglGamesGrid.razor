@using TwilightImperiumUltimate.Contracts.DTOs.Tigl
@using TwilightImperiumUltimate.Contracts.ApiContracts.Tigl.Season
@using TwilightImperiumUltimate.Contracts.Enums

@*
    Standard/Fractured game results, responsive via ResponsiveGridContainer (side-by-side on
    desktop, stacked on tablet/mobile) and ResponsiveRadzenDataGrid (horizontal scroll instead of
    truncation on narrow viewports). See blazor.instructions.md -- do not reintroduce
    Components/Shared/Tables/ResponsiveTable or ResponsiveGrid, they are obsolete in this codebase.
*@

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-md mb-md">

    <ResponsiveDropDown TValue="int"
                        Id="tigl-games-season"
                        Label="@Strings.TiglLeaderboard_Season"
                        Data="@_seasons"
                        TextProperty="@nameof(SeasonDto.SeasonNumber)"
                        ValueProperty="@nameof(SeasonDto.SeasonNumber)"
                        Value="@_selectedSeasonNumber"
                        ValueChanged="@OnSeasonChanged"
                        Width="30" />

</ResponsiveContainer>

@if (_loading)
{
    <Label Text="@Strings.TiglGames_LoadingGames" CenterText="true" CssClass="mt-2xl mb-3xl" />
}
else
{
    <ResponsiveGridContainer Columns="2"
                              TabletColumns="1"
                              MobileColumns="1"
                              AlignItems="Enums.AlignItems.Stretch"
                              JustifyItems="Enums.AlignItems.Stretch"
                              Gap="var(--space-lg)"
                              CssClass="mb-2xl">
        <div>
            <ResponsiveHeading Level="2" Text="@GetStandardTitle()" FontSize="lg" CenterText="true" CssClass="mb-md" />
            <ResponsiveRadzenDataGrid TItem="MatchReportDto"
                                      Data="FilteredStandardGames"
                                      AllowPaging="false"
                                      AllowAlternatingRows="true">
                <Columns>
                    <RadzenDataGridColumn TItem="MatchReportDto" Property="@nameof(MatchReportDto.GameId)" Title="@Strings.TiglGames_GameId">
                        <Template Context="g">
                            <GridButtonColumn Text="@g.GameId" TextColor="TextColor.Green" Href="@GetGameDetailUrl(g.Id)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MatchReportDto" Property="@nameof(MatchReportDto.State)" Title="@Strings.TiglGames_Status">
                        <Template Context="g">@g.State.GetDisplayName()</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MatchReportDto" Property="@nameof(MatchReportDto.Source)" Title="@Strings.TiglGames_Source">
                        <Template Context="g">@g.Source.GetDisplayName()</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MatchReportDto" Property="@nameof(MatchReportDto.EndTimestamp)" Title="@Strings.TiglGames_Ended">
                        <Template Context="g">@FormatEndDate(g.EndTimestamp)</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </ResponsiveRadzenDataGrid>
        </div>
        <div>
            <ResponsiveHeading Level="2" Text="@GetFracturedTitle()" FontSize="lg" CenterText="true" CssClass="mb-md" />
            <ResponsiveRadzenDataGrid TItem="MatchReportDto"
                                      Data="FilteredFracturedGames"
                                      AllowPaging="false"
                                      AllowAlternatingRows="true">
                <Columns>
                    <RadzenDataGridColumn TItem="MatchReportDto" Property="@nameof(MatchReportDto.GameId)" Title="@Strings.TiglGames_GameId">
                        <Template Context="g">
                            <GridButtonColumn Text="@g.GameId" TextColor="TextColor.Green" Href="@GetGameDetailUrl(g.Id)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MatchReportDto" Property="@nameof(MatchReportDto.State)" Title="@Strings.TiglGames_Status">
                        <Template Context="g">@g.State.GetDisplayName()</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MatchReportDto" Property="@nameof(MatchReportDto.Source)" Title="@Strings.TiglGames_Source">
                        <Template Context="g">@g.Source.GetDisplayName()</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MatchReportDto" Property="@nameof(MatchReportDto.EndTimestamp)" Title="@Strings.TiglGames_Ended">
                        <Template Context="g">@FormatEndDate(g.EndTimestamp)</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </ResponsiveRadzenDataGrid>
        </div>
    </ResponsiveGridContainer>
}

