@using Radzen.Blazor
@using TwilightImperiumUltimate.Contracts.ApiContracts.Tigl.Season
@using TwilightImperiumUltimate.Contracts.DTOs.Tigl
@using TwilightImperiumUltimate.Contracts.Enums
@using TwilightImperiumUltimate.Web.Components.Grid
@using TwilightImperiumUltimate.Web.Components.Shared.Controls
@using TwilightImperiumUltimate.Web.Helpers.Enums

<div class="tigl-leaderboard">
    <div class="leaderboard-filters">
        <ResponsiveDropDown Id="leaderboard-season"
                            TValue="int"
                            Label="@Strings.TiglLeaderboard_Season"
                            Data="@_seasons"
                            TextProperty="@nameof(SeasonDto.SeasonNumber)"
                            ValueProperty="@nameof(SeasonDto.SeasonNumber)"
                            Value="@_selectedSeasonNumber"
                            ValueChanged="@OnSeasonChanged" />

        <ResponsiveDropDown Id="leaderboard-league"
                            TValue="TiglLeagueFilter"
                            Label="@Strings.TiglLeaderboard_League"
                            Data="@LeagueOptions"
                            TextProperty="Value"
                            ValueProperty="Key"
                            Value="@_selectedLeagueFilter"
                            ValueChanged="@OnLeagueChanged" />

        <ResponsiveDropDown Id="leaderboard-ranking-system"
                            TValue="RankingSystem"
                            Label="@Strings.TiglLeaderboard_RankingSystem"
                            Data="@RankingSystemOptions"
                            TextProperty="Value"
                            ValueProperty="Key"
                            Value="@_selectedRankingSystem"
                            ValueChanged="@OnRankingSystemChanged" />
    </div>

    <ResponsiveRadzenDataGrid TItem="PlayerSeasonResultDto"
                              Data="@DisplayedRows"
                              IsLoading="@_loading"
                              AllowPaging="false"
                              AllowSorting="false"
                              AllowAlternatingRows="true"
                              RowClick="RedirectToPlayer"
                              CssClass="tigl-leaderboard-grid">
        <HeaderTemplate>
            <div class="leaderboard-title-row">
                <span class="leaderboard-title">@_selectedRankingSystem.GetDisplayName()</span>
                <div class="leaderboard-options" role="group" aria-label="Leaderboard filters">
                    <RadzenCheckBox Value="@_onlyActive" ValueChanged="OnOnlyActiveChanged" TValue="bool" aria-label="Only active" />
                    <span>Only active</span>
                    <RadzenCheckBox Value="@_onlyConfident" ValueChanged="OnOnlyConfidentChanged" TValue="bool" aria-label="Only confident ratings" />
                    <span>Only confident ratings</span>
                </div>
            </div>
        </HeaderTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="PlayerSeasonResultDto" Property="@nameof(PlayerSeasonResultDto.TiglUserId)" Title="@Strings.TiglLeaderboard_Rank" TextAlign="TextAlign.Center">
                <Template Context="playerResult">
                    <span class="leaderboard-cell leaderboard-cell--rank">@GetPlacement(playerResult)</span>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PlayerSeasonResultDto" Property="@nameof(PlayerSeasonResultDto.TiglUserName)" Title="@Strings.TiglLeaderboard_Player" />

            @if (_selectedRankingSystem == RankingSystem.TrueSkill)
            {
                <RadzenDataGridColumn TItem="PlayerSeasonResultDto" Property="@nameof(PlayerSeasonResultDto.TrueSkillConservativeRating)" Title="@Strings.TiglLeaderboard_TrueSkillConservativeRating" TextAlign="TextAlign.Center">
                    <Template Context="playerResult"><span class="leaderboard-cell leaderboard-cell--primary">@playerResult.TrueSkillConservativeRating.ToString("F2")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PlayerSeasonResultDto" Property="@nameof(PlayerSeasonResultDto.TrueSkillMu)" Title="@Strings.TiglLeaderboard_TrueSkillMu" TextAlign="TextAlign.Center">
                    <Template Context="playerResult">@playerResult.TrueSkillMu.ToString("F2")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PlayerSeasonResultDto" Property="@nameof(PlayerSeasonResultDto.TrueSkillSigma)" Title="@Strings.TiglLeaderboard_TrueSkillSigma" TextAlign="TextAlign.Center">
                    <Template Context="playerResult">@playerResult.TrueSkillSigma.ToString("F6")</Template>
                </RadzenDataGridColumn>
            }
            else if (_selectedRankingSystem == RankingSystem.Glicko2)
            {
                <RadzenDataGridColumn TItem="PlayerSeasonResultDto" Property="@nameof(PlayerSeasonResultDto.GlickoRating)" Title="@Strings.TiglLeaderboard_GlickoRating" TextAlign="TextAlign.Center">
                    <Template Context="playerResult"><span class="leaderboard-cell leaderboard-cell--primary">@playerResult.GlickoRating.ToString("F2")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PlayerSeasonResultDto" Property="@nameof(PlayerSeasonResultDto.GlickoRd)" Title="@Strings.TiglLeaderboard_GlickoRd" TextAlign="TextAlign.Center">
                    <Template Context="playerResult">@playerResult.GlickoRd.ToString("F4")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PlayerSeasonResultDto" Property="@nameof(PlayerSeasonResultDto.GlickoVolatility)" Title="@Strings.TiglLeaderboard_GlickoVolatility" TextAlign="TextAlign.Center">
                    <Template Context="playerResult">@playerResult.GlickoVolatility.ToString("F6")</Template>
                </RadzenDataGridColumn>
            }
            else
            {
                <RadzenDataGridColumn TItem="PlayerSeasonResultDto" Property="@nameof(PlayerSeasonResultDto.AsyncRating)" Title="@Strings.TiglLeaderboard_AsyncRating" TextAlign="TextAlign.Center">
                    <Template Context="playerResult"><span class="leaderboard-cell leaderboard-cell--primary">@playerResult.AsyncRating.ToString("F2")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PlayerSeasonResultDto" Property="@nameof(PlayerSeasonResultDto.AussieScore)" Title="@Strings.TiglLeaderboard_AussieScore" TextAlign="TextAlign.Center">
                    <Template Context="playerResult">@playerResult.AussieScore.ToString("F2")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="PlayerSeasonResultDto" Title="" TextAlign="TextAlign.Center" />
            }

            <RadzenDataGridColumn TItem="PlayerSeasonResultDto" Property="@nameof(PlayerSeasonResultDto.GamesPlayed)" Title="@Strings.TiglLeaderboard_GamesPlayed" TextAlign="TextAlign.Center">
                <Template Context="playerResult"><span class="leaderboard-cell leaderboard-cell--games">@playerResult.GamesPlayed</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PlayerSeasonResultDto" Property="@nameof(PlayerSeasonResultDto.WinPercentage)" Title="@Strings.TiglLeaderboard_WinPercentage" TextAlign="TextAlign.Center">
                <Template Context="playerResult"><span class="leaderboard-cell" style="color: @GetWinrateColor(playerResult.WinPercentage).ConvertToString();">@playerResult.WinPercentage.ToString("F2")</span></Template>
            </RadzenDataGridColumn>
        </Columns>
    </ResponsiveRadzenDataGrid>
</div>
