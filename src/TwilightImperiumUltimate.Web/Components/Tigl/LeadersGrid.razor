@using TwilightImperiumUltimate.Contracts.Enums
@using TwilightImperiumUltimate.Contracts.DTOs.Rankings

@*
    Responsive via ResponsiveRadzenDataGrid (horizontal scroll instead of column truncation on
    narrow viewports) instead of the old fixed-percentage GridLayout. See blazor.instructions.md --
    do not reintroduce Components/Shared/Tables/ResponsiveTable or ResponsiveGrid, they are obsolete
    in this codebase.
*@

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-md mb-md">

    <ResponsiveTabMenu AriaLabel="@Strings.TiglLeague_League" CssClass="faction-style mb-md">
        <ResponsiveTab Id="leaders-tab-standard"
                       ControlsId="leaders-panel"
                       IsActive="@(_league == TiglLeague.ThundersEdge)"
                       OnClick="@(() => ChangeLeague(TiglLeague.ThundersEdge))">
            @Strings.TiglGames_CategoryStandard
        </ResponsiveTab>
        <ResponsiveTabSeparator />
        <ResponsiveTab Id="leaders-tab-fractured"
                       ControlsId="leaders-panel"
                       IsActive="@(_league == TiglLeague.Fractured)"
                       OnClick="@(() => ChangeLeague(TiglLeague.Fractured))">
            @Strings.TiglGames_CategoryFractured
        </ResponsiveTab>
    </ResponsiveTabMenu>

</ResponsiveContainer>

<div id="leaders-panel" role="tabpanel" aria-labelledby="@ActiveTabId">

<ResponsiveRadzenTable ZebraStripes="true" CssClass="leaders-table">
    <RadzenTableHeader>
        <RadzenTableRow>
            <RadzenTableCell class="leaders-header-cell leaders-header-cell--desktop" colspan="3">Leader</RadzenTableCell>
            <RadzenTableCell class="leaders-header-cell leaders-header-cell--mobile" colspan="2">Leader</RadzenTableCell>
            <RadzenTableCell class="leaders-header-cell">User</RadzenTableCell>
            <RadzenTableCell class="leaders-header-cell">Duration</RadzenTableCell>
            <RadzenTableCell class="leaders-header-cell"># Owner</RadzenTableCell>
            <RadzenTableCell class="leaders-header-cell">Shortest</RadzenTableCell>
            <RadzenTableCell class="leaders-header-cell">Longest</RadzenTableCell>
        </RadzenTableRow>
    </RadzenTableHeader>
    <RadzenTableBody>
        @if (_loading)
        {
            <RadzenTableRow>
                <RadzenTableCell colspan="8">
                    <ResponsiveLabel Text="@Strings.Loading" CenterText="true" />
                </RadzenTableCell>
            </RadzenTableRow>
        }
        else if (CurrentLeagueLeaders.Count == 0)
        {
            <RadzenTableRow>
                <RadzenTableCell colspan="8">
                    <ResponsiveLabel Text="No leaders found." CenterText="true" />
                </RadzenTableCell>
            </RadzenTableRow>
        }
        else
        {
            @foreach (var leader in CurrentLeagueLeaders)
            {
                <RadzenTableRow class="leader-player-row"
                                tabindex="@(leader.TiglUserId == 0 ? -1 : 0)"
                                role="@(leader.TiglUserId == 0 ? null : "link")"
                                @onclick="() => NavigateToProfile(leader.TiglUserId)"
                                @onkeydown="e => OnRowKeyDown(e, leader.TiglUserId)">
                    <RadzenTableCell class="leader-faction-cell">
                            <TiglFactionImg Faction="@leader.Faction" Height="32" />
                    </RadzenTableCell>
                    <RadzenTableCell class="leader-hero-cell">
                            <LeaderImg Faction="@leader.Faction" Height="32" />
                    </RadzenTableCell>
                    <RadzenTableCell class="leader-name-cell">
                            <ResponsiveLabel Text="@leader.Name.GetDisplayName()" UseHandelStyling="false" />
                    </RadzenTableCell>
                    <RadzenTableCell>
                        <ResponsiveLabel Text="@leader.UserName" Style="color: var(--color-nav-hover, #8ecfff) !important;" UseHandelStyling="false" />
                    </RadzenTableCell>
                    <RadzenTableCell>
                        <ResponsiveLabel Text="@GetDurationTime(leader)" CenterText="true" TextColor="TextColor.Green" UseHandelStyling="false" />
                    </RadzenTableCell>
                    <RadzenTableCell>
                        <ResponsiveLabel Text="@(leader.ChangeCount > 0 ? leader.ChangeCount.ToString(CultureInfo.InvariantCulture) : string.Empty)" CenterText="true" TextColor="TextColor.Yellow" UseHandelStyling="false" />
                    </RadzenTableCell>
                    <RadzenTableCell>
                        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
                            <ResponsiveLabel Text="@GetShortestDurationTime(leader)" CenterText="true" FontSize="sm" TextColor="TextColor.Red" UseHandelStyling="false" />
                            <ResponsiveLabel Text="@GetShortestHolderName(leader)" CenterText="true" FontSize="xs" Style="color: var(--color-nav-hover, #8ecfff) !important;" UseHandelStyling="false" />
                        </ResponsiveContainer>
                    </RadzenTableCell>
                    <RadzenTableCell>
                        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
                            <ResponsiveLabel Text="@GetLongestDurationTime(leader)" CenterText="true" FontSize="sm" TextColor="TextColor.Green" UseHandelStyling="false" />
                            <ResponsiveLabel Text="@GetLongestHolderName(leader)" CenterText="true" FontSize="xs" Style="color: var(--color-nav-hover, #8ecfff) !important;" UseHandelStyling="false" />
                        </ResponsiveContainer>
                    </RadzenTableCell>
                </RadzenTableRow>
            }
        }
    </RadzenTableBody>
</ResponsiveRadzenTable>

</div>
