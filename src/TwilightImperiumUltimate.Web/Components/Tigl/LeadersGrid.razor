@using TwilightImperiumUltimate.Contracts.DTOs.Rankings
@using TwilightImperiumUltimate.Contracts.Enums

@*
    Responsive via ResponsiveRadzenDataGrid (horizontal scroll instead of column truncation on
    narrow viewports) instead of the old fixed-percentage GridLayout. See blazor.instructions.md --
    do not reintroduce Components/Shared/Tables/ResponsiveTable or ResponsiveGrid, they are obsolete
    in this codebase.
*@

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="mt-md">

    <ResponsiveTabMenu AriaLabel="@Strings.TiglLeague_League" CssClass="mb-md">
        <ResponsiveTab Id="leaders-tab-standard"
                       ControlsId="leaders-panel"
                       IsActive="@(_league == TiglLeague.ThundersEdge)"
                       OnClick="@(() => ChangeLeague(TiglLeague.ThundersEdge))">
            @Strings.TiglGames_CategoryStandard
        </ResponsiveTab>
        <ResponsiveTab Id="leaders-tab-fractured"
                       ControlsId="leaders-panel"
                       IsActive="@(_league == TiglLeague.Fractured)"
                       OnClick="@(() => ChangeLeague(TiglLeague.Fractured))">
            @Strings.TiglGames_CategoryFractured
        </ResponsiveTab>
    </ResponsiveTabMenu>

</ResponsiveContainer>

<div id="leaders-panel" role="tabpanel" aria-labelledby="@ActiveTabId">

@if (_loading)
{
    <Label Text="@Strings.Loading" CenterText="true" CssClass="mt-2xl mb-2xl" />
}
else if (CurrentLeagueLeaders.Count == 0)
{
    <Label Text="No leaders found." CenterText CssClass="mt-md mb-md" />
}
else
{
    <ResponsiveRadzenDataGrid TItem="RankingsLeaderDto"
                              Data="CurrentLeagueLeaders"
                              AllowPaging="false"
                              AllowAlternatingRows="true"
                              CssClass="mb-2xl">
        <Columns>
            <RadzenDataGridColumn TItem="RankingsLeaderDto" Property="@nameof(RankingsLeaderDto.Name)" Title="Leader">
                <Template Context="leader">
                    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" JustifyContent="Enums.JustifyContent.FlexStart">
                        <TiglFactionImg Faction="@leader.Faction" Height="32" />
                        <LeaderImg Faction="@leader.Faction" Height="32" />
                        <Label Text="@leader.Name.GetDisplayName()" TextColor="TextColor.White" />
                    </ResponsiveContainer>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="RankingsLeaderDto" Property="@nameof(RankingsLeaderDto.UserName)" Title="User">
                <Template Context="leader">
                    <GridButtonColumn Text="@leader.UserName" TextColor="TextColor.Green" Href="@GetProfileUrl(leader.TiglUserId)" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="RankingsLeaderDto" Property="@nameof(RankingsLeaderDto.LastUpdate)" Title="Duration" TextAlign="TextAlign.Center">
                <Template Context="leader">@GetDurationTime(leader)</Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="RankingsLeaderDto" Property="@nameof(RankingsLeaderDto.ChangeCount)" Title="# Owner" TextAlign="TextAlign.Center">
                <Template Context="leader">@(leader.ChangeCount > 0 ? leader.ChangeCount.ToString(CultureInfo.InvariantCulture) : string.Empty)</Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="RankingsLeaderDto" Property="@nameof(RankingsLeaderDto.ShortestDuration)" Title="Shortest" TextAlign="TextAlign.Center" Sortable="false">
                <Template Context="leader">
                    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
                        <Label Text="@GetShortestDurationTime(leader)" CenterText="true" FontSize="14" />
                        <Label Text="@GetShortestHolderName(leader)" CenterText="true" FontSize="12" TextColor="TextColor.Yellow" />
                    </ResponsiveContainer>
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="RankingsLeaderDto" Property="@nameof(RankingsLeaderDto.LongestDuration)" Title="Longest" TextAlign="TextAlign.Center" Sortable="false">
                <Template Context="leader">
                    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">
                        <Label Text="@GetLongestDurationTime(leader)" CenterText="true" FontSize="14" />
                        <Label Text="@GetLongestHolderName(leader)" CenterText="true" FontSize="12" TextColor="TextColor.Yellow" />
                    </ResponsiveContainer>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </ResponsiveRadzenDataGrid>
}

</div>
