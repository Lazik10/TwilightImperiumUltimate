@using TwilightImperiumUltimate.Contracts.Enums
@using TwilightImperiumUltimate.Web.Helpers.Enums

<div id="achievements-panel">
    <ResponsiveRadzenTable ZebraStripes="true" CssClass="achievements-table" TableTitle="Last 100">
        <RadzenTableHeader>
            <RadzenTableRow>
                <RadzenTableHeaderCell class="achievements-header-cell" scope="col">Achievement</RadzenTableHeaderCell>
                <RadzenTableHeaderCell class="achievements-header-cell" scope="col">User</RadzenTableHeaderCell>
                <RadzenTableHeaderCell class="achievements-header-cell" scope="col">Faction</RadzenTableHeaderCell>
                <RadzenTableHeaderCell class="achievements-header-cell" scope="col">Match</RadzenTableHeaderCell>
                <RadzenTableHeaderCell class="achievements-header-cell" scope="col">Achieved</RadzenTableHeaderCell>
            </RadzenTableRow>
        </RadzenTableHeader>
        <RadzenTableBody>
            @if (_loading)
            {
                <RadzenTableRow>
                    <RadzenTableCell colspan="5">
                        <ResponsiveLabel Text="Loading achievements..." CenterText="true" UseHandelStyling="false" />
                    </RadzenTableCell>
                </RadzenTableRow>
            }
            else if (_achievements.Count == 0)
            {
                <RadzenTableRow>
                    <RadzenTableCell colspan="5">
                        <ResponsiveLabel Text="No achievements found." CenterText="true" UseHandelStyling="false" />
                    </RadzenTableCell>
                </RadzenTableRow>
            }
            else
            {
                @foreach (var achievement in _achievements)
                {
                    <RadzenTableRow class="achievement-player-row"
                                    tabindex="@(achievement.TiglUserId == 0 ? -1 : 0)"
                                    role="@(achievement.TiglUserId == 0 ? null : "link")"
                                    @onclick="() => NavigateToProfile(achievement.TiglUserId)"
                                    @onkeydown="eventArgs => OnRowKeyDown(eventArgs, achievement.TiglUserId)">
                        <RadzenTableCell>
                            <ResponsiveLabel Text="@achievement.AchievementName.GetDisplayName()" TextColor="@GetRarityTextColor(achievement.RarityPercent)" UseHandelStyling="false" />
                        </RadzenTableCell>
                        <RadzenTableCell>
                            <ResponsiveLabel Text="@achievement.TiglUserName" Style="color: var(--color-nav-hover, #8ecfff) !important;" UseHandelStyling="false" />
                        </RadzenTableCell>
                        <RadzenTableCell class="achievement-faction-cell">
                            @if (achievement.Faction != TiglFactionName.None)
                            {
                                <TiglFactionImg Faction="@achievement.Faction" Height="24" />
                            }
                        </RadzenTableCell>
                        <RadzenTableCell>
                            <a class="achievement-match-link"
                               href="@GetGameDetailUrl(achievement.MatchId)"
                               @onclick:stopPropagation="true">@achievement.MatchName</a>
                        </RadzenTableCell>
                        <RadzenTableCell>
                            <ResponsiveLabel Text="@FormatDate(achievement.AchievedAt)" UseHandelStyling="false" />
                        </RadzenTableCell>
                    </RadzenTableRow>
                }
            }
        </RadzenTableBody>
    </ResponsiveRadzenTable>
</div>