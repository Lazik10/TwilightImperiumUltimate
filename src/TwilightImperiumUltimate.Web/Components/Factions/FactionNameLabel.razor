@using TwilightImperiumUltimate.Web.Components.Shared.Layouts
@using TwilightImperiumUltimate.Web.Helpers.Resources;

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column">

    <ResponsiveVerticalSpacer Size="2xl" ShowOnMobile="false" />

    <div class="faction-title-line">
        <TitleLine TransformX="-22" WidthCss="125%" MaxWidthCss="125%" />
    </div>

    <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CenteredItems="true" Direction="Enums.FlexDirection.Column" CssClass="title handel white shadow">

        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" Style="display:flex; justify-content:space-between; align-items:center;">

            <FactionIconImg FactionName="@(FactionName)" ResponsiveHeight="clamp(1.25rem, 3vw, 3.125rem)" />

            <div class="title">
                @FactionName.GetFactionUIText(FactionResourceType.Title)
            </div>

            <FactionIconImg FactionName="@(FactionName)" ResponsiveHeight="clamp(1.25rem, 3vw, 3.125rem)" />

        </ResponsiveContainer>

    </ResponsiveContainer>

    <div class="faction-title-line">
        <TitleLine TransformX="-22" WidthCss="125%" MaxWidthCss="125%" />
    </div>

</ResponsiveContainer>
