@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using TwilightImperiumUltimate.Web.Components.Rules
@inherits FactionInfoComponentBase

<ResponsiveContainer Type="ContainerType.Fluid" Padding="none">
    <div class="faq-content-shell">
        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" Width="100">
            <div class="faction-faq-navbar">
                <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" Width="50" Style="display:flex; justify-content:space-between; align-items:center; margin-left: auto; margin-right: auto;">
                    <div class="menu-item clickable" @onclick="() => ShowNotes()">
                        @Strings.Faction_Notes
                    </div>
                    <div class="menu-item clickable" @onclick="() => ShowFaq()">
                        @Strings.Faction_Faq
                    </div>
                </ResponsiveContainer>
            </div>
        </ResponsiveContainer>

        @if (_showFaq)
        {
            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" Width="100" Style="display:flex; justify-content:flex-end;">
                <AuthorizeView>
                    <Authorized>
                        <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" Width="35">
                            <ResponsiveButton ButtonText="@Strings.Faction_AddFaq" OnClick="AddFaq" Width="100" />
                        </ResponsiveContainer>
                    </Authorized>
                </AuthorizeView>

            </ResponsiveContainer>

            @foreach (var faq in Faqs)
            {
                <FaqRow Faq="@faq" Culture="@(CultureInfo.CurrentCulture.Name)" />
            }
        }
        else if (_showNotes)
        {
            <ResponsiveContainer Type="ContainerType.Fluid" Padding="none" CssClass="white shadow handel">
                @(FactionNotes)
            </ResponsiveContainer>
        }
    </div>
</ResponsiveContainer>

