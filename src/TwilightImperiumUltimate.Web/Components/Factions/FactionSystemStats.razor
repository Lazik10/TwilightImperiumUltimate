<div class="system-stats">
    @if (!string.IsNullOrEmpty(_title))
    {
        <ResponsiveText TagName="TagName.Div" CssClass="system-stats-title shadow handel">@_title</ResponsiveText>
    }

    <ResponsiveGridContainer Columns="2" TabletColumns="2" MobileColumns="2" Width="100" Gap="var(--space-2xs)" CssClass="system-stats-grid">
        @foreach (var stat in _stats)
        {
            <div class="system-stats-text shadow handel">@stat.Label</div>
            <div class="system-stats-value shadow handel">@stat.Value</div>
        }
    </ResponsiveGridContainer>
</div>
