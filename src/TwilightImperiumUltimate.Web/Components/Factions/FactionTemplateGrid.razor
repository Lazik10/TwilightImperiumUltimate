@using TwilightImperiumUltimate.Web.Components.Factions.Header
@using TwilightImperiumUltimate.Web.Components.Factions.MainSection

<FactionHeader />

<FactionSubmenu SelectedType="_selectedInfoType" OnFactionInfoTypeChange="OnInfoTypeChanged" />

<section id="faction-info-content"
         class="faction-info-content mt-3xl"
         role="tabpanel"
         aria-labelledby="@($"faction-info-tab-{_selectedInfoType.ToString().ToLowerInvariant()}")">
    @switch (_selectedInfoType)
    {
        case FactionInfoType.Ability:
            <FactionAbilities />
            break;
        case FactionInfoType.Setup:
            <FactionSetup />
            break;
        case FactionInfoType.Components:
            <FactionComponents />
            break;
        case FactionInfoType.Leaders:
            <FactionLeaders />
            break;
        case FactionInfoType.History:
            <FactionLore />
            break;
        case FactionInfoType.Rules:
            <FactionRules />
            break;
    }
</section>