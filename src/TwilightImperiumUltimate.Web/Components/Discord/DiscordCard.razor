<article class="discord-card">
    <a class="discord-card-link" href="@DiscordInviteLink" target="_blank" rel="noopener noreferrer">
        <div class="discord-card-image">
            <img src="@GetDiscordIconPath()" alt="@Title" />
        </div>
        <ResponsiveText Text="@Title" FontSize="lg" CenterText="true" CssClass="handel white shadow discord-card-title" />
    </a>
</article>
