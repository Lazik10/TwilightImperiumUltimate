@using TwilightImperiumUltimate.Web.Models.Drafts;
@using TwilightImperiumUltimate.Web.Services.Path;
@using TwilightImperiumUltimate.Web.Components.Shared.Controls
@using TwilightImperiumUltimate.Web.Components.Shared.Text
@inject IPathProvider PathProvider

<div class="faction-draft-player-card">
    <ResponsiveCard CssClass="@(Index == 1 ? "mt-xl" : string.Empty)">
        <div class="faction-draft-player-row">
            <ResponsiveGridContainer Columns="2" TabletColumns="2" MobileColumns="1" Width="100" Gap="var(--space-md)" JustifyItems="Enums.AlignItems.Stretch" CssClass="faction-draft-player-grid">
                <div class="faction-draft-player-details">
                    <ResponsiveLabel Text="@Player.Name" FontSize="2xl" />
                </div>

                <div class="faction-draft-player-factions">
                    <div class="flex-row wrap">
                        @foreach (var faction in Player.DraftedFactions)
                        {
                            <img class="factionicon" src="@PathProvider.GetFactionIconPath(faction)" />
                        }
                    </div>
                </div>
            </ResponsiveGridContainer>
        </div>
    </ResponsiveCard>
</div>


