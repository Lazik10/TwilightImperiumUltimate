@using TwilightImperiumUltimate.Contracts.Enums
@using TwilightImperiumUltimate.Web.Components.Factions
@using TwilightImperiumUltimate.Web.Components.Shared.Controls
@using TwilightImperiumUltimate.Web.Components.Shared.Layouts
@using TwilightImperiumUltimate.Web.Components.Shared.Text
@using TwilightImperiumUltimate.Web.Helpers.Resources;

<ResponsiveTabMenu AriaLabel="Color Picker sections" CssClass="faction-style mb-md">
    <ResponsiveTab Id="color-picker-draft-tab"
                   ControlsId="color-picker-draft-panel"
                   IsActive="@(!_showSettings)"
                   OnClick="ShowDraft">
        Draft
    </ResponsiveTab>
    <ResponsiveTabSeparator />
    <ResponsiveTab Id="color-picker-settings-tab"
                   ControlsId="color-picker-settings-panel"
                   IsActive="@_showSettings"
                   OnClick="ShowSettings">
        Settings
    </ResponsiveTab>
</ResponsiveTabMenu>

<section id="color-picker-draft-panel" role="tabpanel" aria-labelledby="color-picker-draft-tab" hidden="@_showSettings">
    <ResponsiveContainer Type="ContainerType.Flex" Padding="none" CssClass="mt-3xl" JustifyContent="Enums.JustifyContent.Center">
        <ResponsiveButton ButtonText="@GetPrimaryButtonText()"
                          OnClick="HandlePrimaryButtonClick"
                          IsDisabled="GetButtonState()"
                          Width="40" />
    </ResponsiveContainer>

    @if (!HasEnoughSelectedFactions)
    {
        <ResponsiveCard CssClass="mt-3xl">
            <ResponsiveLabel Text="Preview" TextColor="TextColor.Red" CenterText="true" FontSize="xl" CssClass="mb-xs" />
            <ResponsiveLabel Text="Head to Settings to choose your factions." TextColor="TextColor.Red" CenterText="true" FontSize="base" />
        </ResponsiveCard>

        @if (HasPreviewDraftResults)
        {
            @foreach (var result in _previewDraftResults)
            {
                <ResponsiveCard CssClass="color-picker-faction-card mt-sm">
                    <ColorPickerBackground BackgroundColor="result.Color">
                        <ResponsiveHeading Level="3"
                                           Text="@(result.FactionName.GetFactionUIText(FactionResourceType.Title))"
                                           CenterText="true"
                                           CssClass="faction mb-0" />
                    </ColorPickerBackground>
                </ResponsiveCard>
            }
        }
        else
        {
            @foreach (var faction in _previewFactions)
            {
                <ResponsiveCard CssClass="color-picker-faction-card mt-sm">
                    <ColorPickerBackground BackgroundColor="@(PlayerColor.Black)">
                        <ResponsiveHeading Level="3"
                                           Text="@(faction.FactionName.GetFactionUIText(FactionResourceType.Title))"
                                           CenterText="true"
                                           CssClass="faction mb-0" />
                    </ColorPickerBackground>
                </ResponsiveCard>
            }
        }
    }
    else
    {
        <ResponsiveCard CssClass="mt-3xl">
            <ResponsiveHeading Level="3" Text="Draft" CenterText="true" />
        </ResponsiveCard>

        @if (HasDraftResults)
        {
            @foreach (var result in ColorPickerService.FactionColorDraftResults!)
            {
                <ResponsiveCard CssClass="color-picker-faction-card mt-sm">
                    <ColorPickerBackground BackgroundColor="result.Color">
                        <ResponsiveHeading Level="3"
                                           Text="@(result.FactionName.GetFactionUIText(FactionResourceType.Title))"
                                           CenterText="true"
                                           CssClass="mb-0" />
                    </ColorPickerBackground>
                </ResponsiveCard>
            }
        }
        else
        {
            @foreach (var faction in ColorPickerService.SelectedFactions)
            {
                <ResponsiveCard CssClass="color-picker-faction-card mt-sm">
                    <ColorPickerBackground BackgroundColor="@(PlayerColor.Black)">
                        <ResponsiveHeading Level="3"
                                           Text="@(faction.FactionName.GetFactionUIText(FactionResourceType.Title))"
                                           CenterText="true"
                                           CssClass="faction mb-0" />
                    </ColorPickerBackground>
                </ResponsiveCard>
            }
        }
    }
</section>

<section id="color-picker-settings-panel" role="tabpanel" aria-labelledby="color-picker-settings-tab" hidden="@(!_showSettings)">
    <FactionMenuPicker OnFactionChanged="UpdateSelectedFactions"
                       OnFactionsInitialized="InitializePreviewFactions"
                       @ref="_factionMenuPicker" />

    <ResponsiveCard CssClass="mt-lg mb-xl">
        <ResponsiveHeading Level="4" Text="Available Colors" CenterText="true" CssClass="mb-0" />
        <ResponsiveText Text="(click to exclude)" FontSize="sm" CenterText="true" />

        <ResponsiveGridContainer Columns="4" TabletColumns="4" MobileColumns="2">
            @foreach (var color in ColorPickerService.Colors)
            {
                <ColorCheckBox Color="@(color.Key)"
                               IsChecked="@(color.Value)"
                               OnClick="HandleColorClick" />
            }
        </ResponsiveGridContainer>
    </ResponsiveCard>
</section>

