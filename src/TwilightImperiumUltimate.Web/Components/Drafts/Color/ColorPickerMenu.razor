@inherits TwilightImperiumBaseComponent

<div class="color-picker-menu">
    <ResponsiveCard CssClass="color-picker-menu-versions-card mb-2xl">
        <ResponsiveHeading Level="4" Text="Factions" CenterText="true" CssClass="mb-sm" />

        @foreach (var gameVersion in GetGameVersionGroups())
        {
            <div class="color-picker-menu-group">
                <p class="color-picker-menu-group-label handel shadow">@GetGameVersionLabel(gameVersion)</p>

                <div class="color-picker-menu-icon-row">
                    @foreach (var faction in GetFactionsForGameVersion(gameVersion))
                    {
                        <div class="color-picker-menu-icon">
                            <FactionIcon Faction="faction" NoPadding="true" OnClick="() => FactionIconClicked(faction)" />
                            <label class="color-picker-menu-faction-checkbox-label handel shadow">
                                <input type="checkbox" checked="@(!faction.Banned)" @onchange="e => FactionCheckboxChanged(faction, e)" />
                            </label>
                        </div>
                    }
                </div>
            </div>
        }
    </ResponsiveCard>
</div>
