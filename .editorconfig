############################################################################################
#                                   Code Quality                                           #
############################################################################################
dotnet_code_quality.CA1716.analyzed_symbol_kinds = NamedType, Method, Property, Event

############################################################################################
#           EF Core migrations (DataAccess) — scaffolded/tool-generated, don't lint        #
############################################################################################
# Files under Migrations/ (including the ModelSnapshot) are generated by `dotnet ef migrations
# add`/`remove` and are re-scaffolded on every schema change. Only the *.Designer.cs and the
# ModelSnapshot carry the "<auto-generated />" header that analyzers normally honor; the main
# migration *.cs files (Up/Down) do not, so they still get flagged. Treat the whole folder as
# generated and silence all analyzer diagnostics (StyleCop/CA/Sonar/IDE) for it so it never
# shows up as something to "fix".
[src/TwilightImperiumUltimate.DataAccess/Migrations/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
