root = true

###############################################################################################################
#                                        Global settings for all files                                        #
###############################################################################################################
[*]
indent_style = space
end_of_line = crlf
insert_final_newline = true
charset = utf-8

#--------------------------------------------  Indentation  --------------------------------------------------#

[*.{cs,csx,vb,vbx}]
indent_size = 4
tab_width = 4

# Xml project files
[*.{csproj,vbproj,vcxproj,vcxproj.filters,proj,projitems,shproj}]
indent_size = 4

# Xml config files
[*.{props,targets,ruleset,config,nuspec,resx,vsixmanifest,vsct}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# TT files
[*.tt]
indent_size = 4

###############################################################################################################
#                                        Rules for C# and VB code files                                       #
###############################################################################################################
[*.{cs,vb}]

#--------------------------------------------  Code styles  --------------------------------------------------#

# Sort using directives placing all System.* namespaces before other usings for consistency.
dotnet_sort_system_directives_first = true
# Prefer accessing instance fields without this. unless needed to disambiguate.
dotnet_style_qualification_for_field = false:suggestion
# Prefer accessing properties without this. qualifier unless required.
dotnet_style_qualification_for_property = false:suggestion
# Prefer calling instance methods without this. unless there is a naming conflict.
dotnet_style_qualification_for_method = false:suggestion
# Prefer accessing events without this. unless needed for clarity or disambiguation.
dotnet_style_qualification_for_event = false:suggestion
# Use C# keywords (int, string, bool) for local variables, parameters, and members instead of framework type names (Int32, String, Boolean).
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
# Use predefined type keywords when referring to static members (e.g., int.MaxValue instead of Int32.MaxValue).
dotnet_style_predefined_type_for_member_access = true:warning
# Explicitly specify access modifiers (public/private/etc.) on non-interface members to avoid ambiguity.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
# Prefer object initializers (new Foo { A = 1 }) instead of setting properties in separate statements.
dotnet_style_object_initializer = true:suggestion
# Prefer collection initializers (new List<int> { 1, 2 }) instead of Add calls immediately after construction.
dotnet_style_collection_initializer = true:suggestion
# Use explicit tuple element names (e.g., (int count, string name)) instead of relying on Item1, Item2.
dotnet_style_explicit_tuple_names = true:suggestion
# When tuple element names can be inferred from variable names, omit explicit naming (var count = 1; var t = (count, name)).
dotnet_style_prefer_inferred_tuple_names = true:suggestion
# In anonymous types, omit redundant member names when they match variable names (new { count, name }).
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion
# Use ?? and ??= where possible instead of verbose null checks.
dotnet_style_coalesce_expression = true:suggestion
# Use ?. and ?[] null-conditional operators instead of explicit if (x != null) patterns.
dotnet_style_null_propagation = true:suggestion
# Use ‘is null’ / ‘is not null’ pattern rather than object.ReferenceEquals(x, null).
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
# Use auto-properties instead of properties with trivial backing fields.
dotnet_style_prefer_auto_properties = true:suggestion
# Simplify boolean logic (avoid redundant == true / unnecessary parentheses).
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
# Use ternary operator for simple conditional assignments instead of if/else blocks.
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
# Use ternary operator for simple conditional returns instead of if/else.
dotnet_style_prefer_conditional_expression_over_return = true:suggestion
# Use compound operators (+=, -=, *=, etc.) instead of expanded forms (x = x + y).
dotnet_style_prefer_compound_assignment = true:suggestion
# Simplify interpolated strings (e.g., $"{x}" instead of string.Format, remove redundant ToString()).
dotnet_style_prefer_simplified_interpolation = true:suggestion
# Encourage namespace declarations that mirror the physical folder structure.
dotnet_style_namespace_match_folder = true:suggestion
# Place binary operators at the beginning of wrapped lines for readability in multiline expressions.
dotnet_style_operator_placement_when_wrapping = beginning_of_line
# Prefer file-scoped namespaces for modern C#
csharp_style_namespace_declarations = file_scoped:warning

###############################################################################################################
#                                              C# specific rules                                              #
###############################################################################################################
[*.cs]

#------------------------------------------------  Global C# --------------------------------------------------#

# Prefer the C# 8 simplified 'using' statement form (using var x = ...) over a using block.
csharp_prefer_simple_using_statement = true:suggestion
# Prefer always using braces around control blocks (if/for/etc.) even for single statements.
csharp_prefer_braces = true:suggestion
# Suggest ordering modifiers in the specified canonical sequence for consistency.
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:suggestion
# Prefer explicit built-in types (int, string) instead of 'var' when declaring locals.
csharp_style_var_for_built_in_types = false:silent
# Use 'var' when the right-hand side makes the type obvious (e.g., new Customer()).
csharp_style_var_when_type_is_apparent = true:suggestion
# Prefer explicit types for other local declarations when the type is not immediately apparent.
csharp_style_var_elsewhere = false:silent
# Prefer expression-bodied form for lambdas when possible (x => x + 1).
csharp_style_expression_bodied_lambdas = true:suggestion
# Do not prefer expression-bodied syntax for local functions; keep block form.
csharp_style_expression_bodied_local_functions = false:suggestion
# Use direct null checks (x is null) rather than type checks followed by casts just to test null.
csharp_style_prefer_null_check_over_type_check = true:suggestion
# Place using directives at top of file, outside the namespace declaration.
csharp_using_directive_placement = outside_namespace:suggestion

#-------------------------------------  Expression-bodied members preference ----------------------------------#

# Suggest using expression-bodied syntax (e.g., int Add(int a, int b) => a + b;) only when the entire method fits on one line.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
# Suggest using expression-bodied constructors only when the entire body fits on one line.
csharp_style_expression_bodied_constructors = when_on_single_line:suggestion
# Suggest using expression-bodied operator overloads only when the entire body fits on one line.
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
# Suggest using expression-bodied form (e.g., string Name => _name;) when the getter (and optional setter) is a single simple expression.
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
# Suggest expression-bodied indexers (e.g., string this[int i] => _items[i];) when the implementation is a single expression.
csharp_style_expression_bodied_indexers = when_on_single_line:suggestion
# Suggest expression-bodied accessors (get/set/add/remove) only when each accessor’s body is a single expression.
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion

#-------------------------------------------  Newline and spacing rules ----------------------------------------#

# Place an opening brace on a new line for all constructs (types, methods, properties, control blocks, etc.).
csharp_new_line_before_open_brace = all
# Put else on a new line after the closing brace of the preceding if block.
csharp_new_line_before_else = true
# Put catch on a new line after the closing brace of the try block.
csharp_new_line_before_catch = true
# Put finally on a new line after the closing brace of the catch (or try if no catch).
csharp_new_line_before_finally = true
# Each member assignment inside an object initializer starts on its own line.
csharp_new_line_before_members_in_object_initializers = true
# Each member inside an anonymous type initializer starts on its own line.
csharp_new_line_before_members_in_anonymous_types = true
# Place each clause of a query expression on its own line for readability.
csharp_new_line_between_query_expression_clauses = true

# Indent the statements inside each case block in a switch.
csharp_indent_case_contents = true
# Indent switch labels (case/default) relative to the switch block.
csharp_indent_switch_labels = true
# Labels are outdented by one level relative to surrounding code (custom override for readability).
csharp_indent_labels = one_less_than_current
# Indent the contents of blocks by one level.
csharp_indent_block_contents = true
# Do not indent braces that open and close a block.
csharp_indent_braces = false

# Keep single-line statements on one line; avoid forced wrapping.
csharp_preserve_single_line_statements = true
# Keep simple blocks (e.g., { return x; }) on a single line if already written that way.
csharp_preserve_single_line_blocks = true

# Do not insert a space after a cast (e.g., (int)x not (int) x).
csharp_space_after_cast = false
# Add a space after control flow keywords (if (, for (, while (, etc.).
csharp_space_after_keywords_in_control_flow_statements = true
# No space immediately inside parentheses in method declarations (void M(int x) not void M( int x )).
csharp_space_between_method_declaration_parameter_list_parentheses = false
# No space immediately inside parentheses in method calls (Do(x, y) not Do( x, y )).
csharp_space_between_method_call_parameter_list_parentheses = false
# Adds a space after the colon in base type declarations (e.g., class MyClass : BaseClass).
csharp_space_after_colon_in_inheritance_clause = true
# Adds a space after commas in argument lists, parameter lists, etc. (e.g., Do(x, y)).
csharp_space_after_comma = true
# No space after the dot operator (e.g., obj.Method(), not obj. Method()).
csharp_space_after_dot = false
# Adds a space after semicolons in for loops (e.g., for (int i = 0; i < n; i++)).
csharp_space_after_semicolon_in_for_statement = true
# Adds spaces before and after binary operators (e.g., x + y, not x+y).
csharp_space_around_binary_operators = before_and_after
# Do not ignore extra spaces in declaration statements; flag them for correction.
csharp_space_around_declaration_statements = do_not_ignore
# Adds a space before the colon in base type declarations (e.g., class MyClass : BaseClass).
csharp_space_before_colon_in_inheritance_clause = true
# No space before commas in lists (e.g., Do(x, y), not Do(x , y)).
csharp_space_before_comma = false
# No space before the dot operator (e.g., obj.Method(), not obj .Method()).
csharp_space_before_dot = false
# No space before opening square brackets (e.g., array[index], not array [index]).
csharp_space_before_open_square_brackets = false
# No space before semicolons in for loops.
csharp_space_before_semicolon_in_for_statement = false
# No space between empty square brackets (e.g., new int[] {}, not new int[ ] {}).
csharp_space_between_empty_square_brackets = false
# No space between parentheses in empty method calls (e.g., Do(), not Do( )).
csharp_space_between_method_call_empty_parameter_list_parentheses = false
# No space between parentheses in empty method declarations (e.g., void M(), not void M( )).
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
# No space between method name and opening parenthesis (e.g., Do(), not Do ()).
csharp_space_between_method_declaration_name_and_open_parenthesis = false
# No space immediately inside parentheses (e.g., Do(x), not Do( x )).
csharp_space_between_parentheses = false
# No space immediately inside square brackets (e.g., array[index], not array[ index ])
csharp_space_between_square_brackets = false

#----------------------------------------------------  Styles ---------------------------------------------------#

# Suggest replacing trivial anonymous delegates (delegate(...) { ... }) with local functions for clarity/reuse when appropriate.
csharp_style_prefer_local_over_anonymous_function = true:suggestion
# Prefer the ^ index-from-end operator (e.g., array[^1]) over length-based indexing (e.g., array[array.Length - 1]).
csharp_style_prefer_index_operator = true:suggestion
# Suggest using the range operator (collection[start..end]) instead of manual Skip/Take patterns.
csharp_style_prefer_range_operator = true:suggestion
# Use target-typed new (e.g., MyType x = new();) when the type can be inferred from the left side.
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
# Prefer tuple swap syntax ((a, b) = (b, a)) instead of using a temporary variable.
csharp_style_prefer_tuple_swap = true:suggestion
# Assign unused values to a discard (_) rather than dummy variables (e.g., _ = DoWork();).
csharp_style_unused_value_assignment_preference = discard_variable:suggestion
# Prefer passing method groups (Foo) instead of lambdas (x => Foo(x)) when signatures match.
csharp_style_prefer_method_group_conversion = true:suggestion
# Prefer top-level statements for simple programs instead of explicit Program/Main boilerplate.
csharp_style_prefer_top_level_statements = true:suggestion
# Suggest using primary constructor syntax in eligible types (e.g., class C(string name) { ... }) for concise parameter/property capture.
csharp_style_prefer_primary_constructors = true:suggestion
# Allow single embedded statements (e.g., if (x) Do();) on one line without braces in experimental style scenarios.
csharp_style_allow_embedded_statements_on_same_line_experimental = true:suggestion
# Prefer using System.Threading.Lock type over locking on arbitrary objects for type-safe synchronization.
csharp_prefer_system_threading_lock = true:suggestion
# Prevents multiple consecutive blank lines in code. When set to false, the formatter will collapse extra blank lines to a single blank line for cleaner layout.
dotnet_style_allow_multiple_blank_lines_experimental = false
# Suggests using collection expressions (e.g., [1, 2, 3]) instead of constructors like new List<int> { 1, 2, 3 } for brevity and modern syntax.
dotnet_style_prefer_collection_expression = true:suggestion
# Suggests using UTF-8 string literals (e.g., "text"u8) for performance and memory efficiency when working with UTF-8 encoded data.
csharp_style_prefer_utf8_string_literals = true:suggestion

#----------------------------------------------------  Naming ---------------------------------------------------#

# Interfaces should begin with 'I' and use PascalCase (e.g., IMyInterface).
dotnet_naming_rule.interface_should_be_begins_with_i.severity = suggestion
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface

# Non-field members (methods, properties, events) should use PascalCase.
dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.non_field_members_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.non_field_members_should_be_pascal_case.symbols = non_field_members

# Types (classes, structs, enums) should use PascalCase.
dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.types_should_be_pascal_case.symbols = types

# Private or internal fields should use camelCase with underscore prefix (e.g., _myField).
dotnet_naming_rule.camel_case_for_private_internal_fields.severity = suggestion
dotnet_naming_rule.camel_case_for_private_internal_fields.style = camel_case_underscore_style
dotnet_naming_rule.camel_case_for_private_internal_fields.symbols = private_internal_fields

# Constant fields should use PascalCase (e.g., MyConstant).
dotnet_naming_rule.constant_fields_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.constant_fields_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.constant_fields_should_be_pascal_case.symbols = constant_fields

# Applies to all interface types regardless of accessibility.
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.required_modifiers = 

# Applies to non-field members (properties, events, methods) across all accessibilities.
dotnet_naming_symbols.non_field_members.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.non_field_members.applicable_kinds = property, event, method
dotnet_naming_symbols.non_field_members.required_modifiers = 

# Applies to all types (classes, structs, enums) across all accessibilities.
dotnet_naming_symbols.types.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum
dotnet_naming_symbols.types.required_modifiers = 

# Applies to constant fields only (requires `const` modifier).
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const

# Applies to private or internal fields.
dotnet_naming_symbols.private_internal_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_internal_fields.applicable_kinds = field

# Interfaces should begin with 'I' and use PascalCase (e.g., IMyInterface).
dotnet_naming_style.begins_with_i.capitalization = pascal_case
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.required_suffix = 
dotnet_naming_style.begins_with_i.word_separator = 

# PascalCase style for types and members (e.g., MyClass, MyProperty).
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.pascal_case.required_prefix = 
dotnet_naming_style.pascal_case.required_suffix = 
dotnet_naming_style.pascal_case.word_separator = 

# CamelCase style with underscore prefix for private/internal fields (e.g., _myField).
dotnet_naming_style.camel_case_underscore_style.capitalization = camel_case
dotnet_naming_style.camel_case_underscore_style.required_prefix = _

# PascalCase style for constants (e.g., MyConstant).
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

#----------------------------------------------  Modern C# features ---------------------------------------------#

# Suggest replacing old style `if (x is T) { var t = (T)x; ... }` with pattern matching `if (x is T t) { ... }`.
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
# Suggest using pattern matching `if (x is T t)` instead of `var t = x as T; if (t != null) ...`.
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
# Prefer inline `if (int.TryParse(s, out var value))` declarations instead of pre-declaring the variable.
csharp_style_inlined_variable_declaration = true:suggestion
# Suggest using `default` instead of verbose forms like `default(int)` or `default(string)` where the type is apparent.
csharp_prefer_simple_default_expression = true:suggestion
# Encourage tuple deconstruction syntax `(a, b) = GetPair();` instead of separate assignments.
csharp_style_deconstructed_variable_declaration = true:suggestion
# Suggest inline throw expressions (e.g., value ?? throw new ArgumentNullException()) instead of multi-line if/throw blocks.
csharp_style_throw_expression = true:suggestion
# Encourage using conditional delegate invocation `handler?.Invoke(args)` instead of explicit null checks.
csharp_style_conditional_delegate_call = true:suggestion

#########################################################################################
#                                    Diagnostics                                        #
#########################################################################################

#------------------------ (StyleCop and Roslyn conflicts) ------------------------------#

# SA1000: Ensures language keywords (e.g., new, typeof, default) and certain contextual
# keywords are followed and preceded by correct spacing (no runs of spaces or missing required space).
dotnet_diagnostic.SA1000.severity = none
# SA1001: Commas should be spaced correctly (no space before comma, space after comma).
dotnet_diagnostic.SA1001.severity = none
# SA1002: Semicolons should be spaced correctly (no space before semicolon).
dotnet_diagnostic.SA1002.severity = none
# SA1003: Operator and symbol spacing should be correct (e.g., spaces around binary operators).
dotnet_diagnostic.SA1003.severity = none
# SA1005: Single-line comments should begin with a single space (e.g., // comment, not //comment).
dotnet_diagnostic.SA1005.severity = none
# SA1010: Opening square brackets should be spaced correctly (no space before '[').
dotnet_diagnostic.SA1010.severity = none
# SA1028: Code must not contain trailing whitespace
dotnet_diagnostic.SA1028.severity = none

#------  Disable documentation for interfaces, exposed, internal, private elements ------#

# Elements must be documented
dotnet_diagnostic.SA1600.severity = none
# Partial elements must be documented
dotnet_diagnostic.SA1601.severity = none
# Enumeration items must be documented
dotnet_diagnostic.SA1602.severity = none
# Element documentation should have summary
dotnet_diagnostic.SA1604.severity = none
# Element documentation should have summary text
dotnet_diagnostic.SA1606.severity = none
# Element documentation should not have default summary
dotnet_diagnostic.SA1608.severity = none
# Element parameters must be documented
dotnet_diagnostic.SA1611.severity = none
# Element return value must be documented
dotnet_diagnostic.SA1615.severity = none
# Generic type parameters must be documented
dotnet_diagnostic.SA1618.severity = none
# Property summary documentation should match accessors (Gets or sets, Gets, Sets).
dotnet_diagnostic.SA1623.severity = silent
# Documentation text should end with a period.
dotnet_diagnostic.SA1629.severity = silent
# SA1601: Set documentation culture to en-US.
dotnet_diagnostic.SA1601.documentation_culture = en-US

#----------------------------------   S - diagnostics   ----------------------------------#

# S101: Type names should comply with a naming convention (e.g., PascalCase, no underscores).
dotnet_diagnostic.S101.severity = suggestion
# S107: Methods should not have too many parameters; consider grouping them into an object.
dotnet_diagnostic.S107.severity = suggestion
# S4457: Parameter validation in async methods should be wrapped in a separate synchronous method.
dotnet_diagnostic.S4457.severity = suggestion
# S6966: Prefer using the async version of a method when one is available.
dotnet_diagnostic.S6966.severity = suggestion

#----------------------------------   SA - diagnostics   ---------------------------------#

# SA1101: Prefix local calls with this
dotnet_diagnostic.SA1101.severity = none
# SA1208: System using directives should be placed before other using directives
dotnet_diagnostic.SA1208.severity = suggestion
# SA1300: Element names (types, methods, etc.) must begin with an upper-case letter.
dotnet_diagnostic.SA1300.severity = warning
# SA1309: Field names should not begin with underscore (disabled; team uses underscore prefix for private fields).
dotnet_diagnostic.SA1309.severity = none
# SA1503: Braces should not be omitted
dotnet_diagnostic.SA1503.severity = suggestion
# SA1633: File must have a standard header (company copyright, etc.).
dotnet_diagnostic.SA1633.severity = suggestion

#----------------------------------   CA - diagnostics   ---------------------------------#

# CA1002: Avoid exposing generic lists in public APIs; use collection interfaces instead (e.g., IList<T>).
dotnet_diagnostic.CA1002.severity = suggestion
# CA1003: Use generic EventHandler<T> instead of custom delegate types for events.
dotnet_diagnostic.CA1003.severity = suggestion
# CA1008: Enums should define a zero-valued member named 'None' for clarity and default behavior.
dotnet_diagnostic.CA1008.severity = suggestion
# CA1014: Mark assemblies with [CLSCompliant(true)] to ensure cross-language compatibility.
dotnet_diagnostic.CA1014.severity = suggestion
# CA1019: Provide accessors for all attributes' arguments to ensure usability.
dotnet_diagnostic.CA1019.severity = suggestion
# CA1031: Do not catch general exception types (e.g., Exception); catch specific exceptions for clarity.
dotnet_diagnostic.CA1031.severity = suggestion
# CA1036: Override comparison operators and methods (Equals, CompareTo) for types implementing IComparable.
dotnet_diagnostic.CA1036.severity = suggestion
# CA1056: URI properties should use System.Uri type instead of string for correctness and safety.
dotnet_diagnostic.CA1056.severity = suggestion
# CA1508: Avoid redundant conditions (e.g., unnecessary null checks or boolean comparisons).
dotnet_diagnostic.CA1508.severity = suggestion
# CA1515: Consider making public types in executable projects internal to reduce API surface.
dotnet_diagnostic.CA1515.severity = suggestion
# CA1305: Specify IFormatProvider when formatting strings or numbers to ensure culture correctness.
dotnet_diagnostic.CA1305.severity = suggestion
# CA1711: Identifiers should not have incorrect suffix (e.g., avoid naming enums with 'Enum' suffix).
dotnet_diagnostic.CA1711.severity = suggestion
# CA1725: Parameter names should match names in overridden or implemented methods.
dotnet_diagnostic.CA1725.severity = suggestion
# CA1805: Do not initialize variables to their default values unnecessarily (e.g., int x = 0;).
dotnet_diagnostic.CA1805.severity = suggestion
# CA1812: Avoid uninstantiated internal classes (remove unused internal classes).
dotnet_diagnostic.CA1812.severity = suggestion
# CA1819: Properties should not return arrays (use collections or read-only wrappers instead).
dotnet_diagnostic.CA1819.severity = suggestion
# CA1822: Mark members as static when they do not access instance data.
dotnet_diagnostic.CA1822.severity = suggestion
# CA1834: Use StringBuilder.Append(char) instead of Append(string) for single characters.
dotnet_diagnostic.CA1834.severity = warning
# CA1839: Use Environment.ProcessPath instead of Process.GetCurrentProcess().MainModule.FileName.
dotnet_diagnostic.CA1839.severity = warning
# CA1840: Use Environment.CurrentManagedThreadId instead of Thread.CurrentThread.ManagedThreadId.
dotnet_diagnostic.CA1840.severity = warning
# CA1841: Prefer Dictionary.ContainsKey over Dictionary.Keys.Contains for better performance.
dotnet_diagnostic.CA1841.severity = suggestion
# CA1842: Do not use 'WhenAll' with a single task; await the task directly.
dotnet_diagnostic.CA1842.severity = warning
# CA1843: Do not use 'WhenAny' with a single task; await the task directly.
dotnet_diagnostic.CA1843.severity = warning
# CA1844: Provide Memory-based overrides of async Stream methods in subclasses.
dotnet_diagnostic.CA1844.severity = suggestion
# CA1845: Use span-based 'string.Concat' instead of 'Substring' with concatenation.
dotnet_diagnostic.CA1845.severity = suggestion
# CA1846: Prefer 'AsSpan' over 'Substring' when passed to span-based overloads.
dotnet_diagnostic.CA1846.severity = suggestion
# CA1847: Use char literal instead of single-character string literal for string search methods.
dotnet_diagnostic.CA1847.severity = suggestion
# CA1848: Use LoggerMessage delegates for structured logging instead of string interpolation.
dotnet_diagnostic.CA1848.severity = suggestion
# CA1849: Call async methods when in an async method instead of sync equivalents.
dotnet_diagnostic.CA1849.severity = suggestion
# CA1851: Possible multiple enumerations of IEnumerable collection; consider materializing.
dotnet_diagnostic.CA1851.severity = suggestion
# CA1852: Seal internal types that are not subclassed for performance.
dotnet_diagnostic.CA1852.severity = suggestion
