{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/TwilightImperiumUltimate.API/TwilightImperiumUltimate.API.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-web",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/TwilightImperiumUltimate.Web/TwilightImperiumUltimate.Web.csproj"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "free-web-port",
      "detail": "Kill any orphaned process still holding the Web dev-server port (7299/5166) before launching.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/free-ports.ps1",
        "-Ports",
        "7299,5166"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "wait-for-api",
      "detail": "Block until the API project is actually accepting requests, so the Web browser tab doesn't open before the API is ready.",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/wait-for-api.ps1"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "prepare-web",
      "detail": "Runs free-web-port then wait-for-api in sequence before the Web (Blazor) debug session starts.",
      "dependsOrder": "sequence",
      "dependsOn": [
        "free-web-port",
        "wait-for-api"
      ],
      "problemMatcher": []
    }
  ]
}