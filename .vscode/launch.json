{
    "version": "0.2.0",

    "compounds": [
        {
            "name": "API + Web",
            "configurations": [
                "API (Swagger)",
                "Web (Blazor)"
            ],
            "stopAll": true
        }
    ],

    "configurations": [
        {
            "name": "API (Swagger)",
            "type": "coreclr",
            "request": "launch",

            "preLaunchTask": "build-api",

            "program": "${workspaceFolder}/src/TwilightImperiumUltimate.API/bin/Debug/net10.0/TwilightImperiumUltimate.API.dll",

            "args": [],
            "cwd": "${workspaceFolder}/src/TwilightImperiumUltimate.API",

            "console": "internalConsole",
            "stopAtEntry": false,

            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7292;http://localhost:5178"
            },

            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "https://localhost:7292/swagger/index.html"
            }
        },

        {
            "name": "Web (Blazor)",
            "type": "coreclr",
            "request": "launch",

            "preLaunchTask": "prepare-web",

            "program": "C:\\Program Files\\dotnet\\dotnet.exe",

            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/src/TwilightImperiumUltimate.Web/TwilightImperiumUltimate.Web.csproj",
                "--launch-profile",
                "https"
            ],

            "cwd": "${workspaceFolder}/src/TwilightImperiumUltimate.Web",

            "console": "integratedTerminal",
            "stopAtEntry": false,

            "env": {
                "DOTNET_WATCH_SUPPRESS_LAUNCH_BROWSER": "true",
                "DOTNET_CLI_USE_MSBUILD_SERVER": "1"
            },

            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            }
        }
    ]
}